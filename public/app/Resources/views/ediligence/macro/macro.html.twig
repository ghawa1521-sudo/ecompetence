{% macro directiongenerale(roleBase, dg_imput) %}
    <div class="form-group bien">
        <font size="+1"><b>A</b></font>
        <br>
        {% set y=0 %}
        {% for line in dg_imput %}
            {% set y=y+1 %}
            <input id="A{{y}}" name="Dest" value="{{line.codeDc}}" onclick="return checkboxhide('A{{y}}', 'A{{y}}h');" type="checkbox">
            <input id="A{{y}}h" name="DestHide[]" value="{{line.codeDc}}" style="display:none;" type="checkbox">
            <label for="A{{y}}">{{line.sigle}}</label>
        {% endfor %}
    </div>
{% endmacro %}
