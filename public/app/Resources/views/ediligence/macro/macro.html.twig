{% macro div_apercu() %}
    <script type="text/javascript">
        function pop_apercu(txt) {
            var chkbox = document.getElementById("lg1234");
            var chks = "<iframe style='height: 100% !important; width: 100% !important' class='iframepop' src='" + txt + "'></iframe>";
            chkbox.innerHTML = chks;
            $("a#alg123").fancybox({"hideOnContentClick": false}).trigger("click");
        }
