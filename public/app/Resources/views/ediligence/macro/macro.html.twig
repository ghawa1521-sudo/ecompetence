{%macro cadretechnique(roleBase, conseiller_imput, charge_etudes, assistant) %}
    <div class="form-group bien">
        <font size="+1"><b>CADRES TECHNIQUES</b></font>
        <br>
        <div class="row" style="vertical-align: middle;"><span class="col-md-4" style=" line-height: 270%;"><b>CONSEILLERS</b></span>
            <span class="col-md-8">
                {% set u=0 %}
                <select class="selectpicker form-control" id="conseiller" multiple onchange=" selectboxhide(this.value, 'conseiller');" data-live-search="true" title="Choisir un conseillers">
                    {% for line in conseiller_imput %}
                        {% set u=u+1 %}
                        <option  value={{u}}> {{line.nom}} {{line.prenoms}} {{line.nomJeuneFille}}</option>

                    {% endfor %}
                </select>
                {% set q=0 %}
                {% for line in conseiller_imput %}
                    {% set q=q+1 %}
                    <input id="Z{{q}}" name="Dest" value="{{line.matricule}}" style="display:none;" type="checkbox">
                    <input id="Z{{q}}h" name="DestHide[]" value="{{line.matricule}}" style="display:none;" type="checkbox">

                {% endfor %}
            </span>
        </div>
        <div class="row" style="vertical-align: middle;"><span class="col-md-4" style=" line-height: 270%;"><b>ASSISTANTS</b></span>
            <span class="col-md-8" >
                {% set u1=0 %}
                <select class="selectpicker form-control" id="assistant" multiple onchange=" selectboxhide(this.value, 'assistant');" data-live-search="true" title="Choisir un assistant">
                    {% for line in assistant %}
                        {% set u=u+1 %}
                        <option  value={{u}}> {{line.nom}} {{line.prenoms}} {{line.nomJeuneFille}}</option>

                    {% endfor %}
                </select>
                {% set q1=0 %}
                {% for line in assistant %}
                    {% set q=q+1 %}
                    <input id="Z{{q}}" name="Dest" value="{{line.matricule}}" style="display:none;" type="checkbox">
                    <input id="Z{{q}}h" name="DestHide[]" value="{{line.matricule}}" style="display:none;" type="checkbox">

                {% endfor %}
            </span>
        </div>
        <div class="row" style="vertical-align: middle;"><span class="col-md-4" style=" line-height: 270%;"><b>CHARGES D'ETUDES</b></span>
            <span class="col-md-8">
                {% set u2=0 %}
                <select class="selectpicker form-control" id="chargeetudes" multiple onchange=" selectboxhide(this.value, 'chargeetudes');" data-live-search="true" title="Choisir un chargé d'étude">
