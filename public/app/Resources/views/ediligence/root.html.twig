<script src="{{asset('ediligence/assets/js/ediligence_fancybox.js')}}"></script>



{% for flash_message in app.session.flashBag.get('notice') %}
    <script>

            $.notify({
                title: '<strong>Félicitation!</strong> <br/>',
                message: '<strong>{{ flash_message }}</strong>'

            },
                    {
                        type: 'info',
                        offset:
                                {
                                    x: 20,
                                    y: 80
                                }
                    }

            );
    </script>

{% endfor %}
{% for flash_message in app.session.flashBag.get('error') %}
    <script>

        $.notify({
            title: '<strong>Désolé!</strong> <br/>',
            message: '<strong>{{ flash_message }}</strong>'

        },
                {
                    type: 'error',
                    offset:
                            {
                                x: 20,
                                y: 80
                            }
                }

        );
    </script>

{% endfor %}

<script>$(function () {
       // Index.init();
       CompCharts.init();
    });</script>
</body>
