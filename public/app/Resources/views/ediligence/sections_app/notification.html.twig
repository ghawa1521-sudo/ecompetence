<li class="dropdown">
    <a data-toggle="dropdown" href="javascript:void(0)" title="Notifications" aria-expanded="false"
       data-animation="scale-up" role="button">
        <i class="icon md-notifications" aria-hidden="true"></i>
        <span class="badge badge-danger up notif">{{cnotif}}</span>
    </a>
    <ul class="dropdown-menu dropdown-menu-right dropdown-menu-media" role="menu">
        <li class="dropdown-menu-header" role="presentation">
            <h5>NOTIFICATIONS</h5>
            <span class="label label-round label-danger">Nouveau <span  class="notif">{{cnotif}}</span></span>
        </li>
        <li class="list-group" role="presentation">
            <div data-role="container">
                <div data-role="content">
                    {% for notif in notifs %}
                        {% if is_granted('ROLE_GPP')%}
                            <a class="list-group-item" href="{{ path('declaration_autoriser') }}" role="menuitem">
                                <div class="media">
                                    <div class="media-left padding-right-10">
                                        <i class="icon md-receipt bg-red-600 white icon-circle" aria-hidden="true"></i>
                                    </div>
                                    <div class="media-body">
                                        <h6 class="media-heading">{{notif.distributeur}}</h6>
                                        <time class="media-meta" datetime="{% if notif.date %}{{ notif.date|date('Y-m-d') }}{% endif %}">BL: {{notif.numBl}} du {% if notif.date %}{{ notif.date|date('d-m-Y') }}{% endif %}({{notif.typeProduit}})</time>
                                    </div>
                                {% elseif is_granted('ROLE_DISTRI')%}
                                    <a class="list-group-item" href="{{ path('declaration_edit', { 'id': notif.id }) }}" role="menuitem">
                                        <div class="media">
                                            <div class="media-left padding-right-10">
                                                <i class="icon md-receipt bg-green-600 white icon-circle" aria-hidden="true"></i>
                                            </div>
                                            <div class="media-body">
                                                <h6 class="media-heading">modification aurorisée</h6>
                                                <time class="media-meta" datetime="{% if notif.date %}{{ notif.date|date('Y-m-d') }}{% endif %}">BL: {{notif.numBl}} du {% if notif.date %}{{ notif.date|date('d-m-Y') }}{% endif %}({{notif.typeProduit}})</time>
                                            </div>
                                        {% endif %}
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                </div>
        </li>
        <li class="dropdown-menu-footer" role="presentation">
            <a class="dropdown-menu-footer-btn" href="javascript:void(0)" role="button">
                <i class="icon md-settings" aria-hidden="true"></i>
            </a>
            <a href="{{ path('declaration_autoriser') }}" role="menuitem">
                Toutes les notifications
            </a>
        </li>
    </ul>
</li>