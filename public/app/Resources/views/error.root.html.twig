        <link href="{{ asset('design/css/jquery-ui.css') }}" rel="stylesheet"/>
        <link href="{{ asset('design/fonts/css/font-awesome.min.css') }}" rel="stylesheet"/>
        <link href="{{ asset('design/vendor/iCheck/skins/flat/orange.css') }}" rel="stylesheet"/>
        <link href="{{ asset('design/css/animate.min.css') }}" rel="stylesheet"/>
        <link href="{{ asset('design/toastr/toastr.min.css') }}" rel="stylesheet"/>


        <!-- Custom styling plus plugins -->
