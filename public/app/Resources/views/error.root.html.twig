        {% block css %}
            <style>
                .page-error .error-mark {
                    margin-bottom: 33px;
                }
                .page-error header h1 {
                    font-size: 10em;
                    font-weight: 400;
                }
                .page-error header p {
                    margin-bottom: 30px;
                    font-size: 30px;
                    text-transform: uppercase;
                }
                .page-error h2 {
                    margin-bottom: 30px;
                }
                .page-error .error-advise {
                    margin-bottom: 25px;
                    color: #a9afb5;
                }
            </style>
        {% endblock %}
        <!-- Bootstrap core CSS -->

        <link href="{{ asset('design/css/bootstrap.min.css') }}" rel="stylesheet"/>
        <link href="{{ asset('design/css/daterangepicker.css') }}" rel="stylesheet"/>
