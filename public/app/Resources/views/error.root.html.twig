<!DOCTYPE html>
<html lang="fr">

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <!-- Meta, title, CSS, favicons, etc. -->
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="shortcut icon" href="{{ asset('images/logoDGE.png') }}" type="image/png">
        <link rel="icon" href="{{ asset('images/logoDGE.png') }}" type="image/png">
        <title>E-Rh! | {% block title %}{% endblock %}</title>


        {% block datatableCss %}

