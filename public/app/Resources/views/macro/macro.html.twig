{% macro ActiveMenu(interim=null,deleg=null) %}
    {% if is_granted('ROLE_PREVIOUS_ADMIN') == false %}
            {% if app.user.etat == 0 or app.user.etat is null %}
                <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_menu',{'id':'1'}) }}"><i class="fa fa-sign-out" ></i>Activer administration</a></div>
            {% endif %}
            {% if app.user.etat == 1 or app.user.etat is null %}
                <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_menu',{'id':'0'}) }}"><i class="fa fa-sign-out" ></i>Activer mon menu</a></div>
            {% endif %}
    {% endif %}
    {% if interim is defined and is_granted('ROLE_PREVIOUS_ADMIN')== false %}
        {% for interims in interim %}
            <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_homepage',{'_interim_user' : interims.interime.matricule}) }}"><i class="fa fa-sign-out" ></i>Activer intérim {{interims.interime.retour_service.lib}}</a></div>

        {% endfor %}
    {% endif%}
   {% if deleg == 1 %}
     {% if app.user.etat == 2 %}
        <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_menu',{'id':'0'}) }}"><i class="fa fa-sign-out" ></i>Activer mon menu</a></div>
        <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_menu',{'id':'1'}) }}"><i class="fa fa-sign-out" ></i>Activer administration</a></div>  
    {% else %}
        <div><a style="color: #f6f4ff; font-weight: bolder; font-size: 1.2em;" href="{{ path('agent_menu',{'id':'2'}) }}"><i class="fa fa-sign-out" ></i>Activer deleguation</a></div>
    {% endif %}

    {% endif %}

{% endmacro %}


{% macro remaining_time(timelimit, todaysdate) %}

    {% set difference = date(timelimit).diff(date(todaysdate)) %}
    {% set leftDays = difference.d %}
    {% set leftMonths = difference.m %}
    {% set leftYears = difference.y %}

    {% set etat = '' %}
    {% set etatmois = '' %}
    {% set etatday = '' %}


    {% if leftYears == 1 %}
        {% set etat= leftYears ~ ' an'%}

    {% elseif leftYears >= 2  %}
        {% set etat= leftYears ~ ' ans'%}
    {% endif %}

    {% if leftMonths >= 1 %}
        {% set etatmois = leftMonths ~ ' mois'%}
    {% endif %}


    {% if leftDays == 0 or leftDays == 1 %}
        {% set etatday = leftDays ~ ' jour'%}
    {% elseif leftDays > 1 %}
        {% set etatday = leftDays ~ ' jours'%}
    {% endif %}


    {% if timelimit|date("Y-m-d") >= todaysdate|date("Y-m-d") %}
        <font color="blue"><b>{{etat}} {{etatmois}} {{etatday}} restant</b></font>
    {% elseif timelimit|date("Y-m-d") < todaysdate|date("Y-m-d") %}
        <font color="red">expiré depuis {{etat}} {{etatmois}} {{etatday}} </font>
    {% endif %}

{% endmacro %}
