            {% if etat == 0%}
                <label class="label label-warning">
                    Transmis
                {% elseif etat == 1%}
                    <label class="label label-success">
                        Validé & Transmis
                    {% elseif etat == 2%}
                        <label class="label label-danger">
                        {% endif %}

                        {% if niveau >= 0 %}
                            au {{service}}
                        {% endif %}
                    </label>
                    #}
        {% endmacro %}%