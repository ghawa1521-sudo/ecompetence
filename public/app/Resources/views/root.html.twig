{% for flash_message in app.session.flashBag.get('notice') %}
    <script>

    $.notify({
        title: '',
        message: '<strong>{{ flash_message }}</strong>'

    },
            {
                type: 'success',
                offset:
                        {
                            x: 20,
                            y: 80
                        }
            }

    );
    </script>

{% endfor %}
{% for flash_message in app.session.flashBag.get('error') %}
    <script>

        $.notify({
            title: '',
            message: '<strong>{{ flash_message }}</strong>'

        },
                {
                    type: 'error',
                    offset:
                            {
                                x: 20,
                                y: 80
                            }
                }

        );
    </script>

{% endfor %}

