    public function retour_service()
    {
        $tab_imput = '';
        $lib = '';

        if (!empty($this->getCodeSc())) {
            // $service = (empty($this->getCodeSc())? null: $this->getCodeSc()->getCodeSc());
            $service = $this->getCodeSc()->getCodeSc();
            $tab_imput .= $service . ',';
            $lib .= $this->getCodeSc()->getAbrv() . ',';
            //$abrv='SC';
        }
        if (!empty($this->getCodeSd())) {
            //$service = (empty($this->getCodeSd())? null: $this->getCodeSd()->getCodeSd());
            $service = $this->getCodeSd()->getCodeSd();
            $tab_imput .= $service . ',';
            $lib .= $this->getCodeSd()->getAbrv() . ',';
            //$abrv='SD';
        }
        if (!empty($this->getCodeDc())) {
            //$service = (empty($this->getCodeDc())? null: $this->getCodeDc());
            $service = $this->getCodeDc();
            $tab_imput .= $service . ',';
            //$abrv='DC';
            $lib .= $this->getDirection()->getSigle() . ',';
        }
        if (!empty($this->getCodeDg())) {
            //$service = (empty($this->getCodeDg())? null: $this->getCodeDg()->getCodeDg());
            $service = $this->getCodeDg()->getCodeDg();
            $tab_imput .= $service . ',';
            $lib .= $this->getCodeDg()->getAbrv() . ',';
            //$abrv='DG';
        }
        //  var_dump(array('abrv'=>$abrv, 'service'=>$service, 'tab_imput'=>$tab_imput));
        // if(empty($abrv)){$abrv='';}
        // if(empty($service)){$service='';}
        if (empty($tab_imput)) {
            $tab_imput = '';
            $abrv = '';
            $service = '';
            $lib = '';
        } else {
            $tab_imput = substr($tab_imput, 0, strlen($tab_imput) - 1);
            $service = explode(',', $tab_imput)[0];
            $abrv = substr($service, 0, 2);
            $lib = explode(',', $lib);
        }

        return array('abrv' => $abrv, 'service' => $service, 'tab_imput' => $tab_imput, 'lib' => $lib[0], 'tab_lib' => @array_reverse(array_filter($lib)));
    }

