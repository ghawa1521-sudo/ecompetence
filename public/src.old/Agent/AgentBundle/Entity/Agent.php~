                $x2 = strlen($x1);
                $x3 = substr($this->nomJeuneFille, $x2);
                if (!empty($x3)) {
                    $x4 = trim(strtoupper($x1) . ' ' . trim(ucwords(mb_strtolower($x3))));
                } else {
