        }
    }

    public function concatNom()
    {

        $prenoms = null;
        $tprenoms = explode(' ', $this->getPrenoms());

        foreach ($tprenoms as $pren) {
            $tprens = null;
            $tprens = explode('-', $pren);
            $prentiret = null;
            if (count($tprens) > 1) {
                foreach ($tprens as $p) {
                    if ($prentiret != null) {
                        $prentiret .= '-' . trim(ucwords(mb_strtolower($p)));
                    } else {
                        $prentiret = trim(ucwords(mb_strtolower($p)));
                    }
                }
                $prenoms .= ' ' . $prentiret;
            } else {
                $prenoms .= ' ' . $pren;
            }
        }
        return $this->nom . ' ' . $prenoms;
    }

