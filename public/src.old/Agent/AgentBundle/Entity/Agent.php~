    public function getPrenoms()
    {
        //dump($this->getSexe()->getId());die;
        if ($this->getSexe() and $this->getSexe()->getId() == 2) {
            if ($this->getSituationMatri() and $this->getSituationMatri()->getId() == 2 or (empty($this->prenoms) or $this->prenoms == null)) {

                $x = explode(" ", $this->nomJeuneFille);
