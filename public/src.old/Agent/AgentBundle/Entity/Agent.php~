    public function getServiceActuel($param = null, $n = null)
    {


        $service = null;
        $niveau = 0;
        if ($this->getCodeSc()) {
            $service = $this->getCodeSc();
            $niveau = 0;
        } elseif ($this->getCodeSd()) {
            $service = $this->getCodeSd();
            $niveau = 1;
        } elseif ($this->getDirection()) {
            $service = $this->getDirection();
            $niveau = 2;
        } elseif ($this->getCodeDg()) {
            $service = $this->getCodeDg();
            $niveau = 3;
        }
        //die;
        if ($n) {
            if ($n == 0) {
                $service = $this->getCodeSc();
            } elseif ($n == 1) {
                $service = $this->getCodeSd();
            } elseif ($n == 2) {
                $service = $this->getDirection();
            } elseif ($n == 3) {
                $service = $this->getCodeDg();
            }
            $service = $service;
        }
        if ($param > 0 and !$n) {
            $service = $niveau;
        }
        return $service;
    }

