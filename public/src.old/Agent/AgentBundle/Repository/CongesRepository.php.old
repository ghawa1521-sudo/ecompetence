<?php

namespace Agent\AgentBundle\Repository;

/**
 * CongesRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 */
class CongesRepository extends \Doctrine\ORM\EntityRepository {

    public function findCongeAll($typeConges = 0, $niveau = 0) {
        $qb = $this->createQueryBuilder('c')
                ->join('c.agent', 'a');
        //->addSelect('a')
        /*
          if($niveau==0){//Niveau 1: Service_ Direction
          $qb->Where("a.code_dg = :Direction");
          }
          if($niveau==1){//Niveau 2; Sous Direction Section
          $qb->Where("a.code_dc = :Direction");
          }
          if($niveau==2){//Niveau 3: Direction Service Rattaché
          $qb->Where("a.code_sd = :Direction");
          } */
        $qb->andWhere("c.niveau = :niveau")
                ->orderBy('c.datecreation', 'DESC');
        if ($typeConges) {
            $qb->andWhere("c.typeConges = :typeConges")
                    ->setParameter("typeConges", $typeConges);
        }
        $qb->setParameter("niveau", $niveau);
        //->setParameter("Direction", $serviceId);

        return $qb->getQuery()->getResult();
    }

    public function findCongeParam($typeConges = 1, $serviceId, $niveau) {

        $niveaux = array_values(range(5, $niveau - 1));


        $qb = $this->createQueryBuilder('c')
                ->join('c.agent', 'a');
        //->addSelect('a')
        if ($typeConges == 0) {
            if ($niveau == 0) {
//Niveau 1: Service_ Direction
                $qb->Where("a.code_dg = :Direction");
            }
            if ($niveau == 1) {
//Niveau 2; Sous Direction Section
                $qb->Where("a.code_dc = :Direction");
            }
            if ($niveau == 2) {
//Niveau 3: Direction Service Rattaché
                $qb->Where("a.code_sd = :Direction");
            }
        } elseif ($typeConges == 1) {

            $qb->Where("c.typeConges = :typeConges")
                    ->andWhere("a.code_dc <> :Direction")
                    ->setParameter("typeConges", $typeConges);
        }
        //$qb->andWhere("c.niveau in (:niveau)");

        $qb->orderBy('c.datecreation', 'DESC')
          //      ->setParameter("niveau", $niveaux)
                ->setParameter("Direction", $serviceId);

        return $qb->getQuery()->getResult();
    }

    public function findCongeParamId($id, $serviceId, $niveau) {
        $niveaux = array_values(range(5, $niveau - 1));
        $qb = $this->createQueryBuilder('c')
                ->join('c.agent', 'a');
        //->addSelect('a')
        if ($niveau == 0) {
//Niveau 1: Service_ Direction
            $qb->Where("a.code_dg = :Direction");
        }
        if ($niveau == 1) {
//Niveau 2; Sous Direction Section
            $qb->Where("a.code_dc = :Direction");
        }
        if ($niveau == 2) {
//Niveau 3: Direction Service Rattaché
            $qb->Where("a.code_sd = :Direction");
        }
        $qb->andWhere("c.id = :id")
               // ->andWhere("c.niveau in (:niveau)")
                ->orderBy('c.datecreation', 'DESC')
               // ->setParameter("niveau", $niveaux)
                ->setParameter("id", $id)
                ->setParameter("Direction", $serviceId);

        return $qb->getQuery()->getOneOrNullResult();
    }

    public function findCongeReceive($Direction, $etat) {
        $qb = $this->createQueryBuilder('c')
                ->join('c.agent', 'a')
                ->addSelect('a')
                ->Where("a.Direction = :Direction")
                ->andWhere("c.etat >= :etat")
                ->orderBy('c.datecreation,c.etat', 'DESC')
                ->setParameter("etat", $etat)
                ->setParameter("Direction", $Direction);

        return $qb->getQuery()->getResult();
    }

    public function findCongeAutre($Direction, $etat) {
        $qb = $this->createQueryBuilder('c')
                ->join('c.agent', 'a')
                ->addSelect('a')
                ->Where("a.Direction != :Direction")
                ->andWhere("c.etat >= :etat")
                ->setParameter("Direction", $Direction)
                ->orderBy('c.id', 'DESC')
                ->setParameter("etat", $etat);
        return $qb->getQuery()->getResult();
    }

    public function sumConge($agentid, $typeConges, $etat = 0) {
      if($typeConges==1){
        $exercice=date('Y')-1;
      }else{
        $exercice=date('Y');
      }
        $qb = $this->createQueryBuilder('c');
        $qb->select('sum(c.nbrejours) as somme')
      //  $qb->select('ex.annee')
        ->join('c.exercice', 'ex')
                ->where("c.agent =:agent")
                ->andWhere("c.typeConges =:typeConges")
                //->andWhere("c.niveau >=:niveau")
                ->andWhere("c.etat >=:etat")
                ->andWhere("ex.annee = :exercice")
                ->setParameter("agent", $agentid)
              //  ->setParameter("niveau", $niveau)
                ->setParameter("etat", $etat)
                ->setParameter("typeConges", $typeConges)
                ->setParameter("exercice", $exercice);
        return $qb->getQuery()->getOneOrNullResult() ;
    }

    public function MaxDateReprise($agentid) {
        $qb = $this->createQueryBuilder('c');
        $qb->select('c, MAX(c.datefin)')
                ->Where("c.agent =:agent")
                ->setParameter("agent", $agentid);
                //->setMaxResults(1);
        return $qb->getQuery()->getOneOrNullResult();
    }

    /*
      si cessation et datedepart >=datejour et datereprise<datejour
      impossible de passer demande de congé et etat congé encour */

    public function EtatConge($agentid) {
        $qb = $this->createQueryBuilder('c');
        $qb->select('max(c.id) as maxid')
                ->where("c.agent =:agent")
                ->andWhere("c.datedebut <=:date")
                ->andWhere("c.datefin >:date")
                ->andWhere("c.etat =3") //Cessation généré
                ->setParameter("agent", $agentid)
                ->setParameter("date", date('Y-m-d'));
        return $qb->getQuery()->getOneOrNullResult();
    }

}
