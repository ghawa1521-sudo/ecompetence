    </ul>
<div class="tab-content">

  <div role="tabpanel" class="tab-pane active" id="home">

    <table class="records_list table table-striped responsive-utilities jambo_table" id="datatable">
        <thead>

            <tr  class="headings" align="center">
               
               <th><b>Matricule</b></th>
                <th><b>Nom et Prénom(s)</b></th>
                <th><b>Etat affectation</b></th>
                
                <th><b>Actions</b></th>
            </tr>
        </thead>
        <tbody>
            
            
        {% for entity in attente %}
        
            <tr>
                {#<td><a href="{{ path('affecter_edit', { 'id': entity.id }) }}">{{ entity.id }}</a></td>{% if entity.imputation_etat == 1 %}
                                    <td  class="jlo">
                                   
                                    </td>
                                {% else %}  {% endif %}<td>
                                    {{entity.id}}
                                    </td>
                                    #}
                                
                              
                                
                                <td>{{ entity.matricule }}</td>

                
                <td>{{entity.nom_celibataire}} {{entity.nom_marie}} 
                    {#{% if entity.agent.sexe.id == 1 %}
                        Monsieur <span class="gras">{{entity.nom}} {{entity.prenoms}}</span>
                    {% elseif entity.agent.sexe.id == 2 %}
                        {% if  entity.agent.situationMatri.id == 1  %}Mademoiselle <span class="gras">{{entity.agent.nom}} {{entity.agent.prenoms}}</span> {% endif %}
                        {% if  entity.agent.situationMatri.id == 2  %}Madame <span class="gras">{{entity.agent.nom}}</span> née <span class="gras">{{entity.agent.nomJeuneFille}}</span>{% endif %}
                    {% endif %}#}
                </td>
                <td>
                    {% if entity.affecter_etat==0 %}En Attente d'Affectation
                            <label class="label label-info"></label>
                        {% elseif entity.affecter_etat==1 %}Affecté(e) dans un Service
                            <label class="label label-success"></label>
                            {% elseif entity.affecter_etat==2 %}Prise de Service Validée
                                <label class="label label-success"></label>
                    {% endif %}
                </td>
                {#
                <td>
              {% if entity.etatAffectation==1 and entity.signeNote==0 %} <label class="label label-warning">Note d'Affectation / non encore Signé</label> {% endif %}
              {% if entity.etatAffectation==1 and entity.signeNote==1 %} <label class="label label-success">Note d'Affectation /  Signé</label> {% endif %}
              {% if entity.etatAffectation==2 and entity.signeCertificat==0 %} <label class="label label-warning">Certificat de Prise de Service / non encore Signé</label> {% endif %}
              {% if entity.etatAffectation==2 and entity.signeCertificat==1 %} <label class="label label-success">Certificat de Prise de Service / Signé</label> {% endif %}
              </td>#}
                <td align="center">

                      {% if  is_granted('ROLE_RESPO_SRHMG') or deleguation == 0 %}
                      {% if (entity.affecter_etat==0) %}

                          <a class="btn btn-success" href="{{ path('affecter_direction', { 'id': entity.id }) }}">AFFECTER</a>


                    {% endif %}
                    {% endif %}

                </td>
            </tr>
            
           
        {% endfor %}
        </tbody>
    </table>
    <br><br><br><br>

    
</div>
{#}
