{% extends '::base.html.twig' %}
        {% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
    <style>
        th{
            text-align: left !important;
        }
        .dataTables_filter{
            width: auto !important;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
{% block title %}
Affecter un Agent
{% endblock %}
{% block titre_page %}
    Affecter un Agent
    {% endblock %}
{% block body -%}
