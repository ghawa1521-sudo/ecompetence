{% block body %}
    <h1 xmlns="http://www.w3.org/1999/html">Enregistrer un agent</h1>
<div id="wizard" class="form_wizard wizard_horizontal">


        <ul class="wizard_steps">
                <li>
                    <a href="#step-1">
                        <span class="step_no">1</span>
                        <span class="step_descr">
                            Etape 1<br />
                            <small>Informations personnelles</small>
                        </span>
                    </a>
                </li>
                <li>
                    <a href="#step-2">
                        <span class="step_no">2</span>
                        <span class="step_descr">
                Etape 2<br />
                <small>Situation professionnelle</small>
            </span>
                    </a>
                    <li>
                    <a href="#step-3">
                        <span class="step_no">3</span>
                        <span class="step_descr">
                Etape 3<br />
                <small>Situation professionnelle (suite) </small>
            </span>
                    </a>
                </li>

                </li>
                <li>
                    <a href="#step-4">
                        <span class="step_no">4</span>
                        <span class="step_descr">
                Etape 4<br />
                <small>Services</small>
            </span>
                    </a>
                </li>
                <li>
                    <a href="#step-5">
                        <span class="step_no">4</span>
                        <span class="step_descr">
                Etape 5<br />
                <small>Autres Informations</small>
            </span>
                    </a>
                </li>

        </ul>
        {{ form_start(form) }}
