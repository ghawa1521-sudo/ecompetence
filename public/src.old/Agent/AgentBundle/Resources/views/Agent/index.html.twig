{% extends '::base.html.twig' %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
{% block title %}| Liste des agents{% endblock %}
{% block titre_page %}
    <div>Liste des Agents (<span style="color: red;">{{entities|length}}</span>)</div>
{% endblock %}
{% block body -%}
    <div>
            {#<a href="{{ path('agent_new') }}" class="btn btn-info">
                Enregistrer un nouvel Agent
            </a>#}
            <h4>Critère de Recherche (agent en activité)</h4>
            <div class="row" style="background-color: #f7f7f7;">
                <form method="post" {{ form_enctype(form) }}>
                  <div class="col-md-4">
                    
                {{ form_row(form.direction) }}
                {{ form_row(form.emploi) }}
                {{ form_row(form.grade) }}
                
                </div>
                <div class="col-md-4">
                    {{ form_row(form.sexe) }}
                    {{ form_row(form.situation) }}
                    {{ form_row(form.type) }}
                </div>
                <br>    <br>    <br>    <br> <br>      
                <div class="col-md-4">
                    {{ form_row(form._token) }}
                    <input type="submit" value="RECHERCHER" class="btn btn-success col-md-6 col-md-push-3"/>   
                </div>
            </form>
    </div>
    <ul class="nav nav-tabs bar_tabs" role="tablist">

        <li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">En activité</a></li>
        <li role="presentation"><a href="#serv1" aria-controls="serv1" role="tab" data-toggle="tab">Autres positions</a></li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="home">
    <table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
        <thead>
            <tr>
                <th>Matricule</th>
                <th>Nom et Pr&eacute;noms</th>
                <th>Date de Naissance</th>

                <th> Direction </th>
                <th>Fonction</th>
               {# <th>Situation matrimoniale</th>#}

                {#<th>Indice</th>
                <th>Date premiere prise de service</th>#}
                <th>Emploi</th>
                <th>Grade</th>
                <th>Date prise Service DGE</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('agent_show', { 'id': entity.id }) }}">{{ entity.matricule }}</a></td>
                <td>{{entity.concatNom}}</td>
              

                <td>{% if entity.dateNaiss %}{{ entity.dateNaiss|date('d/m/Y') }}{% endif %}</td>
                <td>{% if entity.direction %} {{ entity.direction.sigle }} {% endif %}</td>


               {#} <td>{{ entity.situationMatri }} <br> {{ entity.nbEnf }} enfant(s)</td>

                <td>{{ entity.indice }}</td>
                <td>{% if entity.datePremierService %}{{ entity.datePremierService|date('d-m-Y') }}{% endif %}</td>#}
                <td>{{entity.Fonction}}</td>
                <td>{{entity.Emploi}}</td>
                <td>{% if entity.Emploi%}{{entity.Emploi.Grade}}{% endif %}</td>
                <td>{% if entity.datePriseServiceDge %}{{ entity.datePriseServiceDge|date('d-m-Y') }}{% endif %}</td>
               <td>{{ entity.getEtatPosition }}</td>

                <td>


                        <a class="btn btn-success" href="{{ path('agent_show', { 'id': entity.id }) }}">Fiche de l'agent</a>


                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        </div>
        <div role="tabpanel" class="tab-pane" id="serv1">
    <table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
        <thead>
            <tr>
                <th>Matricule</th>
