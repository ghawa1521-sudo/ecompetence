               <td>{{ entity.getEtatPosition }}</td>

                <td>


                        <a class="btn btn-success" href="{{ path('agent_show', { 'id': entity.id }) }}">Fiche de l'agent</a>


                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        </div>
    </div>
    {% endblock %}
