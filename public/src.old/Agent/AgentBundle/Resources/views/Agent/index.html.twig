                <th>Date de Naissance</th>

                <th> Direction </th>
                <th>Fonction</th>
               {# <th>Situation matrimoniale</th>#}

                {#<th>Indice</th>
                <th>Date premiere prise de service</th>#}
                <th>Emploi</th>
                <th>Grade</th>
                <th>Date prise Service DGE</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in autres %}
            <tr>
                <td><a href="{{ path('agent_show', { 'id': entity.id }) }}">{{ entity.matricule }}</a></td>
                <td>{{entity.concatNom}}</td>
              

                <td>{% if entity.dateNaiss %}{{ entity.dateNaiss|date('d/m/Y') }}{% endif %}</td>
                <td>{% if entity.direction %} {{ entity.direction.sigle }} {% endif %}</td>


               {#} <td>{{ entity.situationMatri }} <br> {{ entity.nbEnf }} enfant(s)</td>

                <td>{{ entity.indice }}</td>
                <td>{% if entity.datePremierService %}{{ entity.datePremierService|date('d-m-Y') }}{% endif %}</td>#}
                <td>{{entity.Fonction}}</td>
                <td>{{entity.Emploi}}</td>
                <td>{% if entity.Emploi%}{{entity.Emploi.Grade}}{% endif %}</td>
