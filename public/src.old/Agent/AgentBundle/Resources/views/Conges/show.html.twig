{% extends '::base.html.twig' %}
{% block datatableCss %}
    <style>
        th{
            text-align: left !important;
        }
    </style>
{% endblock %}

{% block body -%}
    {% set niveau= app.user.agent.retour_service.tab_lib|length%}
    {% set niveau= niveau -1 %}
    <div class="x_title">
        <h2>Détail<small> </small></h2>
        <div class="clearfix"></div>
    </div>
    <div class="col-md-push-3 col-md-6">
        <table class="table table-striped responsive-utilities jambo_table bulk_action">
            <tbody>

                <tr>
                    <th>Type du Congé</th>
                    <td>{{ entity.typeConges }}</td>
                </tr>
                <tr>
                    <th>Matricule</th>
                    <td>{{ entity.agent.matricule }}</td>
                </tr>
                <tr>
                    <th>Nom & Prénoms</th>
                    <td>{{ entity.agent.nom}} {{ entity.agent.prenoms}}</td>
                </tr>
                <tr>
                    <th>Date de départ</th>
                    <td>{{ entity.datedebut|date('d-m-Y') }}</td>
                </tr>
                <tr>
                    <th>Nombre de Jours</th>
                    <td>{{ entity.nbrejours }}</td>
                </tr>

                <tr>
                    <th>Date de reprise</th>
                    <td>{{ entity.datefin|date_modify('+0 day')|date('d-m-Y') }}</td>
                </tr>

                <tr>
                    <th></th>
                    <td></td>
                </tr>
                {% if (entity.numReprise is defined) and (entity.numReprise is not null) %}
                    <tr>
                        <th>Date de reprise effective</th>
                        <td>{{ entity.numReprise.date|date('d-m-Y') }}</td>
                    </tr>
                {% endif %}
                {% if entity.externe==1 %}
                    <tr>
                        <th>Destination</th>
                        <td>Hors Côte d'Ivoire</td>
                    </tr>
                {% endif %}
                {% if entity.etat==2 %}
                    <tr>
                        <th>Raison refus</th>
                        <td>{{entity.objetRefus}}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>Exercice</th>
                    <td>{{ entity.exercice }}</td>
                </tr>
                <tr>
                    <th>Etat</th>
                    <td>
                        {#
                                                {% if (entity.agent.Fonction.id in [5,7]) %}

                                                    {{macro.EtatCongeResponsable(entity.etat,entity.niveau,entity.agent.retour_service.tab_lib[entity.niveau])}}
                                                {% else %}
                                                    {{macro.EtatConge(entity.etat,entity.niveau,entity.agent.retour_service.tab_lib[entity.niveau])}}

                                                {% endif %}
                        {% dump(entity.getValidateur()) %}#}
                        {{entity.getValidateur(0)}}
                    </td>
                </tr>
                <tr>
                    <th>Date de soumission</th>
                    <td>{{ entity.datecreation|date('d-m-Y H:i:s ') }}</td>
                </tr>
                {% if (entity.numCessation is defined) and (entity.numCessation is not null)%}
                    <tr>
                        <th>Certificat Cessation</th>
                        <td>
                            <label class="label label-success">Signé & en ligne</label>
                            <i>depuis le {{entity.numCessation.date|date('d-m-Y')}}</i>
                            <button value="{{ vich_uploader_asset(entity.numCessation.pj, 'imageFile')}}" class="btn btn-success btnShow"> Visualiser</button>



                        </td>
                    </tr>
                {% else %}
                    {% if is_granted('ROLE_RESPO_SRHMG') and (entity.niveau == 0 and (entity.etat == 1 or entity.etat == 3)) %}
                        <tr>
                            <th>Certificat Cessation</th>
                            <td>
                                {% if  entity.etat == 1 and (entity.numCessation is not defined or entity.numCessation is null)%}
                                    <a href="{{ path('conges_view', { 'id': entity.id }) }}" class="btn btn-warning">
                                        Imprimer la cessation
                                    </a>
                                {% endif %}
                                <a href="{{ path('conges_numerisation', { 'id': entity.id,'todo': 3 }) }}" class="btn  btn-primary"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">
                                    Numériser Certificat Cessation
                                </a>
                            </td>
                        </tr>
                    {% endif %}
                {% endif %}
                {% if (entity.numReprise is defined) and (entity.numReprise is not null) %}
                    <tr>
                        <th>Certificat reprise</th>
                        <td>
                            <label class="label label-success">Signé & en ligne</label>
                            <i>depuis le {{entity.numReprise.date|date('d-m-Y')}}</i>
                            <button value="{{ vich_uploader_asset(entity.numReprise.pj, 'imageFile')}}" class="btn btn-success btnShow"> Visualiser</button>
                            {#
                            {{ vich_uploader_asset(entity.numReprise.pj, 'imageFile')}}

                            #}
                        </td>
                    </tr>
                {% else %}
                    {% if is_granted('ROLE_RESPO_SRHMG') and entity.niveau == 0 and (entity.numCessation is defined and entity.numCessation is not null ) %}
                        <tr>
                            <th>Certificat reprise</th>
                            <td>
                                <a href="{{ path('conges_numerisation', { 'id': entity.id,'todo': 4 }) }}" class="btn btn-primary"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">
                                    Numériser Certificat Reprise
                                </a></td></tr>
                            {% endif %}
                        {% endif %}
                <tr>
                    <th></th>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="2">
{% if entity.objetName %}


    <button value="{{ vich_uploader_asset(entity, 'objetFile')}}" class="btn btn-success btnShow">

        Justificatif</button>

{% endif %}

                        {% if (is_granted('ROLE_RESPO_SRHMG') and entity.agent.Fonction.id not in [5,7]) or (app.user.agent.Fonction.id==10 or is_granted('ROLE_DGE') ) %}

{% if (entity.niveau == 0 and entity.etat == 0 ) or (entity.niveau >= 1 and app.user.agent.direction!=null and entity.agent.direction.codeDc==app.user.agent.direction.codeDc) or (entity.niveau == 0 and entity.etat == 0 and  (app.user.agent.Fonction.id==10 or is_granted('ROLE_DGE') ) or ( is_granted('ROLE_RESPO_SRHMG') and entity.agent.Direction.id in [12,13,14,15,16,17,18,19] and entity.etat == 0) )   %}




    {# or (entity.niveau=1 and entity.agent.) #}

                                <a href="{{ path('conges_generate', { 'id': entity.id,'choice': 0 }) }}" class="btn btn-large btn-primary"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">
                                    Valider et Générer la Cessation
                                </a>
                                <a href="{{ path('conges_edit', { 'id': entity.id,'todo':1 }) }}"class="btn btn-danger"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Refuser cette demande ?">
                                    Refuser
                                </a>


                            {% endif %}
                            {% if entity.niveau == 0 and entity.etat == 1 and entity.numCessation is not defined%}
                                <a href="{{ path('conges_view', { 'id': entity.id }) }}" class="btn btn-info">
                                    Imprimer la cessation
                                </a>
                            {% endif %}
                            {% if entity.niveau == 0 and entity.etat == 3 and ((entity.numReprise is not defined or entity.numReprise is null) and (entity.numReprise is not null))%}
                                <a href="{{ path('conges_view', { 'id': entity.id }) }}" class="btn btn-info">
                                    Imprimer le certificat de reprise
                                </a>
                            {% endif %}

{% if  (date() >  entity.datefin) and entity.niveau == 0 and entity.etat!=3 and  (entity.numCessation is defined or entity.numCessation is not null ) and (app.user.agent.direction!=null and entity.agent.direction==app.user.agent.direction) or (entity.niveau == 0 and entity.etat == 1 and app.user.agent.Fonction.id ==10)  %}


                                <a href="{{ path('conges_edit', { 'id': entity.id,'todo': 2 }) }}" class="btn btn-info">
                                    Générer le certificat de reprise
                                </a>
                            {% endif %}
                        {% elseif (is_granted('ROLE_RESPO')  and entity.agent.Fonction.id not in [5,7]) or (app.user.agent.Fonction.id==10 or is_granted('ROLE_DGE'))%}
                            {% set niveau= app.user.agent.retour_service.tab_lib|length%}
                            {% set niveau= niveau -1 %}
                            {% if  (entity.niveau >= niveau and entity.etat==0 and entity.agent.matricule!= app.user.agent.matricule) %}
                                <a href="{{ path('conges_approuv', { 'id': entity.id,'choice': 1 }) }}" class="btn btn-large btn-primary col-md-5"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">
                                    Approuver
                                </a>
                                <a href="{{ path('conges_edit', { 'id': entity.id,'todo':1 }) }}"class="btn btn-danger"
                                   data-confirm="Etes-vous <strong>certain</strong> de vouloir Refuser cette demande ?">
                                    Refuser
                                </a>
                                {% if entity.niveau == 0 and entity.etat == 1  %}

                                {% endif %}
                            {% endif %}

{% if (date() >  entity.datefin) and entity.niveau == 0 and entity.etat!=3 and  (entity.numReprise is not defined or entity.numReprise is null or  entity.etat == 1 ) and


(entity.numCessation is defined and entity.numCessation is not null) and (app.user.agent.direction!=null and

entity.agent.direction.codeDc==app.user.agent.direction.codeDc) %}
                            <a href="{{ path('conges_edit', { 'id': entity.id,'todo': 2 }) }}" class="btn btn-info">
                                Générer le certificat de reprise
                            </a>
                        {% endif %}
                        {% endif %}
                            {% if is_granted('ROLE_RESPO') or is_granted('ROLE_RESPO_SRHMG')%}
                                {% set referer = app.request.server.get('http-referer') %}
                                {% if app.user.agent.Fonction.id !=10 %}
                                    {% if (entity.agent.Direction is defined) and (app.user.agent.Direction.id!=null and entity.agent.Direction.id == app.user.agent.Direction.id) %}
                                        <a href="{{ path('conges',{'action':'default'}) }}" class="btn btn-warning">
                                            Retour
                                        </a>
                                    {% else %}
                                        <a href="{{ path('conges',{'action':'other'}) }}" class="btn btn-warning">
                                            Retour
                                        </a>
                                    {% endif %}
                                {% endif %}

                            {% else %}
{% if (date() >  entity.datefin) and is_granted('ROLE_SAAF') and entity.niveau == 0 and entity.etat!=3 and  (entity.numCessation is defined or entity.numCessation is not null ) and app.user.agent.direction!=null and entity.agent.direction.codeDc==app.user.agent.direction.codeDc %}


    <a href="{{ path('conges_edit', { 'id': entity.id,'todo': 2 }) }}" class="btn btn-info">
        Générer le certificat de reprise
    </a>
{% endif %}

                                <a href="{{ path('conges_active') }}" class="btn btn-warning">
                                    Retour
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        {% endblock %}
