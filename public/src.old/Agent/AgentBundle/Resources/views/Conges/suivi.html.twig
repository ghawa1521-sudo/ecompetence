{% extends '::base.html.twig' %}
{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
    <style>
        .dataTables_filter{
            width: auto !important;
        }
        .records_list{
            width:100% !important;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
{% block title %}
    Suivi des congés|Absences & Statistiques
{% endblock %}
{% block body -%}
    <!-- Nav tabs -->





    <ul class="nav nav-tabs bar_tabs" role="tablist">
<li role="presentation" class="active">
    <a href="#home" aria-controls="home" role="tab" data-toggle="tab">En cours
<span class="label label-danger">{{(enconges|length)+(encongesAb|length)}}</span>

    </a>
</li>

<li role="presentation">
    <a href="#avenir" aria-controls="avenir" role="tab" data-toggle="tab">A venir
<span class="label label-danger">{{(avenir|length)+(avenirAb|length)}}</span>


    </a>
</li>

        <li role="presentation"  ><a href="#archive" aria-controls="archive" role="tab" data-toggle="tab">Statistique</a></li>
    </ul>

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="home">

            <div class="x_title">
                <h2>Congés|Absences en cours<small> </small></h2>
                <div class="clearfix"></div>
            </div>
            <div class="table-responsive">
                <table class="records_list table table-striped responsive-utilities jambo_table bulk_action" id="datatable">
                    <thead>
                        <tr>
                            <th>Nom & Prénoms</th>
                            <th>Serv. / Dir.</th>
                            <th>Type de Congés</th>
                            <th>Date de départ</th>
                            <th>Date de fin</th>
                            <th>Nombre de jours</th>
                            <th>Temps Restant</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entity in enconges %}
                            <tr>
                                <td>{{ entity.agent.nom}} {{ entity.agent.prenoms}}</td>
                                <td>{{entity.agent.Direction.sigle}}</td>
                                <td>{{entity.typeConges.libelle}}</td>
                                <td>{% if entity.datedebut %}{{ entity.datedebut|date('d-m-Y') }}{% endif %}</td>
                                <td>{% if entity.datefin %}{{ entity.datefin|date('d-m-Y') }}{% endif %}</td>
                                <td>{{entity.nbrejours}}</td>
                                <td>{{macro.remaining_time(entity.datefin,'now')}} </td>
                                <td>
                                    <a href="{{ path('conges_show', { 'id': entity.id }) }}">Consulter</a>&nbsp;|&nbsp;
                                </td>
                            </tr>
                        {% endfor %}
{% for entity in encongesAb %}
    <tr>
        <td>{{ entity.emmeteur.nom}}
            {{ entity.emmeteur.prenoms}}</td>

        <td>{{entity.emmeteur.Direction.sigle}}</td>

        <td>{{entity.typeDemande}}</td>

        <td>
            {% if entity.dateDeb %}

                {{ entity.dateDeb|date('d-m-Y') }}

            {% endif %}
        </td>
        <td>
            {% if entity.dateFin %}

                {{ entity.dateFin|date('d-m-Y') }}

            {% endif %}
        </td>
        <td></td>
        <td>{{macro.remaining_time(entity.dateFin,'now')}}</td>
 
</td>
<td>
  
</td></tr>{% endfor %}

                    </tbody>
                </table>
            </div>

        </div>

<div role="tabpanel" class="tab-pane" id="avenir">

    <div class="x_title">
        <h2>Congés|Absences à venir<small></small>
        </h2>
        <div class="clearfix"></div>
    </div>
    <div class="table-responsive">
        <table class="records_list table table-striped responsive-utilities jambo_table bulk_action" id="datatable">
            <thead>
                <tr>
                    <th>Nom & Prénoms</th>
                    <th>Serv. / Dir.</th>
                    <th>Type de Congés</th>
                    <th>Date de départ</th>
                    <th>Date de fin</th>
                    <th>Nombre de jours</th>
                    <th>Temps Restant</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for entity in avenir %}
                    <tr>
                        <td>{{ entity.agent.nom}}
                            {{ entity.agent.prenoms}}</td>
                        <td>{{entity.agent.Direction.sigle}}</td>
                        <td>{{entity.typeConges.libelle}}</td>
                        <td>
                            {% if entity.datedebut %}
                                {{ entity.datedebut|date('d-m-Y') }}
                            {% endif %}
                        </td>
                        <td>
                            {% if entity.datefin %}
                                {{ entity.datefin|date('d-m-Y') }}
                            {% endif %}
                        </td>
                        <td>{{entity.nbrejours}}</td>
<td>{{macro.remaining_time(entity.datedebut,'now')}}</td>

                        </td>
                        <td>
                            <a href="{{ path('conges_show', { 'id': entity.id }) }}">Consulter</a>&nbsp;|&nbsp;
                        </td>
                    </tr>
                {% endfor %}
{% for entity in avenirAb %}
    <tr>
        <td>{{ entity.emmeteur.nom}}
            {{ entity.emmeteur.prenoms}}</td>

        <td>{{entity.emmeteur.Direction.sigle}}</td>

        <td>{{entity.typeDemande}}</td>

        <td>
            {% if entity.dateDeb %}

                {{ entity.dateDeb|date('d-m-Y') }}

            {% endif %}
        </td>
        <td>
            {% if entity.dateFin %}

                {{ entity.dateFin|date('d-m-Y') }}

            {% endif %}
        </td>
        <td></td>
        <td>{{macro.remaining_time(entity.dateFin,'now')}}</td>

</td>
<td></td></tr>{% endfor %}

            </tbody>
        </table>
    </div>

</div>


        <div role="tabpanel" class="tab-pane" id="archive">
            <div class="x_title">
                <h2>Statistique congé Annuel<small> </small></h2>
                <div class="clearfix"></div>
            </div>
            <div class="table-responsive">
                <table class="records_list table table-striped responsive-utilities jambo_table bulk_action" id="datatable">
                    <thead>
                        <tr>
                            <th>Mois</th>


                            {% for i in 1..12 %}
                                <th>{{date('2018-' ~ i ~ '-01')|localizeddate('none', 'none', app.request.locale, "Africa/Abidjan", "MMMM")}}</th>
                                {% endfor %}
                        </tr>
                    </thead>
                    <tbody>

                        <tr style="text-align:center;">
                            <th>Total</th>


                            {% for i in 1..12 %}
                                {% set ii=0 %}
                                {% set total=0%}
                                {% for entity in stats %}
                                    {% if entity.mois == i %}
                                        {% set ii=entity.mois %}
                                        {% set total=entity.total %}
                                    {% endif %}
                                {% endfor %}

                                {% if ii == i %}
                                    <td> <a style="color:blue; font-weight: bold;" href="{{ path('conges_suivi', { 'action': i}) }}">{{total}}</a></td>
                                    {% else %}
                                    <td>0</td>
                                {% endif %}


                            {% endfor %}
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

