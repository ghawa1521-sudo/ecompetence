{% extends '::base.html.twig' %}

{% block body -%}
    <h1>Directions DGE</h1>

    <table class="records_list table table-striped">
        <thead>
            <tr align="left">
                <th>Id</th>
                <th>Libellé</th>
                <th>Sigle</th>
                <th>Siège</th>
                <th>Immeuble</th>
                <th>Etage</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('direction_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.libDirect }}</td>
                <td>{{ entity.sigle }}</td>
                <td>{{ entity.siegeDirect }}</td>
                <td>{{ entity.immeuble }}</td>
                <td>{{ entity.etage }}</td>
                <td>
                <ul>
                    <li>
                        <a href="{{ path('direction_show', { 'id': entity.id }) }}">show</a>
                    </li>
                    <li>
                        <a href="{{ path('direction_edit', { 'id': entity.id }) }}">edit</a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

        <ul>
        <li>
            <a href="{{ path('direction_new') }}">
                Create a new entry
            </a>
        </li>
    </ul>
    {% endblock %}
