{% extends '::base.html.twig' %}

{% block css %}
    <link href="{{ asset('design/css/style.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{asset('ediligence/assets/css/bootstrap-select.min.css')}}">
{% endblock %}



{% block titre_page %}   

{% endblock %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
    <style>
        th{
            text-align: left !important;
        }
        .dataTables_filter{
            width: auto !important;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}

{% block body -%}
    <div class="rows">
        <div class="col-md-4">
            <div id="cacher">
                {{ form_start(form,{'attr':{'id':'form_chk'}}) }}
                {{ form_errors(form) }}

                {% if form.nivo.vars.value == 'dg' %}
                    <div id="viewdc" style="display:block;" class="marche">
                        {{ form_row(form.dc, {'id':'dc', 'label':'Direction'}) }}

                    </div>
                    <div id="viewsd" style="display:none;" class="marche">
                        {{ form_label(form.code_sd, null ,{
                'label_attr':{'id':'label_sd'}
            }) }}
                        {{ form_widget(form.code_sd, {'id':'sd'}) }}

                    </div>
                    <div id="viewsc" style="display:none;" class="marche">
                        {{ form_row(form.code_sc, {'id':'sc'}) }}
                    </div>
                {%endif%}
                {% if form.nivo.vars.value == 'dc' %}
                    <div id="viewsd" style="display:block;" class="marche">
                        {{ form_row(form.code_sd, {'id':'sd', 'label':'Sous Direction'}) }}

                    </div>
                    <div id="viewsc" style="display:none;" class="marche">
                        {{ form_row(form.code_sc, {'id':'sc'}) }}
                    </div>
                {%elseif form.nivo.vars.value != 'dg' %}
                    <div id="viewsd" style="display:block;" class="marche">
                        {{ form_row(form.code_sc, {'id':'sc', 'label':'Service'}) }}

                    </div>
                {%endif%}

            </div>
            <div>{{ form_widget(form.submit) }}</div>
        </div>
        <div class="col-md-8 table-responsive">
            <table class="records_chk table table-striped responsive-utilities jambo_table table-responsive" id="datatable" >
                <thead>

                    <tr class="headings">
                        <th>
                        </th>
                        <th>Matricule</th>
                        <th>Nom</th>
                        <th>Prénoms</th>
                        <th>Service/Direction</th>
                        <th>Fonction</th>
                    </tr>
                </thead>
                <tbody>
                    {% for DecisionAgent in DecisionAgents %}
                        <tr>
                            <td>{{DecisionAgent.matricule}}</td>
                            <td>{{DecisionAgent.matricule}}</td>
                            <td>{{DecisionAgent.nom}}</td>
                            <td>{{DecisionAgent.prenoms}}</td>
                            <td>{{DecisionAgent.retour_service.tab_lib|join('/')}}</td>
                            <td>{{DecisionAgent.Fonction}}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>


    {#{ form_widget(form._token) }#}
    {{ form_end(form, {'render_rest': true}) }}
{% endblock %}

{% block javascript %}

    <script src="{{ asset('design/js/style.js') }}"></script>
    <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>
{% endblock %}