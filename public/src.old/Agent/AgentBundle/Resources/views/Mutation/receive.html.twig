{% extends '::base.html.twig' %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
{% endblock %}

{% block titre_page %}
    <div><h1>Valider les Mutations</h1></div>
{% endblock %}
{% block body %}
	<ul class="nav nav-tabs bar_tabs" role="tablist">


  
  {% if (is_granted('ROLE_RESPO')) %}
	<li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">Mon Service</a></li>
	<li role="presentation"><a href="#serv1" aria-controls="serv1" role="tab" data-toggle="tab">Archives</a></li>
{% endif %}

</ul>

	



 {% if (is_granted('ROLE_RESPO')) %}
	<div class="tab-content">
<div role="tabpanel" class="tab-pane active" id="home">
    <div class="table-responsive">
        
   
	<table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
        <thead>
            <tr>
                <th rowspan="2">Date Demande</th>
                <th rowspan="2">Matricule</th>
                <th rowspan="2">Nom et Prénoms</th>
               
                <th rowspan="2">Motif</th>
                <th rowspan="2">Service d'origine</th>
                <th rowspan="2">Service Souhaité</th>
                <th colspan="2">ETAT VALIDATION</th>
                <th rowspan="2">Actions</th>
            </tr>
            <tr>
              
              <th>Service d'origine</th>
              <th>Service Souhaité</th>
            </tr>
        </thead>
    {% for entity in entities %}
        {% if ((entity.supDest == app.user.agent) and (entity.etatRepSupDir == 1)) or ((entity.SupDir == app.user.agent)) %}
        <tr>
            <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
            <td>{{ entity.emmeteur.matricule }}</td>
            <td>{{ entity.emmeteur.nom }} {{ entity.emmeteur.prenoms }}</td>
            
            <td>{{ entity.Observ }}</td>
            <td>{{ entity.origine }}</td>
            <td>{{ entity.destination }}</td>
            
            
            
          <td align="center">{% if (entity.Etatrepsupdir == 0 ) %}En Attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {#{{entity.motifRejet}}#}
            {% endif %}
                {% if entity.dateRepSupDir %}<br>{{ entity.dateRepSupDir|date('d-m-Y H:i:s') }}{% endif %}
            </td>  
            
        <td align="center">{% if(entity.etatRepDest == 0  and entity.Etatrepsupdir == 1) %}Nouveau{# Etat 0  En attente#}
            <span class="label label-warning"></span>
            {% elseif (entity.etatRepDest == 1) %}Validé
            <span class="label label-success"></span>
            {% elseif (entity.etatRepDest == 2) %}Refusé
            <span class="label label-danger"></span>
           
            {% endif %}
            {% if entity.dateRepDest %}<br>{{ entity.dateRepDest|date('d-m-Y H:i:s') }}{% endif %}

    </td>
    
    <td>
    {% if 
    (((entity.Etatrepsupdir == 0) and (entity.SupDir == app.user.agent)) or 
    ((entity.etatRepDest == 0) and (entity.supDest == app.user.agent)) or
    ((entity.Etatrepgrh == 0) and (entity.Grh == app.user.agent)))
    %}
        <a href="{{ path('mutation_valid', { 'id': entity.id }) }}" class="btn btn-success btn-sm col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">Autoriser</a>
        <a href="{{ path('mutation_reject', { 'id': entity.id }) }}" class="btn btn-danger btn-sm col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Rejeter cette demande ?">Refuser</a>
    {% endif %}

                    <!--
                    <li>
                        <a href="{{ path('demande_valid', { 'id': entity.id }) }}">Valider</a>
                    </li>
                -->

            </td>
        </tr>
        {% endif %}
    {% endfor %}
    </table>
     </div>
</div>
    <div role="tabpanel" class="tab-pane" id="serv1">
        <div class="table-responsive">
	<table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
        <thead>
            <tr>
                <th rowspan="2">Date Demande</th>
                <th rowspan="2">Matricule</th>
                <th rowspan="2">Nom et Prénoms</th>    
                <th rowspan="2">Motif</th>
                <th rowspan="2">Service d'origine</th>
                <th rowspan="2">Service Souhaité</th>
                <th colspan="2">ETAT VALIDATION</th>
                <th rowspan="2">Actions</th>
            </tr>
            <tr> 
              <th>Service d'origine</th>
              <th>Service Souhaité</th>
            </tr>
        </thead>
    {% for entity in archive %}
        {% if ((entity.supDest == app.user.agent) and (entity.etatRepSupDir == 1)) or ((entity.SupDir == app.user.agent)) %}
        <tr>
            <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
            <td>{{ entity.emmeteur.matricule }}</td>
            <td>{{ entity.emmeteur.nom }} {{ entity.emmeteur.prenoms }}</td>
            
            <td>{{ entity.Observ }}</td>
            <td>{{ entity.origine }}</td>
            <td>{{ entity.destination }}</td>
            
            
            
          <td align="center">{% if (entity.Etatrepsupdir == 0 ) %}En Attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {#{{entity.motifRejet}}#}
            {% endif %}
                {% if entity.dateRepSupDir %}<br>{{ entity.dateRepSupDir|date('d-m-Y H:i:s') }}{% endif %}
            </td>  
            
        <td align="center">{% if(entity.etatRepDest == 0  and entity.Etatrepsupdir == 1) %}Nouveau{# Etat 0  En attente#}
            <span class="label label-warning"></span>
            {% elseif (entity.etatRepDest == 1) %}Validé
            <span class="label label-success"></span>
            {% elseif (entity.etatRepDest == 2) %}Refusé
            <span class="label label-danger"></span>
           
            {% endif %}
            {% if entity.dateRepDest %}<br>{{ entity.dateRepDest|date('d-m-Y H:i:s') }}{% endif %}

    </td>
    
    <td>
    {% if 
    (((entity.Etatrepsupdir == 0) and (entity.SupDir == app.user.agent)) or 
    ((entity.etatRepDest == 0) and (entity.supDest == app.user.agent)) or
    ((entity.Etatrepgrh == 0) and (entity.Grh == app.user.agent)))
    %}
        <a href="{{ path('mutation_valid', { 'id': entity.id }) }}" class="btn btn-success btn-sm col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">Autoriser</a>
        <a href="{{ path('mutation_reject', { 'id': entity.id }) }}" class="btn btn-danger btn-sm col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Rejeter cette demande ?">Refuser</a>
    {% endif %}

                    <!--
                    <li>
                        <a href="{{ path('demande_valid', { 'id': entity.id }) }}">Valider</a>
                    </li>
                -->

            </td>
        </tr>
        {% endif %}
    {% endfor %}
    </table>
    </div>
</div>
</div>
{% endif %}

{% endblock %}

{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
