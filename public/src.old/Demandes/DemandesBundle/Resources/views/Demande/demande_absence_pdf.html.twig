{% extends app.request.attributes.get('_route')=='demande_print'
? '::gabarit_print.html.twig'
: '::gabarit_preview.html.twig' %}

{% block bootstrap %}
    {% if app.request.attributes.get('_route')=='demande_print'%}
        <link href="{{app.request.getSchemeAndHttpHost() ~ asset('design/css/bootstrap.min.css') }}" rel="stylesheet"/>

    {% endif %}
{% endblock %}

{% block service %}
    {% if (entity.supDir.fonction.id == 10 or entity.supDir2.fonction.id == 10 ) %}
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<sapn class="gras">Le Directeur Général</sapn>
        {% else %}
            {{"Service des Ressources Humaines "|upper}} <br>
        {{"et des Moyens Généraux"|upper}}
    {% endif %}
{% endblock %}

{% block sousService %}
    {% if (entity.supDir.fonction.id != 10 and entity.supDir2.fonction.id != 10 ) %}
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-----------------------<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<sapn class="gras">Le chef de Service</sapn>
        {% endif %}
    {% endblock %}

{% block ref %}N°:____________MEF/DGE/SRHMG{#{{app.user.agent.nom|slice(0,1)~app.user.agent.prenoms|slice(0,1)}}#}{% endblock %}



{% block titre %}
    <div align="center" style="font-size:30px; font-family:CenturyFontBold !important; border: solid; border-radius: 15px; width: 60%; margin: auto;">
        AUTORISATION D'ABSENCE
    </div>

{% endblock %}
{% block datePdf %}{#{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y') }}{% endif %}#}{% endblock %}
{% block contenuPdf %}


    <div class="row">

        <table border="0" width=100% style="line-height:1.8em; font-size: 12pt;">
            <tbody>

                <tr>
                    <td valign="top" width="20%" class="col-md-2">Je soussigné</td>
                    <td valign="top" class="col-md-10" width="80%">:

                        {#
                        {% if entity.agent.sexe.id == 1 %}

                            Monsieur
                        {% elseif entity.agent.sexe.id == 2 %}
                            {% if  entity.agent.situationMatri.id == 1  %}Mademoiselle {% endif %}
                            {% if  entity.agent.situationMatri.id == 2  %}Madame {% endif %}

                        {% endif %}
                        #}
                        {{ entity.emmeteur.nom}} {{ entity.emmeteur.prenoms}}
                    </td>

                </tr>
                <tr>
                    <td valign="top" class="col-md-2">Matricule</td>
                    <td valign="top" class="col-md-10">: {{ entity.emmeteur.matricule }}</td>
                </tr>

                <tr>
                    <td valign="top" class="col-md-2">Emploi</td>
                    <td valign="top" class="col-md-10">: {{ entity.emmeteur.Emploi}}</td>
                </tr>

                <tr>
                    <td valign="top" class="col-md-2">Fonction  </td>
                    <td valign="top" class="col-md-10">: {{ entity.emmeteur.Fonction}}</td>
                </tr>

                <tr>
                    <td valign="top" class="col-md-2">Service</td>
                    <td valign="top" class="col-md-10">: {{ entity.emmeteur.Direction}}</td>
                </tr>
                <tr>
                    <td valign="top" class="col-md-2">Destination</td>
                    <td valign="top" class="col-md-10">: {{entity.destination}}</td>
                </tr>

                <tr>
                    <td valign="top" class="col-md-2">Motif</td>
                    <td valign="top" class="col-md-10">: {{entity.objet}}</td>
                </tr>

                <tr>
                    <td class="col-md-2">Période
<td class="col-md-10">:
    {% if entity.dateDeb != entity.dateFin %}

                    
                        {% if entity.dateDeb %}Du {{ entity.dateDeb|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")|replace({" 01 ": "&nbsp;1<sup>er</sup>&nbsp;"})|raw  }}{% endif %}
                        au {% if entity.dateFin %} {{ entity.dateFin|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")|replace({" 01 ": "&nbsp;1<sup>er</sup>&nbsp;"})|raw  }}{% endif %} inclus.
                    
                    {% else %}
                    Le {{ entity.dateDeb|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")|replace({" 01 ": "&nbsp;1<sup>er</sup>&nbsp;"})|raw  }}.
                    {% endif %} </td>
                </tr>









            </tbody>
        </table>




    </div>








    <script src="{{ asset('design/js/style.js') }}"></script>

{% endblock %}
{% block ampliationPdf %}

    {% if app.request.attributes.get('_route')=='demande_print'%}
        <table border="0" style="width:230%; height: 99%;">
        {% else %}
            <table border="0" style="width:200%; height: 99%;">
            {% endif %}
            <tr>
                <td width="50%" valign="top"> <br>
                    <span class=""><u>supérieur 1</u></span>:
                    <br>
                    {% if entity.etatVal == 1 %}
                        accordé le,
                        {% if (entity.dateRepSupDir2) %}
                            <span class="">{{entity.dateRepSupDir2|date('d-m-Y')}}</span>
                            à
                            <span class="">{{entity.dateRepSupDir2|date('H:i:s')}}</span>
                        {% endif %}
                        <br>
                        par
                        {% if (entity.matValidSup2) %}
                            <span class="">
                                {{entity.matValidSup2.nom}}
                                {{entity.matValidSup2.Prenoms}}
                            </span>
                        {% endif %}
                    {% elseif entity.etatVal == 0  %}
                        Accordé le,
                        {% if (entity.dateRepSupDir) %}
                            <span class=""> {{entity.dateRepSupDir|date('d-m-Y')}} </span>à
                            <span class=""> {{entity.dateRepSupDir|date('H:i:s')}} </span>
                        {% endif %}
                        <br>
                        par
                        {% if (entity.supDir) %}<span class=""> {{entity.supDir.nom}} {{entity.supDir.Prenoms}}</span>{% endif %}
                    {% endif %}
                    <br>   <br>
                    <span class=""><u>supérieur 2</u>:</span>
                    <br>
                    accordé le,
                    {% if (entity.dateRepSupDir2) %}
                        <span class="">{{entity.dateRepSupDir2|date('d-m-Y')}}</span>
                        à
                        <span class="">{{entity.dateRepSupDir2|date('H:i:s')}}</span>
                    {% endif %}
                    <br>
                    par
                    {% if (entity.matValidSup2) %}
                        <span class="">
                            {{entity.matValidSup2.nom}}
                            {{entity.matValidSup2.Prenoms}}
                        </span>
                    {% endif %}
                </td>
<td width="50%" style="text-align:center;" class="gras" rowspan="2" style="vertical-align: top;" valign="top" valign="top">

                    {#<div style="font-size:1.9em;">VISA SRHMG</div>#}
                    <br>
                    <div style="font-size:12pt;">
                        {% if (entity.supDir.fonction.id == 10 or entity.supDir2.fonction.id == 10 ) %}
                            {% if (fonctionbase.returnSignAut() != null) %}
<u>{{fonctionbase.getSignataireDg(date())['entete'] | raw}}</u>
<br><br>
P.I Le
{{fonctionbase.getSignataireDg(date())['directeur'] | raw}}

                            {#
                                {{fonctionbase.returnSignAut()['entete'] | raw}}
                                <br>  <br><br><br><br><br>
                                {{fonctionbase.returnSignAut()['signataire'] | raw}}

                                #}
                            {% endif %}
                            {#  Le Directeur Général    <br>  <br><br><br><br><br> {{dgName}}
                            P. le Directeur Général <br> et par Intérim <br><br><br><br><br>
                             {{dgAname}}#}
                        {% elseif (is_granted('ROLE_PREVIOUS_ADMIN')) %}
                            P. Le {{app.user.agent.fonction.libFonc}}<br> et par Intérim <br><br><br><br><br>{{fonctionbase.returnConnect().nom}} {{fonctionbase.returnConnect().prenoms}}

                        {% else %}

                            {% if fonctionbase.getSignataire(entity.dateRepGrh) and fonctionbase.getSignataire(entity.dateRepGrh)==1 %}

                                {{entity.grh.fonction.libFonc}}    <br>  <br><br><br><br><br>{{entity.grh.nom}} {{entity.grh.prenoms}}
                                <br>
                            {% else %}
                                {{fonctionbase.getSignataire(entity.dateRepGrh)['entete'] | raw}}
                                <br>  <br><br><br><br><br>
                                {{fonctionbase.getSignataire(entity.dateRepGrh)['signataire'] | raw}}
                            {% endif %}
                        {% endif %}
                    </div>

                </td>
            </tr>
            <tr>
                <td valign="top">


                </td>
            </tr>
        </table>

    {% endblock %}