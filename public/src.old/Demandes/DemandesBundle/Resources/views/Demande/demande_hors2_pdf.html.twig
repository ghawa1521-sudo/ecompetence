{% extends app.request.attributes.get('_route')=='demande_print'
? '::gabarit_print.html.twig'
: '::gabarit_preview_hors.html.twig' %}

{% block bootstrap %}
    {% if app.request.attributes.get('_route')=='demande_print'%}
        <link href="{{app.request.getSchemeAndHttpHost() ~ asset('design/css/bootstrap.min.css') }}" rel="stylesheet"/>

    {% endif %}
{% endblock %}
{% block entete_droit1 %}//-)<br><br>Monsieur le Directeur de Cabinet Adjoint du Ministre de l'Economie et des Finances <br><br>{% endblock %}
    {% block entete_droit2 %}//-) B I D J A N{% endblock %}
{% block service %}
    <span class="gras">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Le Directeur Général</span>

{% endblock %}
{% block titre %}
    <div align="left" style="width: 100%; margin: auto;">
        <table border=0 width="60%">
            <tr><td class="ecriture" valign="top" rowspan="3" width="20%"><span class="gras"><u>Objet</u>:</span></td>
                <td class="ecriture" style="padding-top: 0px;">Demande d'autorisation de</td>
            </tr>
            <tr><td class="ecriture">sortie du territoire de {{entity.emmeteur.getCivilite.libsitf}}</td></tr>
            <tr><td class="ecriture">{{entity.emmeteur.concatNom|striptags}}</td></tr>
        </table>
    </div>

{% endblock %}

{% block ref %}<br><br><br>N°____________MEF/DGE/SRHMG/{{app.user.agent.nom|slice(0,1)~app.user.agent.prenoms|slice(0,1)~app.user.agent.nomJeuneFille|slice(0,1)}}{% endblock %}
{% block datePdf %}{#{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}#}{% endblock %}
{% block contenuPdf -%}

    <div style="background-color: white; color:black; line-height:1.5em;">
        J'ai l'honneur de vous soumettre la demande d'autorisation de sortie du territoire de
        {{entity.emmeteur.getCivilite.libsitf}}

        {{entity.emmeteur.concatNom|striptags}}, matricule {{entity.emmeteur.matricule}}, {{entity.emmeteur.emploi.libEmpl}}, en service à la Direction Générale de l'Economie
<br/><br/>
A cet effet, vous trouverez, joint à la présente, un projet d'autorisation y relatif.
</div>
</div>


