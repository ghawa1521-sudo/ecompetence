        <li role="presentation"><a href="#hors" aria-controls="message" role="tab" data-toggle="tab">Hors Côte d'Ivoire<label class="label label-danger"></a></li>
        <li role="presentation"><a href="#serv3" aria-controls="message" role="tab" data-toggle="tab">Bac à impression<label class="label label-danger"></a></li>
