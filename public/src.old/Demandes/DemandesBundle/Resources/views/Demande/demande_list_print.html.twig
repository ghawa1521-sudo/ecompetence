    <ul class="nav nav-tabs bar_tabs" role="tablist">


        <li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">Autorisation d'Absence <label class="label label-danger">{% if(absence|length > 0) %}{{absence|length}}{% endif %}</a></li>
        <li role="presentation"><a href="#serv1" aria-controls="message" role="tab" data-toggle="tab">Attestation de Présence <label class="label label-danger">{% if(attestation|length > 0) %}{{attestation|length}}{% endif %}</a></li>
