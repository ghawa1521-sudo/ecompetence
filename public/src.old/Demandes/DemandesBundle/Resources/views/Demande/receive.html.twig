{% extends '::base.html.twig' %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
{% endblock %}

{% block titre_page %}
    <div><h1>Demandes Reçues</h1></div>
{% endblock %}
{% block body %}



  <!-- Nav tabs -->
  <ul class="nav nav-tabs bar_tabs" role="tablist">

    {% if is_granted('ROLE_RESPO') or deleguation == 0 %}
    <li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">Autorisation d'absence</a></li>
    <li role="presentation"><a href="#serv3" aria-controls="message" role="tab" data-toggle="tab">Archives</a></li>
    {% endif %}

  </ul>

  <!-- Tab panes -->
  <div class="tab-content">


    {% if is_granted('ROLE_RESPO') or deleguation == 0 %}
    
            {# debut niveau RESPO #}
        <div role="tabpanel" class="tab-pane active table-responsive" id="home">

            <table class="records_list table-responsive table-striped responsive-utilities jambo_table">
            <thead>

                <tr>
                <th rowspan="2">Date Demande</th>
                <th rowspan="2">Matricule</th>
                <th rowspan="2">Nom et Prénoms</th>
              
                <th rowspan="2">Motif</th>
                <th rowspan="2">Période d'absence</th>
                <th rowspan="2">Destination</th>
                <th rowspan="2">Avis SAAF</th>
                <th colspan="3">ETAT VALIDATION</th>
                <th rowspan="2">Actions</th>
            </tr>
            
            <tr>

              <th>
                {% if app.user.agent.direction %}
                    {% if app.user.agent.direction.etatDirection == 0 %} 
                Chef de Section 
                {% elseif app.user.agent.direction.etatDirection == 1 %}
                    Chef de Service
                {% endif %}
                {% else %}Directeur Général
            {% endif %}
        </th>
              <th>
                {% if app.user.agent.direction %}
                {% if app.user.agent.direction.etatDirection == 0 %} 
                Chef de Service Rattaché
                {% elseif app.user.agent.direction.etatDirection == 1 %}
                    Directeur
                {% endif %}{% else %}Directeur Général{% endif %}</th>
              <th>Service Ressources Humaines</th>
            </tr>
            </thead>
                {% for entity in entities %}
{# debut tr tableau respo recu non archive#}
{#{% if (entity.etatArchive == 0 ) %}#}
                    <tr>
                        <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
                        <td>{{ entity.emmeteur.matricule }}</td>
                        <td>{{ entity.emmeteur.nom }} {{ entity.emmeteur.prenoms }}</td>
                  
                        <td>{{ entity.objet }}</td>
                        <td align="center">{{ entity.dateDeb|date('d-m-Y') }} <br>au<br> {{ entity.dateFin|date('d-m-Y') }}</td>
                        <td>{{ entity.destination }}</td>
                        <td>{% if entity.avis %}{{ entity.avis.getLibAvis|raw }}{% endif %}</td>
                        <td align="center">{% if (entity.Etatrepsupdir == 0) %}En Attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {{entity.motifRejet}}
            {% endif %}
                {% if entity.dateRepSupDir %}<br>{{ entity.dateRepSupDir|date('d-m-Y H:i:s') }}{% endif %}
            </td>
            
            <td align="center">
                {% if (entity.Etatrepsupdir2 == 0) and (entity.Etatrepsupdir == 1) %}En attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir2 == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir2 == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {{entity.motifRejet}}
                {% endif %}
                {% if entity.dateRepSupDir2 %}<br>{{ entity.dateRepSupDir2|date('d-m-Y H:i:s') }}{% endif %}

        </td>
        <td align="center">{% if(entity.Etatrepgrh == 0 and entity.etatRepSupDir2 == 1 ) %}En attente{# Etat 0  En attente#}
            <span class="label label-warning"></span>
            {% elseif (entity.Etatrepgrh == 1) %}Validé
            <span class="label label-success"></span>
            {% elseif (entity.Etatrepgrh == 2) %}Refusé
            <span class="label label-danger"></span>
            <br>
            {{entity.motifRejet}}
            {% endif %}
            {% if entity.dateRepGrh %}<br>{{ entity.dateRepGrh|date('d-m-Y H:i:s') }}{% endif %}

    </td>
                <td>
        {% if 
         (((entity.Etatrepsupdir == 2) and (entity.SupDir == app.user.agent)) or 
          ((entity.Etatrepsupdir2 == 2) and (entity.SupDir2 == app.user.agent)) or
          ((entity.Etatrepgrh == 2) and (entity.Grh == app.user.agent)))
        %}

    {% elseif 
    (((entity.Etatrepsupdir == 0) and (entity.SupDir == app.user.agent)) or 
    ((entity.Etatrepsupdir2 == 0) and (entity.SupDir2 == app.user.agent)) or
    ((entity.Etatrepgrh == 0) and (entity.Grh == app.user.agent)) or deleguation == 0)
    %}          
        <div class="row">
                <a href="{{ path('demande_valid', { 'id': entity.id }) }}" class="btn btn-success col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">Valider la Demande</a>
            
            
                <a href="{{ path('demande_do_reject', { 'id': entity.id }) }}" class="btn btn-danger col-md-12">Rejeter la Demande</a>
            </div>                      
        {#<a href="{{ path('demande_show', { 'id': entity.id }) }}" class="btn btn-info btn-xs">Autoriser / Refuser</a>#}

        

    {% endif %}


                        <!--
                        <li>
                            <a href="{{ path('demande_valid', { 'id': entity.id }) }}">Valider</a>
                        </li>
                    -->

                </td>
            </tr>{#{% endif %}#}
            {# fin tr tableau respo recu non archive#}
                
            
        {% endfor %}
        </table>

        </div>

            <div role="tabpanel" class="tab-pane" id="serv3">

                    <table width="100%" class="records_list table table-striped table-responsive responsive-utilities jambo_table">
                    <thead>
                        <tr>
                        <th rowspan="2">Date Demande</th>
                        <th rowspan="2">Matricule</th>
                        <th rowspan="2">Nom et Prénoms</th>
                   
                        <th rowspan="2">Objet</th>
                        <th rowspan="2">Date Réponse</th>
                        <th colspan="2">ETAT VALIDATION</th>
                        <th rowspan="2">Actions</th>
                    </tr>
                    <tr>
                        <th>Directeur / Chef de Service</th>
                        <th>Service Ressources Humaines</th>
                    </tr>
                    </thead>
                    {% for entity in archive %}
{# debut tr tableau respo recu non archive#}
{#{% if (entity.etatArchive == 1 ) %}#}
                    <tr>
                        <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
                        <td>{{ entity.emmeteur.matricule }}</td>
                        <td>{{ entity.emmeteur.nom }} {{ entity.emmeteur.prenoms }}</td>
                  
                        <td>{{ entity.objet }}</td>
                        <td align="center">{% if (entity.Etatrepsupdir == 0) %}En Attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {{entity.motifRejet}}
            {% endif %}
                {% if entity.dateRepSupDir %}<br>{{ entity.dateRepSupDir|date('d-m-Y H:i:s') }}{% endif %}
            </td>
            
            <td align="center">
                {% if (entity.Etatrepsupdir2 == 0) and (entity.Etatrepsupdir == 1) %}En attente{# Etat 0  En attente#}
                <span class="label label-warning"></span>
                {% elseif (entity.Etatrepsupdir2 == 1) %}Validé
                <span class="label label-success"></span>
                {% elseif (entity.Etatrepsupdir2 == 2) %}Refusé
                <span class="label label-danger"></span>
                <br>
                {{entity.motifRejet}}
                {% endif %}
                {% if entity.dateRepSupDir2 %}<br>{{ entity.dateRepSupDir2|date('d-m-Y H:i:s') }}{% endif %}

        </td>
        <td align="center">{% if(entity.Etatrepgrh == 0 and entity.etatRepSupDir2 == 1 ) %}En attente{# Etat 0  En attente#}
            <span class="label label-warning"></span>
            {% elseif (entity.Etatrepgrh == 1) %}Validé
            <span class="label label-success"></span>
            {% elseif (entity.Etatrepgrh == 2) %}Refusé
            <span class="label label-danger"></span>
            <br>
            {{entity.motifRejet}}
            {% endif %}
            {% if entity.dateRepGrh %}<br>{{ entity.dateRepGrh|date('d-m-Y H:i:s') }}{% endif %}

    </td>
                <td>
        {% if 
         (((entity.Etatrepsupdir == 2) and (entity.SupDir == app.user.agent)) or 
          ((entity.Etatrepsupdir2 == 2) and (entity.SupDir2 == app.user.agent)) or
          ((entity.Etatrepgrh == 2) and (entity.Grh == app.user.agent)))
        %}

    {% elseif 
    (((entity.Etatrepsupdir == 0) and (entity.SupDir == app.user.agent)) or 
    ((entity.Etatrepsupdir2 == 0) and (entity.SupDir2 == app.user.agent)) or
    ((entity.Etatrepgrh == 0) and (entity.Grh == app.user.agent)))
    %}          
        <div class="row">
                <a href="{{ path('demande_valid', { 'id': entity.id }) }}" class="btn btn-success col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">Valider la Demande</a>
            
            
                <a href="{{ path('demande_do_reject', { 'id': entity.id }) }}" class="btn btn-danger col-md-12">Rejeter la Demande</a>
            </div>                      
        {#<a href="{{ path('demande_show', { 'id': entity.id }) }}" class="btn btn-info btn-xs">Autoriser / Refuser</a>#}

        

    {% endif %}


                        <!--
                        <li>
                            <a href="{{ path('demande_valid', { 'id': entity.id }) }}">Valider</a>
                        </li>
                    -->

                </td>
            </tr>{#{% endif %}#}
            {# fin tr tableau respo recu non archive#}
                
            
        {% endfor %}

                </table>

                </div>
              </div>

          </div>

{% endif %}




{#dump(entities)#}


{% endblock %}

{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
