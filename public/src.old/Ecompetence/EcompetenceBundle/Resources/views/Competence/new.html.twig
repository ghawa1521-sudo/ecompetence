                                        {{adr.email}} / 
                                    {% endfor %}
                                    </td>
                                    
                                </tr>
                                <tr>
                                  
                                    <td style="font-size:16px;">{% if (entit.situationMatri) %}{{ entit.situationMatri }}{% endif %} 
