                    $(document).ready(function () {
                        // Smart Wizard
                        $('#wizard_verticle').smartWizard({
                            transitionEffect: 'slide'
                        });

                    });



                </script>

                <script type="text/javascript">
                    var donnee;
                    $(document).ready(function () {

                        $.ajax({
                            type: "GET",
                            url: Routing.generate('agent_cv_api',{id:{{id}}}),
                            dataType: "json",
                            success: function (data) {
                                $('#flex-tree-check').flexTree({
                                    //console.log(donnee);
                                    type: 'checkbox',
                                    name: 'competences[]',
                                    collapsed: false,
                                    items: jQuery.parseJSON(data)});
                            }
                        });



                    });
                </script>

