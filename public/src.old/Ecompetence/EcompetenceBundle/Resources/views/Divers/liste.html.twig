{% block body %}
   

       {# {{ form_start(form) }}
        {{ form_errors(form) }}#}
        <style>
        .info{
              color:black;
        }
        .ok th{
        color:white;
        border:1px solid white;
        font-weight:bold;
        }
        .ok td{
         text-align:left; 
