 </div>
 <div class="col-md-4">
  <a class="btn btn-info btn-block col-lg-4" style="background-color:#20B2AA; color:white;font-weight:bold; font-size:16px;" href="{{ path('competence_new', { 'id':id }) }}"> ➕ Ajouter une compétence</a>
 </div>
  <div class="col-md-2"> </div>
