{% extends '::base.html.twig' %}
{%from "EcompetenceBundle:macro:macro.html.twig" import recursiveDomaine,recursiveDomaineAff%}


{% block body %}
   

       {# {{ form_start(form) }}
        {{ form_errors(form) }}#}
        <style>
        .info{
              color:black;
        }
        .ok th{
        color:white;
        border:1px solid white;
        font-weight:bold;
        }
        .ok td{
         text-align:left; 
         color:black;
         font-weight:bold; 
         border:1px solid lightgray
        }
        .ok thead{border:1px solid white;background-color: #008080;
        }
       
         </style>

                         <div style="padding-left:4px;padding-right:4px;">
                            <div class="x_panel" style="background-color:white;border-radius: 4px;">
                             
                                <div class="x_content">

                                    <div class="col-md-7 col-sm-3 col-xs-12 profile_left">

                     
                          <table class='info'  border=0>                 
                         
                          <tr>  
                         
                                    <td style="font-weight: bold;font-size:20px;"> <b>
                                        {% if (entit.nom) %}
                                        {{ entit.nom }}
                                        {% endif %}
                                        {% if (entit.prenoms) %}
                                        {{ entit.prenoms }}
                                        {% endif %}</b>
                                        {% if (entit.matricule) %}
                                            <b  style="color: red;" >{{ ' ('~entit.matricule~')' }} </b>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>                                      
                                      <td style="font-size:16px;">{% if (entit.emploi) %}
                                        {{ entit.emploi.libEmpl }}
                                        {% endif %}
                                    </td>
                            
                                 <tr>
                                   <td style="font-size:16px;">
                                        {% if (entit.dateNaiss) %}
                                        Né le {{ entit.dateNaiss|date('d-m-Y') }} 
                                        {% endif %}
                                        {% if (entit.LieuNaissance) %}
                                         à {{entit.LieuNaissance.lieuNaiss}} 
                                        {% endif %}</td>
                                </tr>
                                 <tr>
                                   
                                    <td style="font-size:16px;">
                                        {% if (entit.telPort) %}
                                        Tèl:{{entit.telPort}}</td>
                                        {% endif %}
                                </tr>

                                <tr>
                                    
                                    <td style="font-size:16px;">Email :
                                        {% if (entit.email) %}{{entit.email}}{% endif %}</td>
                                </tr>
                                <tr>
                                  
                                    <td style="font-size:16px;">{% if (entit.emailPerso) %}{{entit.emailPerso}}{% endif %}
                                    {%for adr in entit.adresse%}
                                        {{adr.email}} / 
                                    {% endfor %}
                                    </td>
                                    
                                </tr>
                                <tr>
                                  
                                    <td style="font-size:16px;">{% if (entit.situationMatri) %}{{ entit.situationMatri }}{% endif %} 
                                        {% if (entit.nbEnf) %}/ {{ entit.nbEnf }} enfant(s){% endif %} </td>
                                </tr>
                          </table>  
          {#     {% if (entity.imageName) %}
             <img src="{{ vich_uploader_asset(entity, 'imageFile') }}" alt="{{ entity.imageName }} Avatar">
             
          {% elseif (entity.sexe.id == 1 ) %}
                <img src="{{ asset('images/img_test_agent.png')}}" Avatar>
            {% elseif (entity.sexe.id == 2 ) %}
                <img src="{{ asset('images/woman.png')}}" Avatar>
            {% endif %}
             #}                                     
                                                    
       
                                           <!-- end of image cropping -->
       </div>  
            
             <div class="col-lg-offset-2 col-md-3  profile_left">

                                        <div class="profile_img">

                                            
           <div id="cropE-avatar">
                                            
          <div class="avatar-view" title="Change the avatar">                                      
           {% if (entit.imageName) %}
             <img src="{{ vich_uploader_asset(entit, 'imageFile') }}" alt="{{ entit.imageName }} Avatar">
             
          {% elseif (entit.sexe.id == 1 ) %}
                <img src="{{ asset('images/img_test_agent.png')}}" Avatar>
            {% elseif (entit.sexe.id == 2 ) %}
                <img src="{{ asset('images/woman.png')}}" Avatar>
            {% endif %}
                                                
                                                    
             </div>                                          
      </div>
          </div>
        </div>
       </div>
      </div>
 </div>
       
        <div class="x_panel">
        <hr>
           <div class="row">
           <div class="panel panel-success">
            <div class="panel-heading"><h2  style="color:orangered;">Expériences professionnelles</h2></div>
            <div class="panel-body">
                  
                          
             <table class="table dataTable ok" style="text-align:center;"> 
             <thead>
               <tr>  
                 <th> Période</th>
                 <th> Employeur</th>
                 <th> Poste occupé</th>
                 <th> Action</th>
                </tr>         
             </thead>
             <tbody>
                             
                 {% for entities in entity%}
                
               <tr>
                <td>
                      {%if(entities.dateDebExp)%} Du {{entities.dateDebExp|date('d-m-Y')}} {%endif%}
                      {%if(entities.dateFinExp)%} au {{entities.dateFinExp|date('d-m-Y')}}{%else%} à Aujourd'hui {%endif%}
                 </td>
                 <td>
                    {%if(entities.nomEmployeur)%}{{entities.nomEmployeur}}{% elseif entities.structure %}{{ entities.structure }}{%endif%}
                 </td>
                  <td>
                    {%if(entities.posteOccupe)%}{{entities.posteOccupe}}{% elseif entities.libExp %}{{ entities.libExp }}{%elseif(entities.fonction)%}{{entities.fonction.LibFonc}} {%endif%}
                  
                 </td>
                 <td width="100px">
               
                    <a class="btn btn-success" href="{{ path('experience_edit', { 'id': entities.id,'ag':entities.agent.id }) }}">Modifier</a>
                   
                 </td>
               </tr>  
       
                
               {%endfor%}
             </tbody>

                    </table> 
             </div>
             </div>
             </div>
        </div>
               
<style>
.help-block{
color:red;
font-weight:bold;
}
</style>

 <div class="row">
 <div class="col-md-2"> </div>
