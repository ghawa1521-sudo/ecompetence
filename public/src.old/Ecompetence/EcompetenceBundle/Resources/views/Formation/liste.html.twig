  ➕ Ajouter une experience</a>
 </div>
 <div class="col-md-2"> </div>
 </div>
 <div class="row">
 <div class="col-md-2"> </div>
 <div class="col-md-4" style="margin-right:10px;">
 <a class="btn btn-success btn-block col-lg-4" href="{{ path('formation_detail', { 'id':id }) }}">Affichage du details des formations de l'agent</a>
 </div>
 <div class="col-md-4">
  <a class="btn btn-info btn-block col-lg-4" style="background-color:#20B2AA; color:white;font-weight:bold; font-size:16px;" href="{{ path('competence_new', { 'id':id }) }}"> ➕ Ajouter une compétence</a>
 </div>
 <div class="col-md-2"> </div>
 </div>
 <div class="row">
 <div class="col-md-2"> </div>
 <div class="col-md-4" style="margin-right:10px;">
 <a class="btn btn-primary btn-block col-lg-4" href="{{ path('agent_cv1', { 'id': entit.id }) }}">Visualiser le CV</a>
 </div>
  <div class="col-md-4">
  <a class="btn btn-info btn-block col-lg-4" style="background-color:#20B2AA; color:white;font-weight:bold; font-size:16px;" href="{{ path('langue_new', { 'id':id}) }}"> ➕ Ajouter le niveau de langue </a>
  </div> 
 <div class="col-md-2"> </div>
 </div>
 <div class="row">
 <div class="col-md-2"> </div>
 <div class="col-md-8">
 <a class="btn btn-warning btn-block col-lg-4" href="{{ path('agent_cv', { 'id':id }) }}">Retour</a>
 </div>
 <div class="col-md-2"> </div>
 </div>
 {% endblock %}


