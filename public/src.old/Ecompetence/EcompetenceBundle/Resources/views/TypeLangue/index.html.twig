{% extends '::base.html.twig' %}

{% block body -%}
    <div class="panel panel-success" >
        <div class="panel-heading" ><h1>Liste  type langue</h1></div>
        <ul>
            <br>
                <a class="btn btn-success" style='width:205px;' href="{{ path('typelangue_new') }}">
                    Créer un nouveau type
                </a>
            
        </ul>
    </div>
    <table class="table dataTable ok" style="text-align:center">
        <thead>
            <tr>
                <th>N°</th>
                <th>Libelle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('typelangue_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.libelle }}</td>
                <td>
                <ul>
                    
                        <a class="btn btn-primary btn-sm" href="{{ path('typelangue_edit', { 'id': entity.id }) }}">Modifier</a>
                    
                    {#<li>
                        <form action="{{ path('typelangue_delete', { 'id': entity.id }) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce type de langue ?');">
                          <input type="hidden" name="_method" value="DELETE">
                          <button type="submit" class="btn btn-danger">Supprimer</button>
                       </form>

                    </li>#}
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

       
    {% endblock %}
