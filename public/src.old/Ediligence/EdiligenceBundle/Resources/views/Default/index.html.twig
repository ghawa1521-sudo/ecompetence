{% extends '::ediligence/base.html.twig' %}

{% block javascripts %}



{% endblock %}

{% block stylesheets %}
    <style>
        .plop {
            animation: Plop 1s infinite;
            color: red;
            font-weight: bold;

        }@keyframes Plop{
            0%{opacity:1;}
            50% {opacity:0;}
            100%{opacity:1;}
        }
    </style>
{% endblock %}

{% block body %}
    {#
    {{dump(fonctionbase.Notif())}}
    #}
    {% if app.user.agent.retour_service.lib == 'DGE'%}
        {% set services='Direction Générale'%}
    {% else%}
        {% set services='Service ' ~ app.user.agent.retour_service.lib %}
    {%endif%}
    Bienvenue {{app.user.agent.getCivilite.codesitf}}
    <strong>{{app.user.agent.nom}}
        {{app.user.agent.prenoms}}
        {{app.user.agent.nomJeuneFille}}
        {{app.user.agent.matricule}}
        ({{services}})</strong>
    <br>
    {% set countelt = suivi_expire.entity|length %}
{% if countelt > 0 %}{% set class = "plop" %}{% else %}{% set class = "" %}{% endif %}
<h3><b><font color="#406F09"><span class="glyphicon glyphicon-briefcase"></span> E-DILIGENCE</font></b></h3>
<br />
<div>APPLICATION SPECIALISEE DANS LE TRAITEMENT DES DILIGENCES</div>
<br />
<div id="wrapper">
    <div id="page-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <i class="fa {{class}}">DOSSIERS A TRAITER EN URGENCE SIGNALEE</i>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">

                            <div class="col-lg-12">
                                <div class="table-responsive">
                                    <table class="table table-vcenter table-condensed table-bordered">
                                        <thead>
                                            <tr>
                                                <td colspan='8' style="font-weight: bold;">Dossiers dont le délai de traitement a expixé
                                                </td>
                                            </tr>
                                            <tr style="font-size: 1.0em; font-weight: bold;">
                                                <td>Destinataire</td>
                                                <td>Emetteur</td>
                                                <td>Nature courrier</td>
                                                <td>Objet courrier</td>
                                                <td>Date imputation</td>
                                                <td>Etat</td>
                                                <td>Delai</td>
                                                <td>Action</td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% set i = 0 %}
                                            {% for entit_i in suivi_expire.entity %}
                                                {% set i = i + 1 %}{% set service = '' %}
                                                {% for entit_d in suivi_expire.entity1 %}
                                                    {%if entit_i['id'] == entit_d[0].imputation.courrier.id %}
                                                        {% set service = service ~ entit_d['service'] ~ ' - ' %}
                                                    {% endif%}

                                                {% endfor %}


                                                <tr>
                                                    {#<td>{{ i }}</td>#}
                                                    <td></td>
                                                    <td>{{ service|trim(' - ', 'right') }}</td>
                                                    <td>{{ entit_i['libcourrier'] }}</td>
                                                    <td>{{ entit_i['objet']|raw|striptags|slice(0, 150) }}</td>

                                                    <td> {% if entit_i[0] is defined and entit_i[0] !=null  %}
                                                        {{ entit_i[0].dateImput|date('d-m-Y H:i:s') }}
                                                        {% endif %}
                                                        </td>

                                                        <td><b> Expiré</b></td>

                                                        <td>{% if entit_i[0] is defined  and entit_i[0] !=null %}
                                                            {{ entit_i[0].delaiImput|date('d-m-Y H:i:s') }}
                                                            <br>{{macro.remaining_time(entit_i[0].delaiImput,'now')}} 
                                                            {% endif %}
                                                            </td>

                                                            <td>
                                                                {% if entit_i.etat == 0 %}
                                                                    {% if entit_i['idtypecourrier'] ==2 %}

                                                                        {% if (entit_i['etatcourrier']==1) %}
                                                                            {#
                                                                            <a href="{{ path('courrier_dgedel', { 'id': entit_i[0].id }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                        #}
                                                                        {% else %}
                                                                            <a href="{{ path('courrier_interne_imput', { 'id': entit_i['id'] }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Imputer</a>
                                                                            {# <a href="{{ path('courrier_dgedel1', { 'id': entit_i['id'] }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                             #}
                                                                        {% endif %}

                                                                    {% else %}
                                                                        {% if(entit_i['etatcourrier']==1) %}
                                                                            {% if(entit_i['etat_trait'] == 0) %}
                                                                                {#
                                                                                <a href="{{ path('courrier_dgedel', { 'id': entit_i[0].id }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                                #}
                                                                            {% else %}
                                                                                <a href="{{ path('courrier_recap_trait', { 'id': entit_i[0].id }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Consulter</a>
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endif %}
                                                                {% else %}
                                                                    <a href="{{ path('courrier_recap_trait', { 'id': entit_i[0].id }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Consulter</a>
                                                                {% endif %}
                                                            </td>
                                                        </tr>

                                                        {% endfor %}


                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="panel panel-default">
                                        <div class="panel-heading">
                                            <i class="fa">DOSSIERS A TRAITER ABSOLUMENT</i>
                                        </div>
                                        <div class="panel-body">
                                            <div class="table-responsive">
                                                {% set count = 0 %}
                                                {% for key,suivis in suivi %}
                                                    {% if count == 0 %}

                                                        {% if suivis.entity|length > 0 %}
                                                            {% set class_today = "plop" %}
                                                        {% else %}
                                                            {% set class_today = "" %}
                                                        {% endif %}

                                                        <div class="row">
                                                        {% endif %}
                                                        {% set count = count + 1 %}
                                                        <div class="col-lg-6">
                                                            <div class="table-responsive">
                                                                <table class="table table-vcenter table-condensed table-bordered">
                                                                    <thead>
                                                                        <tr>
                                                                            <td colspan='8' style="font-weight: bold;">
                                                                                {% if key == 0 %}<b class="{{class_today}}">Aujourd'hui (</b>{% endif %}
                                                                               {# {{fonctionbase.calculdate('now'|date_modify("+"~key~" day")|date('Y-m-d'),key,1)|localizeddate('none', 'none', app.request.locale, "Africa/Abidjan", "cccc d MMMM Y")}}#}
                                                                                 {{tdate[key]|localizeddate('none', 'none', app.request.locale, "Africa/Abidjan", "cccc d MMMM Y")}}
                                                                                {% if key ==0 %}<b class="{{class_today}}">)</b>{% endif %}
                                                                                &nbsp;&nbsp;/&nbsp;&nbsp;<b>{{suivis.entity|length}} </b>élément(s) en attente
                                                                            </td>
                                                                        </tr>
                                                                        <tr style="font-size: 1.0em; font-weight: bold;">
                                                                            <td>Destinataire</td>
                                                                            <td>Emetteur</td>
                                                                            <td>Nature courrier</td>
                                                                            <td>Objet courrier</td>
                                                                            <td>Date imputation</td>
                                                                            <td>Etat</td>
                                                                            <td>Delai</td>
                                                                            <td>Action</td>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>

                                                                        {% set i = 0 %}
                                                                        {% for entit_i in suivis.entity %}
                                                                            {% set i = i + 1 %}{% set service = '' %}
                                                                            {% for entit_d in suivis.entity1 %}
                                                                                {%if entit_i['id'] == entit_d[0].imputation.courrier.id %}
                                                                                    {% set service = service ~ entit_d['service'] ~ ' - ' %}
                                                                                {% endif%}

                                                                            {% endfor %}


                                                                            <tr>
                                                                                {#<td>{{ i }}</td>#}
                                                                                <td></td>
                                                                                <td>{{ service|trim(' - ', 'right') }}</td>
                                                                                <td>{{ entit_i['libcourrier'] }}</td>
                                                                                <td>{{ entit_i['objet']|raw|striptags|slice(0, 150) }}</td>

                                                                                <td> {% if entit_i[0] is defined and entit_i[0] !=null  %}
                                                                                    {{ entit_i[0].dateImput|date('d-m-Y H:i:s') }}
                                                                                    {% endif %}
                                                                                    </td>

                                                                                    <td><b> En cours</b></td>

                                                                                    <td>{% if entit_i[0] is defined  and entit_i[0] !=null %}
                                                                                        {{ entit_i[0].delaiImput|date('d-m-Y H:i:s') }}
                                                                                        <br><font color="red">{{macro.remaining_time(entit_i[0].delaiImput, 'now'|date)}} ant</font>
                                                                                        {% endif %}
                                                                                        </td>
                                                                                        <td>
                                                                                            {% if entit_i.etat == 0 %}
                                                                                                {% if entit_i['idtypecourrier'] ==2 %}

                                                                                                    {% if (entit_i['etatcourrier']==1) %}
                                                                                                        {#
                                                                                                        <a href="{{ path('courrier_dgedel', { 'id': entit_i[0].id }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                                                    #}
                                                                                                    {% else %}
                                                                                                        <a href="{{ path('courrier_interne_imput', { 'id': entit_i['id'] }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Imputer</a>
                                                                                                        {# <a href="{{ path('courrier_dgedel1', { 'id': entit_i['id'] }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                                                         #}
                                                                                                    {% endif %}

                                                                                                {% else %}
                                                                                                    {% if(entit_i['etatcourrier']==1) %}
                                                                                                        {% if(entit_i['etat_trait'] == 0) %}
                                                                                                            {#
                                                                                                            <a href="{{ path('courrier_dgedel', { 'id': entit_i[0].id }) }}" class="btn btn-danger"><span class="glyphicon glyphicon-inbox"></span> Supprimer</a>
                                                                                                            #}
                                                                                                        {% else %}
                                                                                                            <a href="{{ path('courrier_recap_trait', { 'id': entit_i[0].id }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Consulter</a>
                                                                                                        {% endif %}
                                                                                                    {% endif %}
                                                                                                {% endif %}
                                                                                            {% else %}
                                                                                                <a href="{{ path('courrier_recap_trait', { 'id': entit_i[0].id }) }}" class="btn btn-success"><span class="glyphicon glyphicon-inbox"></span> Consulter</a>
                                                                                            {% endif %}
                                                                                        </td>
                                                                                    </tr>

                                                                                    {% endfor %}

                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>
                                                                        {% if count == 2 %}
                                                                            {% set count = 0 %}
                                                                        </div>
                                                                    {% endif %}
                                                                    {% endfor %}
                                                                        {% if count == 1 %}
                                                                            {% set count = 0 %}
                                                                        </div>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>




                                            </div>
                                        </div>


                                        {% endblock %}
