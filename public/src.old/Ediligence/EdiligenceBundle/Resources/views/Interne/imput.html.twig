{% extends '::ediligence/base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('ediligence/assets/css/bootstrap-select.min.css')}}">
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>

    <script>
        function libDest(val, val_id)
        {
            var position = val_id.indexOf("Z1");
            if (parseInt(position) != -1)
            {
                val_id = val_id.replace('1', '');
            }
            valeur = val_id + val;
           // alert(val_id);
            switch (valeur)
            {
        {% set p=1 %}
        {#% for linedg in dg_imput %}
                    case 'A{{linedg.codeDc}}':
                        return "{{linedg.sigle}}";
                        break;
        {% endfor %}

        {% for linedc in dc_imput %}
                    case 'B{{linedc.codeDc}}':
                        return "{{linedc.sigle}}";
                        break;
        {% endfor %}

        {% for linert in scerattache_imput %}
                    case 'D{{linert.codeDc}}':
                        return "{{linert.sigle}}"; break;
        {% endfor %}
        {% for linert in conseiller_imput %}
                    case 'Z{{linert.matricule}}':
                        return "{{linert.nom}} {{linert.prenoms}} {{linert.nomJeuneFille}}"; break;
        {% endfor %}
            
        {% for lineas in assistant %}
                    case 'Z{{lineas.matricule}}':
                        return "{{lineas.nom}} {{lineas.prenoms}} {{lineas.nomJeuneFille}}"; break;
        {% endfor %#}  

        {% for lineet in agent_srv %}
        case 'Z{{lineet.matricule}}':return "{{lineet.nom}} {{lineet.prenoms}} {{lineet.nomJeuneFille}}";break;
        case 'A{{lineet.matricule}}':return "{{lineet.nom}} {{lineet.prenoms}} {{lineet.nomJeuneFille}}"; break;
        {% endfor %}   

                    default:
                        return "Non&nbsp;Défini";
                }
            }
    </script>

{% endblock %}

{% block body %}
    <div class="content-header">
        <div class="header-section">
            <h1>
                <i class="gi gi-notes_2"></i>Transmettre courrier<br><small>Veuillez remplir les champs ci-dessous</small>
            </h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Transmettre</li>
        <li><a href="">Nouveau</a></li>
    </ul>
    <div class="row">
        <div class="col-md-offset-1 col-md-10">
            <form method="post" class="form-vertical col-md-12" style="color:#006;" name="frm_imputer" enctype="multipart/form-data" id="form_Imputation">
                <div class="block">
                    <!-- Basic Form Elements Title -->
                    <div class="block-title">

                        <h2><strong>Nouveau Courrier</strong></h2>
                    </div>

                    <div class="row" >
                        <div class="col-md-12">
                            <div class="bien">
                                <table>
                                    <tr >
                                        <td align="right" width="25%"><b>COURRIER N°&nbsp;&nbsp;&nbsp;{{entities.id}}</b></td>
                                        <td><b>{#{ entity.id}#}</b></td>
                                    </tr>
                                    <tr>
                                        <td align="right" width="25%" style="vertical-align: middle;"><b>OBJET:&nbsp;&nbsp;&nbsp;</b></td>
                                        <td><b>{{entities.objet|raw|striptags|slice(0, 150) }}</b></td>
                                    </tr>
                                    <tr style="vertical-align: central;">
                                        <td align="right" width="25%"><b>DE:&nbsp;&nbsp;&nbsp;</b></td>
                                        <td>
                                            <input id="De1" name="De" value="{{app.user.agent.matricule}}" checked="" disabled="" type="checkbox">
                                            <label for="De1">{{app.user.agent.nom}}&nbsp;{{app.user.agent.prenoms}}</label>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>   

                    <div class="row" >
                        <div class="col-md-6" id="GDestt">
                            {{ macro.entete_imput_i(app.user.agent.fonction.id, agent_srv) }}
                        </div>

                        <div class="col-md-6">
                            <div class="form-group bien">
                                <font size="+1"><b>INSTRUCTIONS</b></font>
                                {% for line in all_inst %}
                                    <br>
                                    <input id="In{{line.id}}" name="In[]" value="{{line.id}}" onclick="return popupchk('In{{line.id}}');" type="checkbox">
                                    <label for="In{{line.id}}" id="lIn{{line.id}}">{{line.libIbstruction|raw}} </label><div id="dIn{{line.id}}" style="float:right; width:100%; display:block;"></div>
                                {% endfor %}

                                <br><br><br>
                                <label for="InP" id="lInP">INSTRUCTIONS&nbsp;PARTICULIERES:</label><div id="dIn00" style="float:right;"></div>
                                <textarea id="InP" class="form-control" name="txtInstr" value="15"></textarea>
                            </div>
                            <button id="btnp" type="button" value="eff_imputation" class="btn btn-primary pull-right form-control" name="a_eff_imputatio" onclick="prioritedefine()"><span class="glyphicon glyphicon-ok-sign"> EFFECTUER L'IMPUTATION</span>
                            </button>
                            <input type="hidden" name="ok" value="ok">
                        </div>

                        <div style="display:none">
                            <div id="val_check"></div>
                            <div id="div_delais"></div>
                            <div id="div_select"></div>
                        </div>

                        <div id="titlediv">
                            <a id="alg1" href="#lg1" title=""></a>
                        </div>
                        <div id="lg1" style="display:none" >

                        </div> 

                    </div>

                </div>
            </form>
        </div>
    </div>
    <ul>
        <li>
            <a href="{{ path('interne') }}">Retour</a>
        </li>
    </ul>
{% endblock %}
