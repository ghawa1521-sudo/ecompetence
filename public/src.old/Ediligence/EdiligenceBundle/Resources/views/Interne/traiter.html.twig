{% extends '::ediligence/base.html.twig' %}

{% block body %}{% set cpt = 0 %}{% set dossier = 0 %}
<div class="content-header">
    <div class="header-section">
        <h1>
            <i class="gi gi-notes_2"></i>Diligences reçues<br><small>&nbsp;</small>
        </h1>
    </div>
</div>
<ul class="breadcrumb breadcrumb-top">
    <li>Traiter une diligence</li>
    <!--<li><a href="">Nouveau</a></li>-->
</ul>
<div class="row">
 <form method="post" class="form-vertical col-md-12" style="color:#006;" name="frm_imputer" enctype="multipart/form-data" id="form_Imputation" action="">
    <div class="col-md-offset-2 col-md-8">
        <div class="block">
            <!-- Basic Form Elements Title -->
            <div class="block-title">

                <h2><strong>Nouvelle diligence interne reçue</strong></h2>
            </div>

            <div style="float:right;" class="bien2">
                <b>COURRIER: N° &nbsp; {{entities.courrier.id}}</b>
            </div>
            <div class="bien">
                <b>Par: <font color="#000000">&nbsp;{{entities.matriculeImput.nom}}&nbsp;{{entities.matriculeImput.prenoms}}</font></b><br>
                <b>A: <font color="#000000">&nbsp;&nbsp;{{app.user.agent.nom}}&nbsp;{{app.user.agent.prenoms}}</font></b><br>
                <b>OBJET:<font color="#000000">&nbsp;{{entities.courrier.objet|raw|striptags|slice(0, 150) }}</font></b>
            </div>
            <div class="form-group bien">
               <font size="+1"><b>INSTRUCTIONS</b></font><br>
                <font color="#000000">
                  {% set val=0 %}
                  {% for entitie in instruction%}
                  {% set val=val +1%}
                <br>
                  {{val}} - {{entitie.instImput.libIbstruction|raw}}<br>    
                    {% endfor %}
                  {% if entities.instPart %}
                  <br>
                  {{val + 1}} - Cas particulier: {{entities.instPart|raw}}<br>
                  {% endif %}
              
                </font>
            </div>
            {% if entities.courrier.piecejointe != null%}      
            <label>Télécharger la Pièce Jointe:
                    <a class="red" href="{{ vich_uploader_asset(entities.courrier.piecejointe, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                    <i class="ace-icon fa fa-download bigger-130"></i>
                    </a>
            </label>
            {% endif %}
            {% if ( (rejet[0].librejet  is defined) and (rejet[0].librejet !=null) ) %}
            {#% if rejet.librejet !=null is defined  %#}
            <div class="form-group bien">
             <font size="+1"><b>OBSERVATIONS DU REJET:</b></font><br><br>
             <table width="100%" class="table table-bordered table-striped table-hover table-condensed">
              <tr>
                <td>Date transmission</td><td>Motif</td><td>Télécharger</td>
              </tr>
              {% for rejets in rejet%}
              <tr>
                  <td>{{rejets.daterejet|date('d-m-Y') }}</td>
                  <td>{{rejets.librejet|striptags|slice(0, 150) }}</td>
                  <td><a class="red" href="{{vich_uploader_asset(rejets.pjtraitement, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                    <i class="ace-icon fa fa-download bigger-130"></i>
                    </a>
                 </td>
              </tr>
              {% endfor %}
             </table>
            </div>
            {% endif%}
            
            {%if(is_granted('ROLE_CHARGE_ETUDES')==false)%}
            <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter Directement</span></button>
            <button id="btnpt" type="submit" value="imputer" class="btn btn-primary pull-right form-control" name="imputer"><span class="glyphicon glyphicon-ok-sign"> Effectuer l'imputation</span></button>
            {% else%}
             <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter</span></button>   
            {% endif%}
            <a class="btn btn-primary pull-right form-control" href="{{ path('courrier_csrecu') }}">Retour</a>       
            <input type="hidden" name="coord" value="{{coord}}">
            <input type="hidden" name="NbrePers" value="{{NbrePers}}">
            <input type="hidden" name="idimputdir" value="{{idimputdir}}">
            
          
        </div>
</form>
    </div>
</div>
<ul>
    <li>
        <a href="{{ path('interne_dilig') }}">&nbsp;</a>
    </li>
</ul>
{% endblock %}
