{% extends '::ediligence/base.html.twig' %}

{% block body %}

     <div class="content-header">
        <div class="header-section">
            <h1><i class="gi gi-envelope"></i> Dossier<br><small>Mes diligences</small></h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Actions</li>
        <li><a href="">Mes Dossiers</a></li>
    </ul>
    <div class="block full">
        <div class="block-title">
            <h2><strong>Liste</strong> dossiers</h2>
        </div>{#
        <p><a href="https://dge.ci" target="_blank">DataTables</a> is a plug-in for the Jquery Javascript library. It is a highly flexible tool, based upon the foundations of progressive enhancement, which will add advanced interaction controls to any HTML table. It is integrated with template's design and it offers many features such as on-the-fly filtering and variable length pagination.</p>
#}

        <div class="table-responsive">
            <table id="example-datatable" class="table table-vcenter table-condensed table-bordered">
                <thead>
                    <tr>
                        <th>Num</th>
                        <th>Destinataire</th>
                        <th>Objet</th>
                        <th>Date imputation</th>
                        <th>Télécharger</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% set i = 0 %}{% set y = 0 %}{% set noms = '' %}
                    {% for entity in entities %}
                         {% set i = i + 1 %}
                          {% if(entity.imput==dest[0].imputation.id) %} 
                            {% for desti in dest %}
                             {% set noms = noms ~ desti.matriculeimpute.nom ~ " " ~ desti.matriculeimpute.prenoms ~ " " ~ desti.matriculeimpute.nomJeuneFille ~ " - " %}
                            {% endfor %}
                          {% endif %}
                        <tr>
                            <td>{{i}}</td>
                            <td>{{ noms|trim(' - ', 'right') }}</td>
                            <td>{{ entity.objet|raw|striptags|slice(0, 150) }}</td>
                            <td>{{entity.dateImput|date('d-m-Y')}}</td>
                            <td><a class="red" href="{{vich_uploader_asset(entity.piecejointe, 'imageFile')}}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger"><i class="ace-icon fa fa-download bigger-130"></i></a></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-xs">
                                    {% if entity.etat==null %}
                                     <a href="{{ path('coordinateur_delimpute', { 'id': entity.imput }) }}" data-toggle="tooltip" title="Annuler" class="btn btn-danger"><i class="fa fa-remove"></i></a>
                                    {% endif %}
                                 </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <ul>
            <li>
                <a href="{{ path('courrier_new') }}">Transmettre diligence</a>
            </li>
        </ul>
    </div>
    {% endblock %}
