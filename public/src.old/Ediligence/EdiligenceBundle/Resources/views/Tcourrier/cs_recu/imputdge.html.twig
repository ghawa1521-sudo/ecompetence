                            <div class="bien">
                                <table border="0" width="100%">
                                    <tr>
                                        <td width="60%">
                                            <table>
                                                <tr >
                                                    <td align="right"  width="50%"><b>COURRIER N°:&nbsp;&nbsp;&nbsp;</b></td>
                                                    <td align="left"><b>{{ entity.id}}</b></td>
                                                </tr>
                                                <tr>
                                                    <td align="right" width="50%"><b>OBJET:&nbsp;&nbsp;&nbsp;</b></td>
