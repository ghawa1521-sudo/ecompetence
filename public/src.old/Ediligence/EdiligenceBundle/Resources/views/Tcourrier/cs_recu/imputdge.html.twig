                                                </tr>
                                                <tr>
                                                    <td align="right" width="50%"><b>DE:&nbsp;&nbsp;&nbsp;</b></td>
                                                    <td>
                                                        <input id="De1" name="De" value="{{app.user.agent.codeDg.codeDg}}" checked="" disabled="" type="checkbox">
                                                        <label for="De1">{{app.user.agent.retour_service.abrv}}</label>
                                                    </td>
                                                </tr>
                                            </table>                     
                                        </td> 
                                        {#
                                        <td width="40%" align="left">
                                               <table>
                                                <tr >
                                                    <td align="right"  width="50%"><b>PROVENANCE:&nbsp;&nbsp;&nbsp;</b></td>
                                                    <td align="left"><b>{{ entity.sourceCour}}</b></td>
                                                </tr>
                                                <tr>
                                                    <td align="right" width="50%"><b>EXPEDITEUR:&nbsp;&nbsp;&nbsp;</b></td>
                                                    <td align="left" ><b>{{ entity.adresseenreg }}</b></td>
                                                </tr>
                                                <tr>
                                                    <td align="right" width="50%"><b>LE:&nbsp;&nbsp;&nbsp;</b></td>
                                                    <td>
                                                        <b>{{ entity.dateorigine|date('d/m/Y') }}&nbsp;&nbsp;&nbsp;SN:{{entity.reforigine}}</b>
                                                    </td>
                                                </tr>
                                            </table>                          
                                        </td>#}
                                    </tr>
                                    {#<tr>
                                        <td colspan="2" align="right">Dossier/N° {{"%04d"|format(entity.numenregistrement)}} du {{entity.dateCreat|date('d/m/Y')}}</td>
                                    </tr>#}
                                </table> 
                        </div>
                    </div>
                </div>
                <div class="row" >
                    <div class="col-md-6" id="GDestt">
                    {% if app.user.agent.fonction.typeCompte.roleBase =='ROLE_DGE'%}
                      {{macro.directiongenerale(app.user.agent.fonction.typeCompte.roleBase, dg_imput) }}
                      {{macro.directioncentrale(app.user.agent.fonction.typeCompte.roleBase, dc_imput) }}
                      {{macro.cadretechnique(app.user.agent.fonction.typeCompte.roleBase, conseiller_imput,charge_etudes,assistant) }}
                      {{macro.serviceratache(app.user.agent.fonction.typeCompte.roleBase, scerattache_imput) }}
                    {% endif %}
                    </div>

                    <div class="col-md-6">
                        <div class="form-group bien">
