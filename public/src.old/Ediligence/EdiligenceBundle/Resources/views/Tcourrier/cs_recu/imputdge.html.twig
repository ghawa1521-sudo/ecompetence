{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('ediligence/assets/css/bootstrap-select.min.css')}}">
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>

    <script>
        function libDest(val, val_id)
        {
            //vall=parseInt(val);
             //console.log(val);
             //console.log(val_id);
             //alert(val+val_id);
            var position = val_id.indexOf("Z1");
            if (parseInt(position) != -1)
            {
                val_id = val_id.replace('1', '');
            }
            valeur = val_id + val;
           // console.log(valeur);
           // console.log(val_id);
            switch (valeur)
            {
        {% set p=1 %}
        {% for linedg in dg_imput %}
                    case 'A{{linedg.codeDc}}':
                        return "{{linedg.sigle}}";
                        break;
        {% endfor %}

        {% for linedc in dc_imput %}
                    case 'B{{linedc.codeDc}}':
                        return "{{linedc.sigle}}";
                        break;
        {% endfor %}

        {% for linert in scerattache_imput %}
                    case 'D{{linert.codeDc}}':
                        return "{{linert.sigle}}"; break;
        {% endfor %}
        {% for linert in conseiller_imput %}
                    case 'Z{{linert.matricule}}':
                        return "{{linert.nom}} {{linert.prenoms}} {{linert.nomJeuneFille}}"; break;
        {% endfor %}
            
        {% for lineas in assistant %}
                    case 'Z{{lineas.matricule}}':
                        return "{{lineas.nom}} {{lineas.prenoms}} {{lineas.nomJeuneFille}}"; break;
        {% endfor %}  
            
        {% for lineet in charge_etudes %}
                    case 'Z{{lineet.matricule}}':
                        return "{{lineet.nom}} {{lineet.prenoms}} {{lineet.nomJeuneFille}}"; break;
        {% endfor %}   

                    default:
                        return "Non&nbsp;Défini";
                }
            }
    </script>
{% endblock %}


{% block body %} 
    <div class="content-header">
        <div class="header-section">
            <h1>
                <i class="gi gi-notes_2"></i>Transmettre courrier<br><small>Veuillez remplir les champs ci-dessous</small>
            </h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Transmettre</li>
        <li><a href="">Nouveau</a></li>
    </ul>
    <div class="row">
        <div class="col-md-offset-1 col-md-10">

            <form method="post" class="form-vertical col-md-12" style="color:#006;" name="frm_imputer" enctype="multipart/form-data" id="form_Imputation">
