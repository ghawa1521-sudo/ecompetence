{% extends '::ediligence/base.html.twig' %}

{% block body %}
 
     <div class="content-header">
        <div class="header-section">
            <h1><i class="gi gi-envelope"></i> Dossier<br><small>Mes archives</small></h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Actions</li>
        <li><a href="">Mes Archives</a></li>
    </ul>
    <div class="block full">
        <div class="block-title">
            <h2><strong>Liste</strong> dossiers archivés</h2>
        </div>{#
        <p><a href="https://dge.ci" target="_blank">DataTables</a> is a plug-in for the Jquery Javascript library. It is a highly flexible tool, based upon the foundations of progressive enhancement, which will add advanced interaction controls to any HTML table. It is integrated with template's design and it offers many features such as on-the-fly filtering and variable length pagination.</p>
#}

        <div class="table-responsive">
            <table id="example-datatable" class="table table-vcenter table-condensed table-bordered">
                <thead>
                    <tr>
                        <th>Num</th>
                        <th>Ref</th>
                        <th>Date Imputation</th>
                        <th>Objet</th>
                        <th>Date Traitement</th>
                        <th>Directions Concernées</th>
                        <th>Cordinateur</th>
                        <th>Télécharger</th>
                    </tr>
                </thead>
                <tbody>
                    {% set i = 0 %}{% set service = '' %}
                    {% for entity in archive %} 
                        {% for directions in direction %} 
                          {% if entity.idImput==directions[0].imputation.id %}
                          {% set service =  directions.service ~ ' - ' %}
                          {% endif%}  
                        {% endfor %} 
                        
                        {% set i = i + 1 %}
                        <tr>
                         <td>{{i}}</td>
                         <td>{{entity.reforigine}}</td>
                         <td>{{entity.dateImput|date('d-m-Y') }}</td>
                         <td>{{entity.objet|raw|striptags|slice(0, 50) }}</td>
                         <td>{{entity.datetraitement|date('d-m-Y') }}</td>
                         <td>{{ service|trim(' - ', 'right') }}</td>
                         <td>{{entity.service}}</td>
                         <td><a class="red" href="{#{vich_uploader_asset(entity[0].nomFichier, 'imageFile')}#}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger"><i class="ace-icon fa fa-download bigger-130"></i></a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <ul>
            <li>
                <a href="{{ path('courrier_new') }}">Transmettre diligence</a>
            </li>
        </ul>
    </div>
    {% endblock %}
