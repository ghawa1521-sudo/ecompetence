                <div class="block-title">

                    <h2><strong>Nouveau Courrier</strong></h2>
                </div>
                <!-- END Form Elements Title -->
                {{ form_start(form) }}
                
                {{ form_end(form) }}
                {#
                {{ form_row(form.typecourrier) }}
                
