{% block body %}
   
{% if (recover_enr is defined) and (recover_enr > 0) %}{% set recover_enr = '(Dernier numéro: '~recover_enr~')' %}{% else %}{% set recover_enr = '(Dernier numéro: aucun)' %}{% endif %}
    
  <div class="content-header">
        <div class="header-section">
            <h1>
                <i class="gi gi-notes_2"></i>Transmettre courrier<br><small>Veuillez remplir les champs ci-dessous</small>
            </h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Transmettre</li>
        <li><a href="">Nouveau</a></li>
    </ul>
