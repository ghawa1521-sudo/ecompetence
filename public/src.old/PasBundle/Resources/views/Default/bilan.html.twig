    <div class="table-responsive">
        <table id="dtable" class="table table-vcenter table-condensed table-bordered">
            <thead>
                <tr>
                    <th>Num</th>
                    <th>libellé</th>
                    <th>Année</th>
                    <th>Note Obtenue</th>
                    <th>Rang Obtenu</th>
                </tr>
            </thead>
            <tbody>
                {% set rang = 0 %}
                {% for entity in entities %}
                    {% set rang = rang +1 %}
                    <tr>
                        <td><a href="#">{{ entity[0].id }}</a></td>
                        <td>PAS {{ entity[0].direction.sigle }}</td>
                        <td>{{entity[0].exercice.annee}}</td>

                        </td>
                        <td class="text-center">
                            {{entity.note}}/{{entity.surnote}}
                        </td>
                        <td class="text-center">
                           <b> {{rang}} <sup>{% if rang == 1%}er{% else %} ieme {% endif %}</sup></b>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
