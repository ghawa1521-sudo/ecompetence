{% extends 'base.html.twig' %}
{% block stylesheets %}
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css">
{% endblock %}
{% block body %}
    <h1>Audit</h1>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-3">
                    <h3 class="panel-title"><i class="fa fa-archive"></i> Audit</h3>
                </div>
                <div class="col-md-3">
                    {{ filter_search(logs, "history", "Rechercher par clé primaire..") }}
                </div>
                <div class="col-md-3">
                    {{ filter_dropdown(logs, "blamed", users) }}
                </div>
                <div class="col-md-3">
                    {{ filter_dropdown(logs, "class", sourceClasses) }}
                </div>
            </div>
        </div>

        <table class="table">
            <tbody>
                {% for log in logs %}
                    {{ audit(log) }}
                {% endfor %}
            </tbody>
        </table>

        <div class="panel-footer">
            {{ pagination(logs) }}
        </div>
    </div>
{% endblock %}
