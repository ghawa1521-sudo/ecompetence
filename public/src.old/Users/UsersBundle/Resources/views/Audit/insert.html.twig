<tr>
    <td class="col-min">
        <span class="label label-success"><i class="fa fa-plus"></i></span>
    </td>
    <td>
        Nouveau <strong>{{ log.source.typLabel }}</strong> {{ audit_assoc(log.source) }} a été inséré,
        {{ audit_blame(log.blame) }}
    </td>
    <td class="col-min">{{ (log.loggedAt)|time_diff}}</td>
    <td class="col-min">
        <a class="btn btn-xs btn-link" href="{{ path('tracking_diff', {id: log.id}) }}">
            <i class="fa fa-search" title="Show diff"></i>
        </a>
    </td>
</tr>
