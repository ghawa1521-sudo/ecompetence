    {% extends '::base.html.twig' %}
    {% block datatableCss %}
        {% include "::sections_app/datatableCss.html.twig" %}
    {% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
    {% block title %}
    Modifier Affectation
    {% endblock %}
    {% block titre_page %}
        <div>Modifier une Affectation</div>
    {% endblock %}
    {% block body -%}

        <br>


        <table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
            <thead>

                <tr>

                    <td><b>Matricule</b></td>
                    <td><b>Nom et Prénom(s)</b></td>

                    <td><b>Direction</b></td>

                    <td><b>Etat affectation</b></td>
                    <td><b>Acte Administratif</b></td>
                    <td><b>Actions</b></td>
                </tr>
            </thead>
            <tbody>
            {% for entity in attente %}
            {% if entity.matricule is defined and entity.signeNote == 0 %}
                <tr>
                    {#<td><a href="{{ path('affecter_edit', { 'id': entity.id }) }}">{{ entity.id }}</a></td>#}

                    <td>{{ entity.matricule }}</td>
                    <td>{{entity.nom_celibataire}} {{entity.nom_marie}} 
                        {#{% if entity.sexe.id == 1 %}
                            Monsieur <span class="gras"></span>
                        {% elseif entity.sexe.id == 2 %}
                            {% if  entity.situationMatri.id == 1  %}Mademoiselle <span class="gras">{{entity.nom}} {{entity.prenoms}}</span> {% endif %}
                            {% if  entity.situationMatri.id == 2  %}Madame <span class="gras">{{entity.nom}}</span> née <span class="gras">{{entity.nomJeuneFille}}</span>{% endif %}
                        {% endif %}#}
                    </td>

                    <td>{{ entity.direction }}</td>

                    <td>
                        {% if entity.affecter_etat==0 %}En Attente d'Affectation
                                <label class="label label-info"></label>
                            {% elseif entity.affecter_etat==1 %}Affecté(e) dans un Service
                                <label class="label label-success"></label>
                                {% elseif entity.affecter_etat==2 %}Prise de Service Validée
                                    <label class="label label-success"> </label>
                        {% endif %}
                    </td>
                    <td>
                  {% if entity.affecter_etat==1 and entity.signeNote==0 %}Note d'Affectation / non encore Signé <label class="label label-warning"></label> {% endif %}
                  {% if entity.affecter_etat==1 and entity.signeNote==1 %}Note d'Affectation /  Signé <label class="label label-success"></label> {% endif %}
                  {% if entity.affecter_etat==2 and entity.signeCertificat==0 %}Certificat de Prise de Service / non encore Signé <label class="label label-warning"></label> {% endif %}
                  {% if entity.affecter_etat==2 and entity.signeCertificat==1 %}Certificat de Prise de Service / Signé <label class="label label-success"></label> {% endif %}
                  </td>
                    <td>

                          {% if  is_granted('ROLE_RESPO_SRHMG') or deleguation == 0%}
                          {% if (entity.affecter_etat==1) %}

                              <a width="100%" class="btn btn-success" href="{{ path('affecter_direction', { 'id': entity.id }) }}">modifier l'affectation</a>


                        {% endif %}
                        {% endif %}

                    </td>
                </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>


        {% endblock %}
