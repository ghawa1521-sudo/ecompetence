{% block javascript %}
<script type="text/javascript" src="{{ asset('design/js/wizard/jquery.smartWizard.js') }}"></script>
<script src="{{ asset('design/js/nicescroll/jquery.nicescroll.min.js') }}"></script>

 <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>
 <script type="text/javascript">
        $(document).ready(function () {
            // Smart Wizard
            $('#wizard').smartWizard();

            function onFinishCallback() {
                $('#wizard').smartWizard('showMessage', 'Finish Clicked');
                //alert('Finish Clicked');
            }
        });

        $(document).ready(function () {
            // Smart Wizard
            $('#wizard_verticle').smartWizard({
                transitionEffect: 'slide'
            });

        });
    </script>
  
    <script type="text/javascript">
    var tab=[];
    var tabs=[];
    {%for emp in emploi %}
      tab[{{emp.id}}]="{{emp.grade.libGrade}}";
      tabs[{{emp.id}}]="{{emp.grade.id}}";
    {% endfor %}
    function giveGrade(){
      id=$('#employ').val();
      $('#grade').val(tab[id]);
      $('#hiddengrade').val(tabs[id]);
    
    }

    function giveClasse($sourceval, $route, $destval, $div){
   // alert($route);
      $($destval).prop('disabled', false);
       $source = $($sourceval).val();
        if ($source.length > 0 ){

        $source=$source;
        //showloader('#cacher');
    }else{
            $source=0;
        }
    
    $paramroute = {'id': $source};

   //alert($source);
     $.ajax({
       type: 'GET',
       url: Routing.generate($route, $paramroute),
       dataType: 'json',
       success: function(data) {
        if (jQuery.isEmptyObject(data) == false){
              // alert("ok");
              $($destval).children('option:not(:first)').remove();
              $.each(data, function(key, value) {
              if ($($destval).is("input")){
              $($destval).val(value[0]);
          } else if ($($destval).is("select")){
               
                 $($destval).append('<option value= "' + key + '">' + value[0] + '</option>');
             }
           });
   }
}});
    }

    </script>
    <script>
        $(document).ready(function () {
            $('#agent_agentbundle_affecter_agent_nomJeuneFille').prop('disabled', true);
        });
    </script>
