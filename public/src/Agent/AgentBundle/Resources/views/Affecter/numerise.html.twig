{% extends '::base.html.twig' %}

{% block body -%}
<div class="col-md-push-3 col-md-8">

{% if is_granted('ROLE_RESPO') and entity.etatAffectation == 1 and entity.signeNote == 1 %}
<h3>Valider la prise de service</h3>

{% elseif ((is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1) or (deleguation == 0 and entity.etatAffectation == 1)) %}
<h3>Joindre la Note d'Affectation signée</h3>

{% elseif ((is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2) or (deleguation == 0 and entity.etatAffectation == 2)) %}
<h3>Joindre le Certificat de Prise de Service</h3>
{% endif %}

</div>
    <div class="col-md-6 col-md-push-3">
        {{ form_start(form) }}
        {{ form_errors(form) }}
    <table class="record_properties table table-striped">
        <tbody>

            <tr>
                <td><b>Matricule</b></td>
                <td>{{ entity.agent.matricule }}</td>
            </tr>
            <tr>
                <td><b>Nom</b></td>
                <td>{{ entity.agent.nom }} {#{{dump(entity.dateMiseService)}}#}</td>
            </tr>
            {% if (entity.agent.nomJeuneFille) %}
            <tr>
                <td><b>Nom de Jeune Fille</b></td>
                <td>{{ entity.agent.nomJeuneFille }}</td>
            </tr>
            {% else %}
           
                
            <tr>
                <td><b>Prénoms</b></td>
                <td>{{ entity.agent.prenoms }}</td>
            </tr>
            {% endif %}
            {#
            {% if (entity.dateNote)%}
            <tr>
                <td><b>Date de Signature de la Note d'Affectation </b></td>
                <td>{% if (entity.dateNote) %}{{ entity.dateNote|date('d-m-Y') }} {% endif %}</td>
            </tr>
            {% endif %}#}
            <tr>
                <td><b>Emploi</b></td>
                <td>{{ entity.agent.emploi }}</td>
            </tr>
{#
            <tr>
                <td><b>Description des Compétences</b></td>
                <td>{{ entity.agent.DescriComp }}</td>
            </tr>

#}          
            {% if (entity.signeNote == 1)%}
            <tr>
                <td><b>Date de Signature de la Note d'Affectation </b></td>
                <td>{% if (entity.dateNote) %}{{ entity.dateNote|date('d-m-Y') }} {% endif %}</td>
            </tr>
            {#
            <tr>
                <td><b>Note d'affectation {% if (entity.numNote) %} Numero: {{entity.numNote}} {% endif %}</b></td>
                <td>{% if (docu) %} <button class="btn btn-primary btnShow" value="{{ vich_uploader_asset(docu, 'docFile')}}">VISUALISER</button> {% endif %}</td>
            </tr>#}
            {% endif %}
            {% if (entity.agent.datePriseServiceDge)%}
            <tr>
                <td><b>Date de prise de Service </b></td>
                <td>{{ entity.agent.datePriseServiceDge|date('d-m-Y') }}</td>
            </tr>
            {% endif %}
            {% if is_granted('ROLE_RESPO') and entity.etatAffectation == 1 and entity.signeNote == 1 %}
                <tr>
                <td><b>
                Validation de la prise de service
                </b>
            </td>

            <td>
                 {{form_row(form.dateprise , {'label_attr': {'class': 'date Validation PS'}}) }}
            </td>
            <tr>
            <td colspan="2"><input type='submit' value='VALIDER' class='col-md-6 col-md-push-4 btn btn-success'/> </td>
            </tr>
        </tr>
        {% else %}
            {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation != 0)
                or  (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation != 0)
                or (deleguation == 0 and entity.etatAffectation != 0) %}
            <tr>
                <td>
                    <b>{% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
                            or  (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1)
                            or (deleguation == 0 and entity.etatAffectation == 1) %}
                    Numero de la note d'Affectation
                    {% endif %}
                    {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
                            or  (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2) 
                            or (deleguation == 0 and entity.etatAffectation == 2) %}
                        Numero du Certificat de Prise de Service
                    {% endif %}
                    </b>
                </td>
                <td>

                    <b>{% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
                            or  (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
                            or (deleguation == 0 and entity.etatAffectation == 1)%}
                    {{form_row(form.numNote , {'label_attr': {'class': 'numero Note'}}) }}
                            
                    {% endif %}
                    {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
                            or  (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2) 
                            or (deleguation == 0 and entity.etatAffectation == 2) %}
                        {{form_row(form.numCertificat , {'label_attr': {'class': 'numero Certificat'}}) }}
                    {% endif %}
                    </b>
                    {#<input type="texte" id="numP" name="numP" class='form-control' required='required'/>#}

                </td>
            </tr>
            {% endif %}
            <tr>
                <td><b>

                {% if is_granted('ROLE_RESPO') and entity.etatAffectation == 1 and entity.signeNote == 1 %}
                Validation de la prise de service
                {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
                or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
                or (deleguation == 0 and entity.etatAffectation == 1) %}
                Date de Signature de la note d'Affectation
                </b>
                
                {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
                or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2) 
                or (deleguation == 0 and entity.etatAffectation == 2) %}
                Date de Signature du Certificat de Prise de Service

                {% endif %}
                </td>
                <td>{#<input type="datetime" id="dateP" name="dateP" class='form-control datetimepicker' required='required'/>#}
                    <b>
                {% if is_granted('ROLE_RESPO') and entity.etatAffectation == 1 and entity.signeNote == 1 %}
                {{form_row(form.dateprise , {'label_attr': {'class': 'date Validation PS'}}) }}
                {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
                or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
                or (deleguation == 0 and entity.etatAffectation == 1)%}
                {{form_row(form.dateNote , {'label_attr': {'class': ''}}) }} 
                </b>
               
                {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
                or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2) 
                or (deleguation == 0 and entity.etatAffectation == 2)%}
                {{form_row(form.dateCertificat , {'label_attr': {'class': 'date Certificat'}}) }} 
      
                {% endif %}
                </td>
            </tr>
            <tr>
              <td valign="bottom"><b>
              {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
              or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
              or (deleguation == 0 and entity.etatAffectation == 1)%}
                Joindre le Note d'affectation numérisée 
              
              {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
              or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2) 
              or (deleguation == 0 and entity.etatAffectation == 2)%}
              Joindre le Certificat de prise de Service
              {% endif %}
            </b></td>
            <td>
                 {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
              or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
              or (deleguation == 0 and entity.etatAffectation == 1)%}
                 {{form_row(form.documentNote.docFile , {'label_attr': {'class': ''}} ) }}
             
              
              {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
              or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2)
              or (deleguation == 0 and entity.etatAffectation == 2) %}
              {{form_row(form.documentCertif.docFile , {'label_attr': {'class': ''}} ) }}
              {% endif %}
            </td>
            </tr>
            <tr><td colspan='2'>
                {% if (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 1)
          or
          (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 1) 
          or (deleguation == 0 and entity.etatAffectation == 1)%}
          <input type='submit' value='JOINDRE LA NOTE' class='col-md-6 col-md-push-4 btn btn-success'/>
          {% elseif (is_granted('ROLE_RESPO_SRHMG') and entity.etatAffectation == 2)
          or (entity.imputer is defined and entity.imputer == app.user.agent and entity.etatAffectation == 2)
          or (deleguation == 0 and entity.etatAffectation == 2) %}
          <input type='submit' value='JOINDRE LE CERTIFICAT' class='col-md-6 col-md-push-4 btn btn-success'/>
          {% endif %}
            </td>
        </tr>
            {% endif %}
                    {{ form_row(form._token) }}
                
          
          
            
        </tbody>
    </table>

        </form>
    </div>
{% endblock %}
{% block javascript %}
<script src="{{ asset('design/js/style.js') }}"></script>

{% endblock %}
{#data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette Affectation ?"#}
