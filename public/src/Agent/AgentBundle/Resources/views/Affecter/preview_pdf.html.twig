{% extends '::base.html.twig' %}

{% block body %}
 <div align="center"><a class="btn btn-primary" href="#" target="blank" onClick="printElem('toprint');">
                <span class="fa fa-print">Imprimer</span> <a class="btn btn-warning" href="{{app.request.headers.get('referer')}}"><span class="fa fa-arrow-circle-o-left"></span>  RETOUR </a>
            </a>
        </div>
    <div id="toprint" style="width:210mm !important; height:297mm !important; color:black !important;">

<div class="col-md-push-2 col-md-10" style="width:210mm !important; height:297mm !important; color:black !important; margin:auto; overflow:hidden;">
  
    {% if  entity.signeNote == 0 %}
            {% include 'AgentBundle::Affecter/note_affectation_pdf.html.twig'%}
        {% else %}
            {% include 'AgentBundle::Affecter/certificat_prise_pdf.html.twig'%}
        {% endif %}   
        </div>
    </div>
    
    <script>
        function printElem(divId) {     
            var nomPdf='ok';
            var content = document.getElementById(divId).innerHTML;
            var mywindow = window.open();
          
            mywindow.document.write(content);
          

            mywindow.document.close();
            mywindow.focus()
            mywindow.print();
            mywindow.close();
            return true;    
        }
            
           
    </script>
{% endblock %}
   


