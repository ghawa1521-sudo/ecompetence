{% extends '::base.html.twig' %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}

{% block titre_page %}
    <div>Liste des Agents (<span style="color: red;">{{entities|length}}</span>)</div>
{% endblock %}
{% block body -%}
    <div>
            {#<a href="{{ path('agent_new') }}" class="btn btn-info">
                Enregistrer un nouvel Agent
            </a>#}
            <div id="dialog" style="display: none">
            </div>
    <table class="records_list table table-striped responsive-utilities jambo_table bulk_action">
        <thead>
            <tr>
                <th>Matricule</th>
                <th>Nom</th>
                <th>Pr&eacute;noms</th>
                <th>Date de Naissance</th>

              
               {# <th>Situation matrimoniale</th>#}

                {#<th>Indice</th>
                <th>Date premiere prise de service</th>#}
                <td>Emploi</td>
                <td>Grade</td>
                <th>Date prise Service DGE</th>

                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('agent_show', { 'id': entity.id}) }}">{{ entity.matricule }}</a></td>
                <td> {% if entity.situationMatri == 'Marie' %}
                            {{ entity.nom }} {{ 'nee' }} {{ entity.nomJeuneFille }}
                        {% else %}
                            {{ entity.nom }}
                    {% endif %}
                </td>
                <td>{{ entity.prenoms }}</td>

                <td>{% if entity.dateNaiss %}{{ entity.dateNaiss|date('d/m/Y') }}{% endif %}</td>
                


               {#} <td>{{ entity.situationMatri }} <br> {{ entity.nbEnf }} enfant(s)</td>

                <td>{{ entity.indice }}</td>
                <td>{% if entity.datePremierService %}{{ entity.datePremierService|date('d-m-Y') }}{% endif %}</td>#}
                <td>{{entity.Emploi}}</td>
                <td>{{entity.Emploi.Grade}}</td>
                <td>{% if entity.datePriseServiceDge %}{{ entity.datePriseServiceDge|date('d-m-Y') }}{% endif %}</td>

                <td>


                        <a class="label label-success" href="{{ vich_uploader_asset(entity, 'cvFile')}}">Visualiser le CV</a>


                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js" type="text/javascript"></script>
<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/blitzer/jquery-ui.css" rel="stylesheet" type="text/css" />
<script type="text/javascript">
    $(function () {
        var fileName = "Mudassar_Khan.pdf";
        $("#btnShow").click(function () {
            $("#dialog").dialog({
                modal: true,
                title: fileName,
                width: 540,
                height: 450,
                buttons: {
                    Close: function () {
                        $(this).dialog('close');
                    }
                },
                open: function () {
                    var object = "<object data=\"{FileName}\" type=\"application/pdf\" width=\"500px\" height=\"300px\">";
                    object += "If you are unable to view file, you can download from <a href = \"{FileName}\">here</a>";
                    object += " or download <a target = \"_blank\" href = \"http://get.adobe.com/reader/\">Adobe PDF Reader</a> to view the file.";
                    object += "</object>";
                    object = object.replace(/{FileName}/g, "Files/" + fileName);
                    $("#dialog").html(object);
                }
            });
        });
    });
</script>
<input id="btnShow" type="button" value="Show PDF" />


    {% endblock %}
