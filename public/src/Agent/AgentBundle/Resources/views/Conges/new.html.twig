{% extends '::base.html.twig' %}
{% block title %}
    Faire une proposition de congés
{% endblock %}
{% block javascript %}
    <script>

        var $tp = $('.tp');
        var $periodes = $('.periodes');
        var $exercice = $('.exercice');

        $('#agent_agentbundle_conges_nbrejours').chained('#agent_agentbundle_conges_typeConges');


        function tpChange() {
            if ($tp.val() == 1) {
                $periodes.show();
                $exercice.show();
                $exercice.prop('disabled', false);
                $exercice.prop('required', true);
                $periodes.prop('required', true);

            } else if ($tp.val() == 6) {

                $periodes.show();
                $exercice.hide();
                $exercice.prop('disabled', true);
                $exercice.prop('required', false);


            } else {
                $periodes.hide();
                $exercice.hide();
                $exercice.prop('disabled', true);
                $exercice.prop('required', false);
            }
        }
        $('document').ready(function () {
            tpChange();
        });


        $tp.bind('change', function () {
            tpChange();
        });
    </script>
{% endblock %}


{% block body -%}
    <div class="row">
        <div>
            {#
                        <span class="section">
            
                        </span>
                        #}
            <div class="x_title">
                <h2>Faire une proposition de congés<small></small>
                </h2>
                <div class="clearfix"></div>
            </div>
            {#{dump(form.vars)}#}
            <div class="col-md-push-3 col-md-6">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{form_row(form.typeConges)}}
                <div class="exercice" style="display: none">
                    {{form_row(form.exercice)}}
                </div>
                {{form_row(form.externe)}}
                {{form_row(form.datedebut)}}
                {#{{form_row(form.objetFile)}}#}

                {#{form_row(form.datefin)}#}
                {#
                
                                #}
                    {% if (form.nbrejours is defined) %}

                        <div class="periodes"> {{form_row(form.nbrejours)}}
                    </div>
                {% endif %}
                {{ form_label(form.objetFile, ' ') }}
                {{ form_errors(form.objetFile) }}
                {{ form_widget(form.objetFile) }}<input class="btn btn-success" type="submit" value="Enregistrer"/>
            </div>

            {{ form_widget(form._token) }}
            {{ form_end(form, {'render_rest': false}) }}

        </div>
    </div>
    <ul class="record_actions">

        <li>
            <a href="{{ path('conges_active') }}">
                Retour à la liste
            </a>
        </li>
    </ul>
{% endblock %}

