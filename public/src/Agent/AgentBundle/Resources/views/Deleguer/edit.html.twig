    {{form_end(form)}}

    <ul class="record_actions">
        <li>
            <a href="{{ path('deleguer') }}">
                Retour à la liste
            </a>
        </li>
    </ul>
{% endblock %}

{% block javascript %}

    <script src="{{ asset('design/js/style.js') }}"></script>
    <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>
    <script>

        var $collectionHolder;

// setup an "add a tag" link
        var $addDeleguButton = $('<button class="btn btn-info add_tag_link" type="button"> <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> <small><em>Ajouter une Déléguation</small></em></button></div>');
        var $newLinkLi = $('<div></div>').append($addDeleguButton);

        jQuery(document).ready(function () {
            // Get the ul that holds the collection of deleguJs
            $collectionHolder = $('tbody.deleguJs');
            $collectionHolder.css("list-style-type", "none");
            // add the "add a tag" anchor and li to the deleguJs ul
            $collectionHolder.append($newLinkLi);

            // add a delete link to all of the existing tag form li elements
            $collectionHolder.find('tr').each(function () {
                addDeleguFormDeleteLink($(this));
            });

            // count the current form inputs we have (e.g. 2), use that as the new
            // index when inserting a new item (e.g. 2)
            $collectionHolder.data('index', $collectionHolder.find(':input').length);

            $addDeleguButton.on('click', function (e) {
                // add a new tag form (see next code block)
                addDeleguForm($collectionHolder, $newLinkLi);
            });
        });

/////////////////////
        function addDeleguForm($collectionHolder, $newLinkLi) {
            // Get the data-prototype explained earlier
            var prototype = $collectionHolder.data('prototype');

            // get the new index
            var index = $collectionHolder.data('index');

            var newForm = prototype;
            // You need this only if you didn't set 'label' => false in your deleguJs field in TaskType
            // Replace '__name__label__' in the prototype's HTML to
            // instead be a number based on how many items we have
            // newForm = newForm.replace(/__name__label__/g, index);

            // Replace '__name__' in the prototype's HTML to
            // instead be a number based on how many items we have
            newForm = newForm.replace(/__name__/g, index);

            // increase the index with one for the next item
            $collectionHolder.data('index', index + 1);

            // Display the form in the page in an li, before the "Add a tag" link li
            var $newFormLi = $('<tr></tr>').append(newForm);
            $newLinkLi.before($newFormLi);

            addDeleguFormDeleteLink($newFormLi);
        }

        function addDeleguFormDeleteLink($tagFormLi) {
            var $removeFormButton = $("<td style='text-align: center;margin-left: auto;margin-right: auto;'><button class='btn btn-danger' type='button'> <span class='glyphicon glyphicon-trash' aria-hidden='true'></span> <small><em></small></em></button></div></td>");
            $tagFormLi.append($removeFormButton);

            $removeFormButton.on('click', function (e) {
                // remove the li for the tag form
                $tagFormLi.remove();
            });
        }


    </script>
{% endblock %}
