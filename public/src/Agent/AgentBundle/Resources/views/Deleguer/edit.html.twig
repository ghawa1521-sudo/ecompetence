                    <td>{{form_widget(delegu.agent)}}</td>
                    <td>{{form_widget(delegu.services)}}</td>
                </tr>
            {% endfor %}

        {% endfor %}#}



        <tbody class="deleguJs" data-prototype="
               {# {{'<td>'|e}}{{ form_widget(form.deleguation.vars.prototype.children.fonctionalite)|e('html_attr') }}{{'</td>'|e}}#}
               {{'<td>'|e}}{{ form_widget(form.deleguation.vars.prototype.children.rubriques)|e('html_attr') }}{{'</td>'|e}}
               {{'<td>'|e}}{{ form_widget(form.deleguation.vars.prototype.children.responsable)|e('html_attr') }}{{'</td>'|e}}
               {{'<td>'|e}}{{ form_widget(form.deleguation.vars.prototype.children.agent)|e('html_attr') }}{{'</td>'|e}}
               {{'<td>'|e}}{{ form_widget(form.deleguation.vars.prototype.children.services)|e('html_attr') }}{{'</td>'|e}}">
            {% for deleguation in form.children %}
                {% for  delegu in deleguation %}
                    <tr>
                        <td><div style="display: none;">
                                {{form_widget(delegu.fonctionalite)}}</div>

                            {{form_widget(delegu.rubriques)}}</td>
                        <td>{{form_widget(delegu.responsable)}}</td>
                        <td  width="22%">{{form_widget(delegu.agent)}}</td>
