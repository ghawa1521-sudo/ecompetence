{% extends '::base.html.twig' %}

{% block css %}
    <link href="{{ asset('design/css/style.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{asset('ediligence/assets/css/bootstrap-select.min.css')}}">
{% endblock %}



{% block titre_page %}   

{% endblock %}

{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
    <style>
        th{
            text-align: left !important;
        }
        .dataTables_filter{
            width: auto !important;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}

{% block body -%}
    <div class="row">
        <div class="">
            {% if app.request.hasPreviousSession %}
                {% for type, messages in app.session.flashbag.all() %}
                    <div class="alert alert-{{ type }}">
                        <ul>
                            {% for message in messages %}
                                <li>
                                    {{ message }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
    <div class="row">
        {{ form_start(form,{'attr':{'id':'form_chk'}}) }}
        <div class="col-md-4">
            {{ form_errors(form) }}
            <div>
                {{ form_widget(form.interimaire, {'id':'interimaire'}) }}
            </div>
            <div>            
                {{ form_row(form.datedebut, {'attr':{'required':'required'}}) }}
            </div>
            
            <div>
                {{ form_row(form.datefin, {'attr':{'required':'required'}}) }}
            </div>
            <div>
            
               {% if app.user.agent.fonction is defined and  app.user.agent.fonction.id == 10 %}

                    {{ form_row(form.coordonnateur, {'attr':{'required':false}}) }}
                {% else %}
                    
                {{ form_row(form.coordonnateur, {'attr':{'required':'required'}}) }}
                {% endif %}
            </div>
            <br><br>
            <div>
                {{ form_widget(form.submit) }}
            </div>
        </div>
        <div class="col-md-8 table-responsive"> 
            <table class="records_chk table table-striped responsive-utilities jambo_table table-responsive" id="datatable" >
                <thead>

                    <tr class="headings">
                        <th>
                        </th>
                        <th>Matricule intérimaire</th>
                        <th>Intérimaire</th>
                        <th>Coordonateur technique</th>
                        <th>Période</th>
                        
                        <th>Etat</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tabs in tab %}
                        <tr>
                            <td></td>
                            <td>{{tabs.interimaire.matricule}}</td>
                            <td>{{tabs.interimaire.concatNom}}</td>
                            <td>{% if tabs.coordonnateur %}{{tabs.coordonnateur.concatNom}}{% endif %}</td>
                            <td>{{tabs.datedebut|date('d-m-Y')}} au {{tabs.datefin|date('d-m-Y')}}</td>
                            
                            <td>{{tabs.getcontrol()}}</td>
                            <td>
                                <a href="{{ path('mutation_interim', { 'id': tabs.id }) }}" class="btn btn-danger btn-sm col-md-12" data-confirm="Etes-vous <strong>certain</strong> de vouloir retirer cet intérim ?">Retirer</a>
                                <a href="{{ path('mutation_interim_edit', { 'id': tabs.id, 'modif':'edit' }) }}" class="btn btn-primary btn-sm col-md-12" >Modifier</a>
                                <a href="{{ path('mutation_interim_view', { 'id': tabs.id }) }}" class="btn btn-success btn-sm col-md-12" >Imprimer</a>
                            </td>
                                
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {#{ form_widget(form._token) }#}
        {{ form_end(form, {'render_rest': true}) }}
    </div>
{% endblock %}

{% block javascript %}

    <script src="{{ asset('design/js/style.js') }}"></script>
    <script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>
{% endblock %}