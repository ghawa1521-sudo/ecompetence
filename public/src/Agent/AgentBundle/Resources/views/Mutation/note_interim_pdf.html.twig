    {% block contenuPdf -%}

        <div style="background-color: white; color:black; line-height: 2em;">
            {% if entity.interime.Direction %}En l'absence de {{entity.interime.getCivilite.libsitf}} {{entity.interime.concatNom}},{% if entity.interime.Direction.etatDirection == 0 %} {{entity.interime.Direction|replace({'Service': 'Chef du Service'})}} {% else %} {{entity.interime.Direction|replace({'Direction': 'Directeur'})}}{% endif %} ({{entity.interime.Direction.Sigle}}), du {{entity.datedebut|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")}} au {{entity.datefin|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")}} inclus,
            l'intérim sera assuré par
            {{entity.interimaire.getCivilite.libsitf}} {{entity.interimaire.concatNom}},
            {% if entity.interimaire.Direction.etatDirection == 0 %} {{entity.interimaire.Direction|replace({'Service': 'Chef du Service'})}} {% else %}{{entity.interimaire.Direction|replace({'Direction': 'Directeur'})}}{% endif %} ({{entity.interimaire.Direction.Sigle}}).{% else %}
            En l'absence de {{entity.interime.getCivilite.libsitf}} {{entity.interime.concatNom}} {{entity.interime.Fonction}} de l'Economie (DGE) du {{entity.datedebut|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")}} au {{entity.datefin|localizeddate('none', 'none', app.request.locale, "Europe/Paris", "cccc d MMMM Y")}} inclus,
            l'intérim sera assuré par 
            {{entity.interimaire.getCivilite.libsitf}} {{entity.interimaire.concatNom}}, {{entity.interimaire.Fonction}} de l'Economie (DGE){% endif %}{% if entity.coordonnateur %} La Coordination Technique sera assurée par {{entity.coordonnateur.getCivilite.libsitf}} {{entity.coordonnateur.concatNom}}{% if(entity.coordonnateur.codeSd) %}{% if entity.interime.Direction.etatDirection == 0 %}, {{entity.coordonnateur.codeSd|replace({'Section': 'Chef de Section'})}}{% else %}, {{entity.coordonnateur.codeSd|replace({'Sous-Direction': 'Sous-Directeur'})}}{% endif %}{% endif %}{% endif %}.
            {#{% if entity.emmeteur.sexe.id == 1 %}
            |replace({'this': 'foo'})
                Monsieur {{entity.emmeteur.nom}} {{entity.emmeteur.prenoms}}
            {% elseif entity.emmeteur.sexe.id == 2 %}
                {% if  entity.emmeteur.situationMatri.id == 1  %}Mademoiselle {{entity.emmeteur.nom}} {{entity.emmeteur.prenoms}} {% endif %}
                {% if  entity.emmeteur.situationMatri.id == 2  %}Madame {{entity.emmeteur.nom}} née {{entity.emmeteur.nomJeuneFille}}{% endif %}

            {% endif %}{{entity.interime.getCivilite.libsitf}} {{entity.interime.concatNom}}, matricule {{entity.interime.matricule}}, {{entity.emmeteur.Emploi}}, est muté{% if entity.emmeteur.sexe.id == 2 %}e{% endif %}
            {% if  entity.destination.etatDirection == 0 %} au {% else %}à la {% endif %}{{entity.destination}} de la Direction Générale de l'Economie (DGE),
            à compter de la date de signature de la présente note.#}


            

        </div>

