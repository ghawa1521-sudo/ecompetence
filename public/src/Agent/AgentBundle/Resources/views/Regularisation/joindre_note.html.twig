
{% extends '::base.html.twig' %}

{% block css %}
<link href="{{ asset('design/css/style.css') }}" rel="stylesheet"/>
<link rel="stylesheet" href="{{asset('ediligence/assets/css/bootstrap-select.min.css')}}">

<style>
    input[type="checkbox"] {
        display: none;
    }

    label[for$="_delete"] {
        display: none;
    }
</style>
{% endblock %}

{% block titre_page %}
{% endblock %}

{% block body %}
<div class="row">

    {# FLASH MESSAGES #}
    {% if app.request.hasPreviousSession %}
        {% for type, messages in app.session.flashbag.all() %}
            <div class="alert alert-{{ type }}">
                <ul>
                    {% for message in messages %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    {% endif %}

</div>

<div class="row">
  {{ form_start(form,{'attr':{'id':'form_chk'}}) }}
    <h3>JOINDRE UNE NOTE DE DÉTACHEMENT</h3>

    {# ===== INFOS AGENT ===== #}
    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-heading">Informations détachement Agent</div>
            <div class="panel-body">

                <p><strong>Matricule :</strong> {{ agent.matricule }}</p>
                <p><strong>Nom :</strong> {{ agent.nom }}</p>
                <p><strong>Prénoms :</strong> {{ agent.prenoms }}</p>
                <p><strong>Numero de la note :</strong> {{ agent.detachement.numNote }}</p>
                <p><strong>Objet de la Note :</strong> {{ agent.detachement.objetnote }}</p>
                <p><strong>Date cessation :</strong> {{agent.detachement.dateDetachement|date('d/m/Y')}}</p>
              

            </div>
        </div>
    </div>

    {# ===== FORMULAIRE ===== #}
    <div class="col-md-8">

        {{ form_start(form, {'attr': {'id': 'form_chk'}}) }}

            {{ form_errors(form) }}

            <div>
                {{ form_label(form.pj.docFile, 'Preuve justificative') }}
                {{ form_widget(form.pj.docFile) }}
            </div>

            <br>

            <div>
                {{ form_widget(form.Enregistrer) }}
            </div>

        {{ form_widget(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}

    </div>

</div>
{% endblock %}

{% block javascript %}
<script src="{{ asset('design/js/style.js') }}"></script>
<script src="{{ asset('ediligence/assets/js/bootstrap-select.min.js') }}"></script>
{% endblock %}