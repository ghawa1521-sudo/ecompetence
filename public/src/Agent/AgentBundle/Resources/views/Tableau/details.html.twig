{% extends '::base.html.twig' %}
{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
    <style>
        .dataTables_filter{
            width: auto !important;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}

{% block body -%}
    {#
       <div class="col-md-6 col-sm-6 col-xs-12">
       <table class=" table table-striped responsive-utilities jambo_table bulk_action">
           <thead>
               <tr>
                   <th>N°</th>
                   <th>Type de Demande</th>
