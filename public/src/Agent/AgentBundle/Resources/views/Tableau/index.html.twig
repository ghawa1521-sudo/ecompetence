             <th>Femme</th>
        </tr>
         <tr>
             <th>{{stats.effectif[0].total}}</th>
             <th>{{stats.effectif[0].m}}</th>
             <th>{{stats.effectif[0].f}}</th>
             <th>{{stats.effectif[0].fonctionnairetotal}}</th>
             <th>{{stats.effectif[0].fonctionnairehomme}}</th>
             <th>{{stats.effectif[0].fonctionnairefemme}}</th>
             <th>{{stats.effectif[0].contractueltotal}}</th>
             <th>{{stats.effectif[0].contractuelhomme}}</th>
             <th>{{stats.effectif[0].contractuelfemme}}</th>
        
        </tr>
     </table>



 <table class="table table-striped responsive-utilities jambo_table ">
        <tr>
            <th>Emploi</th>
            <th>Total</th>
            <th>Homme</th>
            <th>Femme</th>
        </tr>
        {% for emploi in stats.emploi %}
