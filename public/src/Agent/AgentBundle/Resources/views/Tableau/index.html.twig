{% extends '::base.html.twig' %}
{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
     <style>
        .dataTables_filter{
            width: auto !important;
        }
       
        div > i{
            color:orange;{#1abc9c;#}
        }
        .details{
            color:red; font-weight: bold;
        }
    </style>
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}
{% block body -%}  
    <div class="row top_tiles">
              <a href="{{path('stat_details', { 'id': 3 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-users"></i></div>
                  <div class="count">{% if(stats.effectif[0]is defined) %}{{stats.effectif[0].total}}{%else%}0{% endif%}</div>
                  <h3>Effectif global</h3>
                  <p><i class="fa fa-male"></i>&nbsp;Homme: <span class="details">{% if(stats.effectif[0]is defined) %}{{stats.effectif[0].m}}{%else%}0{% endif%}</span> &nbsp;<i class="fa fa-female"></i>&nbsp;Femme: <span class="details">{% if(stats.effectif[0]is defined) %}{{stats.effectif[0].f}}{%else%}0{% endif%}</span></p>
                </div>
              </div>
              </a>
            <a href="{{path('stat_details', { 'id': 4 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                    <div class="icon"><i class="fa fa-briefcase"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3 >Stat. par emploi</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
            </a>
                  <a href="{{path('stat_details', { 'id': 2 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-cubes"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Stat. par Categorie</h3>
                  <p>A:<span class="details">{% if(stats.categorie[0].total is defined) %}{{stats.categorie[0].total}}{% else%} 0 {% endif%}</span> &nbsp; B:<span class="details">{% if(stats.categorie[1].total)is defined %}{{stats.categorie[1].total}}{% else%} 0{% endif%}</span> &nbsp; C:<span class="details">{% if(stats.categorie[2].total)is defined %}{{stats.categorie[2].total}}{% else%} 0{% endif%}</span> &nbsp; D:<span class="details">{% if(stats.categorie[3].total is defined) %}{{stats.categorie[3].total}}{% else%} 0{% endif%}</span></p>
                </div>
              </div>
                  </a>
              <a href="{{path('stat_details', { 'id': 1 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-mortar-board"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Stat. par grade</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
              </a>
               
              <a href="{{path('stat_details', { 'id': 5 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-sitemap"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Stat. par Direction</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
              </a>

              <a href="{{path('stat_details', { 'id': 8 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-newspaper-o"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Stat. par type d'acte</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
               </a>

              <a href="{{path('stat_details', { 'id': 7 })}}">
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-comments-o"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Stat. par syndicat</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
              </a>
             {# <a href="{{path('stat_details', { 'id': 3 })}}">#}
              <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="tile-stats">
                  <div class="icon"><i class="fa fa-line-chart"></i></div>
                  <div class="count">&nbsp;</div>
                  <h3>Courbes d'évolutions</h3>
                  <p>&nbsp;</p>
                </div>
              </div>
              {#</a>#}
            </div>
              
              
