<div class="col-xs-12">
    <div class="col-xs-3">
        <table class="table table-striped responsive-utilities jambo_table ">
         <thead>
            <tr>
                <th >Grade</th>
                <th >Détail</th>
            </tr>
        </thead>
            <tbody>
            {% for grade in stats.grade %}
            <tr>
                <th>{{grade.lib}}</th>
                <th>Total: {{grade.total}}<br>Homme: {{grade.m}}<br>Femme: {{grade.f}}</th>
            </tr>
            {% endfor %}
        </tbody>
     </table>
    </div>
     <table class="table table-striped responsive-utilities jambo_table ">
         <thead>
            <tr>
                <th>Grade</th>
                 {% for grade in stats.grade %}
            
                <th>{{grade.lib}}</th>
             
            {% endfor %}
            </tr>
        </thead>
            <tbody>
                <tr>
                 <th>Homme<br>Femme<br>Total</th>
            {% for grade in stats.grade %}
           
            
                <th>{{grade.m}}<br>{{grade.f}}<br>{{grade.total}}<br></th>
            
            {% endfor %}
        </tr>
        </tbody>
     </table>
     <table class="table table-striped responsive-utilities jambo_table ">
