    </div>

<div class="col-md-6 col-sm-6 col-xs-12">
                <div class="x_panel">
                  <div class="x_title">
                    <h2>Graphe d'Illustration</h2>
                    <div class="clearfix"></div>
                  </div>
                  <div class="x_content2">
                    <div id="graph_donut" style="width:100%; height:300px;"></div>
                  </div>
                </div>
              </div>
<br>
<div class="col-xs-12">

 <table class="table table-striped responsive-utilities jambo_table ">
        <thead>
            <tr>
                <th colspan="4">Personne en attente d’affectation depuis un mois </th>
            </tr>
            <tr>
                <th>&nbsp;</th>
                <th>Matricule</th>
                <th>Nom et Prénoms</th>
                <th>Date enregistrement</th>
            </tr>
        </thead>
        <tbody>
        {% if attente_affectation is defined and attente_affectation != null %}
            {% set i = 1 %}
            {% for affectation in attente_affectation %}
                <tr>
                    <td>{{i}}</td>
                    <td>{{affectation.agent.matricule}}</td>
                    <td>{{affectation.agent.nom}} {{affectation.agent.prenoms}} {{affectation.agent.nomJeuneFille}}</td>
                    <td>{{affectation.dateEnregAgt|date('d-m-Y')}}</td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        {% endif %}
        </tbody>
</table>
</div>
<br>
<div class="col-xs-12">
 
 <table class="table table-striped responsive-utilities jambo_table ">
        <thead>
            <tr>
                <th  colspan="4">Personnes affecter dans un service et n’ayant pas encore pris service </th>
            </tr>
             <tr>
                <th>&nbsp;</th>
                <th>Matricule</th>
                <th>Nom et Prénoms</th>
                <th>Date affectation</th>
            </tr>
        </thead>
         <tbody>
        {% if affectation_sansprise is defined and affectation_sansprise != null %}
            {% set i = 1 %}
            {% for affectation_sansprises in affectation_sansprise %}
                <tr>
                    <td>{{i}}</td>
                    <td>{{affectation_sansprises.agent.matricule}}</td>
                <td> 
                {{affectation_sansprises.agent.nom}} {{affectation_sansprises.agent.prenoms}} {{affectation_sansprises.agent.nomJeuneFille}}</td>
                    <td>{{affectation_sansprises.dateMiseService|date('d-m-Y H:i:s')}}</td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        {% endif %}
        </tbody>
</table>
</div>

<br> 
<div class="col-xs-12">
 
 <table class="table table-striped responsive-utilities jambo_table ">
        <thead>
            <tr>
                <th  colspan="4">Personnes affecter dans un service ayant pris service et en attente de signature du certificat </th>
            </tr>
             <tr>
                <th>&nbsp;</th>
                <th>Matricule</th>
                <th>Nom et Prénoms</th>
                <th>Date prise de service</th>
            </tr>
        </thead>
         <tbody>
        {% if certificat is defined and certificat != null %}
            {% set i = 1 %}
            {% for certificats in certificat %}
                <tr>
                    <td>{{i}}</td>
                    <td>{{certificats.agent.matricule}}</td>
                <td> 
                {{certificats.agent.nom}} {{certificats.agent.prenoms}} {{certificats.agent.nomJeuneFille}}</td>
                    <td>{{certificats.dateprise|date('d-m-Y H:i:s')}}</td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        {% endif %}
        </tbody>
</table>
</div>
<br>
<div class="col-xs-12">
 
 <table class="table table-striped responsive-utilities jambo_table ">
        <thead>
            <tr>
                <th  colspan="5">Liste des demandes d'actes en cours de traitement par la Grh</th>
            </tr>
             <tr>
                <th>&nbsp;</th>
                <th>Matricule</th>
                <th>Nom et Prénoms</th>
                <th>Date demande</th>
                <th>Type acte</th>
            </tr>
        </thead>
         <tbody>
        {% if demande is defined and demande != null %}
            {% set i = 1 %}
            {% for demandes in demande %}
                <tr>
                    <td>{{i}}</td>
                    <td>{{demandes.emmeteur.matricule}}</td>
                <td> 
                {{demandes.emmeteur.nom}} {{demandes.emmeteur.prenoms}} {{demandes.emmeteur.nomJeuneFille}}</td>
                    <td>{{demandes.datecreation|date('d-m-Y H:i:s')}}</td>
                    <td>{{demandes.typeDemande.libelle}}</td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        {% endif %}
        </tbody>
</table>
</div>

<br>
<div class="col-xs-12">
 
 <table class="table table-striped responsive-utilities jambo_table ">
        <thead>
            <tr>
                <th  colspan="5">Liste des demandes de mutation en cours de traitement par la Grh</th>
            </tr>
             <tr>
                <th>&nbsp;</th>
                <th>Matricule</th>
                <th>Nom et Prénoms</th>
                <th>Date demande</th>
            </tr>
        </thead>
         <tbody>
        {% if mutation is defined and mutation != null %}
            {% set i = 1 %}
            {% for mutations in mutation %}
                <tr>
                    <td>{{i}}</td>
                    <td>{{mutations.emmeteur.matricule}}</td>
                <td> 
                {{mutations.emmeteur.nom}} {{mutations.emmeteur.prenoms}} {{mutations.emmeteur.nomJeuneFille}}</td>
                    <td>{{mutations.datecreation|date('d-m-Y H:i:s')}}</td>
                </tr>
                {% set i = i + 1 %}
            {% endfor %}
        {% endif %}
        </tbody>
</table>
</div>#}
{% endblock %}
{% block javascript %}
<script type="text/javascript">


$("#graph_donut").length&&Morris.Donut({element:"graph_donut",
    data:[
            {% for entity in entities %}
            {label:"{{entity.libelle|raw}}",value:{{entity.compt}}},
            {% endfor %}],
    colors:["#26B99A","#34495E","#ACADAC"],
    formatter:function(a){return a},
    resize:!0})
</script>
{% endblock %}