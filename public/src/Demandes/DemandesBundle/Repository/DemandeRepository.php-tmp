class DemandeRepository extends \Doctrine\ORM\EntityRepository {
	public function getNbre($type, $matricule) {
		if ($type == 1) {
			return $this->createQueryBuilder('d')
			            ->select('COUNT(d)')
			            ->where('d.typeDemande = :Type')
			            ->andWhere('d.emmeteur = :Matricule')
			            ->andWhere('d.etatRepGrh = 1')
			            ->setParameter('Matricule', $matricule)
			            ->setParameter('Type', $type)
			            ->getQuery()
			            ->getSingleScalarResult();
		} elseif ($type > 1) {
			return $this->createQueryBuilder('d')
			            ->select('COUNT(d)')
			            ->where('d.typeDemande = :Type')
			            ->andWhere('d.emmeteur = :Matricule')
			            ->andWhere('d.etatRepGrh = 1')
			            ->setParameter('Matricule', $matricule)
			            ->setParameter('Type', $type)
			            ->getQuery()
			            ->getSingleScalarResult();
		}

	}
	public function DemandeEncours($type, $matricule) {
		//var_dump($matricule);
		if ($type == 1) {
			$qb = $this->createQueryBuilder('d')
			           ->where('d.typeDemande = :Type AND d.emmeteur = :Matricule AND d.etatRepSupDir <= 1 AND d.etatRepSupDir2 <= 1 AND d.etatRepGrh < 1')
			           ->setParameter('Type', $type)
			           ->setParameter('Matricule', $matricule);
		} else {
			$qb = $this->createQueryBuilder('d')
			           ->where('d.typeDemande = :Type AND d.emmeteur = :Matricule AND d.etatRepGrh < 1')
			           ->setParameter('Type', $type)
			           ->setParameter('Matricule', $matricule);
		}
		return $qb->getQuery()->getResult();
	}
	public function findDemandeReceive($user) {
		$Direction     = $user->getAgent()->getDirection();
		$SousDirection = $user->getAgent()->getCodeSd();
		$Service       = $user->getAgent()->getCodeSc();
		$Fonction      = $user->getAgent()->getFonction()->getId();

		//chef de Section
		if ($user->hasRole("ROLE_RESPO") and $Fonction == 3) {
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.code_sd = :Section")
			           ->andWhere("d.etatRepSupDir >= 0")
			           ->andWhere("d.typeDemande = 1")
			           ->andWhere("e != :Agent")
			           ->setParameter("Section", $SousDirection)
			           ->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			return $qb->getQuery()->getResult();
			//Chef de Service
		} elseif ($user->hasRole("ROLE_RESPO") and $Fonction == 4) {
			# code...
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.code_sc = :Service")
			           ->andWhere("d.etatRepSupDir >= 0")
			           ->andWhere("d.typeDemande = 1")
			           ->andWhere("e != :Agent")
			           ->setParameter("Service", $Service)
			           ->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			return $qb->getQuery()->getResult();
		}
		//Chef de Service Rattaché
		 elseif ($user->hasRole("ROLE_RESPO") and $Fonction == 5) {

			# code...
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.Direction = :Direction and d.etatRepSupDir <= 1 and d.typeDemande = 1 and e != :Agent")
			           ->orWhere("e.Direction = :Direction and d.etatRepSupDir = 0 and d.typeDemande = 1 and e != :Agent and e.code_sd is null ")
			           ->orWhere("e.Direction = :Direction  and d.typeDemande = 1 and e != :Agent and e.Fonction = 3")
			/*->orWhere("e.Direction = :Direction and d.etatRepSupDir = 0 and d.typeDemande = 1 and e != :Agent and e.Fonction = 3")*/
			->setParameter("Direction", $Direction)
			->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			//die();
			return $qb->getQuery()->getResult();
		}
		//Sous Directeur
		 elseif ($user->hasRole("ROLE_RESPO") and $Fonction == 6) {
			# code...
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.code_sd = :SousDirection and d.etatRepSupDir = 1 and d.typeDemande = 1 and e != :Agent")
			           ->orWhere("e.code_sd = :SousDirection and d.etatRepSupDir = 0 and d.typeDemande = 1 and e != :Agent and e.code_sc is null ")
			           ->setParameter("SousDirection", $SousDirection)
			           ->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			return $qb->getQuery()->getResult();
		}
		//directeur
		 elseif ($user->hasRole("ROLE_RESPO") and $Fonction == 7) {
			# code...
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.Direction = :Direction and d.etatRepSupDir <= 1 and d.typeDemande = 1 and e != :Agent")
			           ->orWhere("e.Direction = :Direction and d.etatRepSupDir = 0 and d.typeDemande = 1 and e != :Agent and e.code_sd is null ")
			           ->setParameter("Direction", $Direction)
			           ->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			return $qb->getQuery()->getResult();
		}
		//DG
		 elseif ($user->hasRole("ROLE_RESPO") and $Fonction == 10) {
			//dump($Fonction);
			die;
			$qb = $this->createQueryBuilder('d')
			           ->join('d.emmeteur', 'e')
			           ->addSelect('e')
			           ->Where("e.Fonction = 5 and e != :Agent")
			           ->orWhere("e.Fonction = 7 and e != :Agent")
			           ->orWhere("e.Fonction = 8 and e != :Agent")
			           ->orWhere("e.Fonction = 9 and e != :Agent")
			//->setParameter("Fonction", $Fonction)
			->setParameter("Agent", $user->getAgent())
			->orderBy('d.datecreation', 'DESC');
			return $qb->getQuery()->getResult();
		}

	}

	public function findDemandeReceiveSRHMG() {
		$qb = $this->createQueryBuilder('d')
		           ->join('d.emmeteur', 'e')
		           ->addSelect('e')
		           ->Where("d.etatRepSupDir2 = 1")
		           ->andWhere("d.typeDemande = 1")
		           ->orderBy('d.datecreation', 'DESC');
		return $qb->getQuery()->getResult();
	}

	public function findDemandeReceiveSRHMG2() {
		$qb = $this->createQueryBuilder('d')
		           ->join('d.emmeteur', 'e')
		           ->addSelect('e')
		           ->Where("d.etatRepGrh >= 0")
		           ->andWhere("d.typeDemande != 1")
		           ->orderBy('d.datecreation', 'DESC');
		return $qb->getQuery()->getResult();
	}
	public function demandeSendAutorisation($matricule) {
		$qb = $this->createQueryBuilder('d')
		           ->join('d.emmeteur', 'e')
		           ->addSelect('d')
		           ->where("e.matricule = :Matricule")
		           ->andWhere("d.typeDemande = 1")
		           ->setParameter("Matricule", $matricule)
		           ->orderBy('d.datecreation', 'DESC');
		return $qb->getQuery()->getResult();
	}

	public function demandeSendOther($matricule) {
		$qb = $this->createQueryBuilder('d')
		           ->join('d.emmeteur', 'e')
		           ->addSelect('d')
		           ->where("e.matricule = :Matricule")
		           ->andWhere("d.typeDemande != 1")
		           ->setParameter("Matricule", $matricule)
		           ->orderBy('d.datecreation', 'DESC');
		return $qb->getQuery()->getResult();
	}

	public function notification($Direction, $user) {
		$Matricule = $user->getAgent()->getMatricule();

		if ($user->hasRole("ROLE_AGENT")) {
			$send = $this->createQueryBuilder('d')
			             ->join('d.emmeteur', 'e')
			             ->addSelect('e')
			             ->where("e.matricule = :Matricule")
			             ->andWhere("d.etatEmmission != 0")
			             ->andWhere("d.etatNotification = 0")
			             ->setParameter("Matricule", $Matricule)
			             ->orderBy('d.datecreation', 'DESC');
			return $send->getQuery()->getResult();

		} elseif ($user->hasRole("ROLE_RESPO")) {
			$send = $this->createQueryBuilder('d')
			             ->join('d.emmeteur', 'e')
			             ->addSelect('e')
			             ->Where("e.Direction = :Direction AND d.etatRepSupDir = 0 AND d.typeDemande = 1")
			             ->orWhere("e.matricule = :Matricule AND d.etatEmmission != 0 AND d.etatNotification = 0")
			             ->setParameter("Direction", $Direction)
			             ->setParameter("Matricule", $Matricule)
			             ->orderBy('d.datecreation', 'DESC');
			return $send->getQuery()->getResult();
			// $receive2="";
		} elseif ($user->hasRole("ROLE_RESPO_SRHMG")) {
			/*
			$receive1 = $this->createQueryBuilder('d')
			->join('d.emmeteur', 'e')
			->addSelect('e')
			->Where("e.Direction = :Direction")
			->andWhere("d.etatRepSupDir = 0")
			->andWhere("d.typeDemande = 1")
			->setParameter("Direction", $Direction)
			->orderBy('d.datecreation', 'DESC');
			$receive1->getQuery()->getResult();
			 */
			$send = $this->createQueryBuilder('d')
			             ->join('d.emmeteur', 'e')
			             ->addSelect('e')
			//Autres Autorisation
			->Where("d.etatRepSupDir = 0 AND d.etatRepGrh IS NULL AND d.typeDemande != 1")
			//Autorisation Absence des autres service validation au niveau 2
			->orWhere("d.etatRepSupDir = 1 AND d.etatRepGrh = 0  AND d.typeDemande = 1")
			//Autorisation Absence de son service validation Niveau 1
			->orWhere("e.Direction = :Direction AND d.etatRepSupDir = 0 AND d.typeDemande = 1")
			//Propre Notification
			->orWhere("e.matricule = :Matricule AND d.etatEmmission != 0 AND d.etatNotification = 0")
			->setParameter("Direction", $Direction)
			->setParameter("Matricule", $Matricule)
			->orderBy('d.datecreation', 'DESC');
			return $send->getQuery()->getResult();

		} else {

		}

	}

	public function nbreDemande($mat) {
		$qb = $this->createQueryBuilder('d')
		           ->select('COUNT(d) as compt, t.libelle')
		           ->join('d.typeDemande', 't')
		//->addSelect('e')
		->where("d.emmeteur = :Matricule")
		->groupBy('d.typeDemande, t.libelle')
		->setParameter("Matricule", $mat);
		return $qb->getQuery()->getResult();
	}

	public function listPrint($type) {
		switch ($type) {
			case 1:
				# code...
				$qb = $this->createQueryBuilder('d')
				           ->where('d.typeDemande = 1')
				           ->andWhere('d.etatRepSupDir = 1')
				           ->andWhere('d.etatRepGrh = 1')
				           ->orderBy('d.datecreation', 'DESC');
				return $qb->getQuery()->getResult();
				break;
			case 3:
				$qb = $this->createQueryBuilder('d')
				           ->where('d.typeDemande = 3')
				           ->andWhere('d.etatRepGrh = 1')
				           ->orderBy('d.datecreation', 'DESC');
				return $qb->getQuery()->getResult();
				break;

			case 4:
				$qb = $this->createQueryBuilder('d')
				           ->where('d.typeDemande = 4')
				           ->andWhere('d.etatRepGrh = 1')
				           ->orderBy('d.datecreation', 'DESC');
				return $qb->getQuery()->getResult();
				break;

			default:
				# code...
				$qb = $this->createQueryBuilder('d')
				           ->where('d.typeDemande > 1')
				           ->andWhere('d.etatRepGrh = 1')
				           ->orderBy('d.datecreation', 'DESC');
				return $qb->getQuery()->getResult();
				break;
		}

	}

}
