<?php

namespace Demandes\DemandesBundle\Repository;
use Demandes\DemandesBundle\TypeDemande;

/**
 * TypeDemandeRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 */
class TypeDemandeRepository extends \Doctrine\ORM\EntityRepository
{
  public function findTypeDemande(){
    $subQueryBuilder = $this->getEntityManager()->createQueryBuilder();
    $subQuery = $subQueryBuilder
    ->select(['IDENTITY(tQ.typeDemande)'])
    ->from('DemandesBundle:Quota','tQ')
    ->getQuery()
    ->getArrayResult()
;
//dump($subQuery); die;
$queryBuilder = $this->getEntityManager()->createQueryBuilder();
$query = $queryBuilder
    ->select(['c'])
    ->from('DemandesBundle:TypeDemande', 'c')
    ->where($queryBuilder->expr()->notIn('c.id', ':subQuery'))
    ->setParameter('subQuery', $subQuery)

;
return $query;
  }

  public function findTypeDemandePrive($matricule){

  //  var_dump($type);
  //////////////////////Vérification Demande en cours ////////////////
    $queryBuilder = $this->getEntityManager()->createQueryBuilder();
    $demandeEncours = $queryBuilder
    ->select(['IDENTITY(d.typeDemande)'])
    ->from('DemandesBundle:Demande', 'd')
    ->where('d.etatEncours = 0')
    ->andWhere('d.emmeteur = :Matricule')
    ->setParameter('Matricule', $matricule)
    ->getQuery()
    ->getArrayResult();

    //////////////////Vérification Demande Aboutit(Validé) ///////////////////////
    $queryBuilder = $this->getEntityManager()->createQueryBuilder();
    $demandeAboutit = $queryBuilder
    ->select(['COUNT(d) as compter, d.objet, IDENTITY(d.typeDemande) as type'])
    ->from('DemandesBundle:Demande', 'd')
    ->where('(d.etatRepGrh = 1)')// or d.etatRepGrh != 2
    ->andWhere('d.emmeteur = :Matricule')
    ->groupBy('d.typeDemande')
    ->setParameter('Matricule', $matricule)
    ->getQuery()
    ->getResult();

    /////////////
    $array = [0];
    foreach($demandeAboutit as $test)
    {
      //dump($test['type']); 
      //dump($test['compter']);
      $queryBuilder = $this->getEntityManager()->createQueryBuilder();
      $quota=$queryBuilder
      ->select('q.nbreQuota')
      ->from('DemandesBundle:Quota', 'q')
      ->where('q.typeDemande = :Type')
      ->setParameter('Type', $test['type'])
      ->getQuery()
      ->getOneOrNullResult();
     // dump($test['compter']);
      //dump($quota['nbreQuota']);
      if ($quota){
      if ($test['compter'] >= $quota['nbreQuota']){
        $array=$test['type'];

      }

}
    }//die;
    //dump($array); 
    //var_dump($array);
  //die;
    //var_dump($demandeAboutit); die;
//var_dump(count($demandeEncours));
//var_dump($demandeAboutit);
// die;

    if($demandeEncours and $demandeAboutit)
    {
    //  var_dump($array);
    //  var_dump($demandeEncours);
    //  die;
      $qb = $this->getEntityManager()->createQueryBuilder();
      $qb
      ->select(['c'])
      ->from('DemandesBundle:TypeDemande', 'c')
      ->where($queryBuilder->expr()->notIn('c.id', ':subQuery'))
      ->andWhere($queryBuilder->expr()->notIn('c.id', ':subQuerys'))
      ->setParameter('subQuery', $array)
      ->setParameter('subQuerys', $demandeEncours);
      return $qb;

    }elseif($demandeAboutit){

      $qb = $this->getEntityManager()->createQueryBuilder();
      $qb
      ->select(['c'])
      ->from('DemandesBundle:TypeDemande', 'c')
      ->where($queryBuilder->expr()->notIn('c.id', ':subQuery'))
      ->setParameter('subQuery', $array);
      return $qb;
    }elseif($demandeEncours)
    {
      $qb = $this->getEntityManager()->createQueryBuilder();
      $qb
      ->select(['c'])
      ->from('DemandesBundle:TypeDemande', 'c')
      ->where($queryBuilder->expr()->notIn('c.id', ':subQuery'))
      ->setParameter('subQuery', $demandeEncours);
      return $qb;
    }else{
      $qb = $this->getEntityManager()->createQueryBuilder();
      $qb
      ->select(['c'])
      ->from('DemandesBundle:TypeDemande', 'c');
      return $qb;
    }


  }

}
