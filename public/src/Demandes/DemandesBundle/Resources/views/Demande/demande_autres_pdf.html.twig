{% extends app.request.attributes.get('_route')=='demande_print'
? '::gabarit_print.html.twig'
: '::gabarit_preview.html.twig' %}

{% block bootstrap %}
    {% if app.request.attributes.get('_route')=='demande_print'%}
        <link href="{{app.request.getSchemeAndHttpHost() ~ asset('design/css/bootstrap.min.css') }}" rel="stylesheet"/>

    {% endif %}
{% endblock %}
{% block service %}
    <span class="gras">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Le Directeur Général</span>

{% endblock %}
{% block titre %}
    <div align="center" style="font-size:30px; font-family:CenturyFontBold !important; border: solid; border-radius: 5px; width: 60%; margin: auto;">
        {{entity.typedemande.libelle}}
    </div>

{% endblock %}

{% block ref %}N°:____________MEF/DGE/SRHMG
{% endblock %}
{% block datePdf %}{#{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}#}{% endblock %}
{% block contenuPdf -%}

    <div style="background-color: white; color:black; line-height:2em;">
        Je soussigné
        {{dgName}}, Directeur Général de l'Economie,
        {% if entity.typedemande.id == 3 %}
            atteste
        {% else %}
            atteste
            {#certifie#}
        {% endif %}

        que

        {{entity.emmeteur.getCivilite.libsitf}}

        {{entity.emmeteur.concatNom|striptags}}, matricule
        {{entity.emmeteur.matricule}},
        {{entity.emmeteur.emploi.libEmpl}}, est effectivement en service à la Direction Générale de l'Economie (DGE), depuis le
    </strong>
    {{entity.emmeteur.datePriseServiceDge|localizeddate('none', 'none', null, null, 'dd MMMM Y')|replace({" 01 ": "&nbsp;1<sup>er</sup>&nbsp;"})|raw  }}.</strong>
<br/><br/>
En foi de quoi,
{%if entity.typedemande.id == 3 %}
    la présente attestation
{% else %}
    la présente attestation
{% endif %}
lui est délivrée pour servir et valoir ce que de droit.
<br><br><br>

<table border="0" width="100%">
    <tr>
    <td width="50%"></td>
<td class="gras" style="font-size:12pt;  text-align:left; line-height:1.5">



            {% if fonctionbase.getSignataireDg(date()) and fonctionbase.getSignataireDg(date())==1 %}

                {% else %}
                    {#
                                                            {{fonctionbase.getSignataireDg(date())['entete'] | raw}}
                                                            <br>  <br>
                                                            {{fonctionbase.getSignataireDg(date())['signataire'] | raw}}#}

                    <u>{{fonctionbase.getSignataireDg(date())['entete'] | raw}}</u>
                    <br><br>
                    P.I Le
                    {{fonctionbase.getSignataireDg(date())['directeur'] | raw}}
                    <br><br>


            {% endif %}


        </td>
    </tr>
</table></div></div><script src="{{ asset('design/js/style.js') }}"></script>{% endblock %}
