{% extends '::base.html.twig' %}
{% block datatableCss %}
    {% include "::sections_app/datatableCss.html.twig" %}
{% endblock %}
{% block datatableJs %}
    {% include "::sections_app/datatableJs.html.twig" %}
{% endblock %}

{% block titre_page %}
    <div> <h1>Demandes Emises</h1></div>
{% endblock %}
{% block body %}

<ul class="nav nav-tabs bar_tabs" role="tablist">


  <li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">Autorisations d'absences</a></li>
  <li role="presentation"><a href="#serv1" aria-controls="message" role="tab" data-toggle="tab">Autres Demandes</a></li>

</ul>
<div class="tab-content">

  <div role="tabpanel" class="tab-pane active" id="home">
  <table id="datatable" class="table table-striped table-bordered jambo_table">
        <thead>
            <tr>
                <th rowspan="2">Date Demande</th>
                <th rowspan="2">Objet</th>
                <th rowspan="2">Destination</th>
                <th rowspan="2">Etat de la demande</th>
                <th colspan="2">Supérieur 1</th>
                <th colspan="2">Supérieur 2</th>
                <th colspan="2">Service Ressources Humaines</th>
                <th rowspan="2">Actions</th>
            </tr>
            <tr>
                <th>Date Réponse</th>
                <th>Etat Réponse</th>
                <th>Date Réponse</th>
                <th>Etat Réponse</th>
                <th>Date Réponse</th>
                <th>Etat Réponse</th>
            </tr>
        </thead>
        <tbody>
            {% for entity in entities %}
                <tr>
                    <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
                    <td>{{ entity.objet }}</td>
                    <td>{{ entity.Destination }}</td>
                    <td align="center"><!--{% if(entity.etatEmmission == 0) %}{# Etat 0  En attente#}
                        <span class="label label-info arrowed-in arrowed-in-right">En Attente</span>
                        {% elseif (entity.etatEmmission == 1) %}
                        <span class="label label-success">Accepté</span>
                            {% elseif (entity.etatEmmission == 2) %}
                            <span class="label label-danger">Refusé</span>
                                {% endif %}-->
                                    {% if (entity.etatRepSupDir == 0) and (entity.etatRepSupDir2 == 0) and (entity.etatRepGrh == 0) %}Transmis {% if (entity.supDir) %} au {{entity.supDir.fonction}} {% endif %}
                                        <span class="label label-info arrowed-in arrowed-in-right"></span>
                                        {% elseif (entity.etatRepSupDir == 1) and (entity.etatRepSupDir2 == 0) and (entity.etatRepGrh == 0) %}Transmis {% if (entity.supDir2) %} au  au {{entity.supDir2.fonction}} {% endif %}
                                            <span class="label label-info arrowed-in arrowed-in-right"></span>
                                        {% elseif (entity.etatRepSupDir == 1) and (entity.etatRepSupDir2 == 1) and (entity.etatRepGrh == 0) %}Transmis au RH
                                            <span class="label label-info arrowed-in arrowed-in-right"></span>
                                    {% elseif (entity.etatRepSupDir == 1)  and (entity.etatRepSupDir2 == 1) and (entity.etatRepGrh == 1) %}Accepté
                                        <span class="label label-success"></span>
                                    {% elseif (entity.etatRepSupDir == 2) or (entity.etatRepSupDir2 == 2) or (entity.etatRepGrh == 2) %}Refusé
                                      <span class="label label-danger"></span>
                                        {% elseif (entity.etatRepSupDir == 1) or (entity.etatRepSupDir == 1) or (entity.etatRepGrh == 1) %}En Traitement
                                            <span class="label label-warning"></span>
                                    {% elseif (entity.etatEmmission == 2) %}Refusé
                                        <span class="label label-danger"></span>
                                    {% endif %}
                              </td>
                                <td>{% if entity.dateRepSupDir %}
                                      {{ entity.dateRepSupDir|date('d-m-Y H:i:s') }}
                                    {% endif %}
                                </td>
                                <td align="center">
                                  {% if (entity.etatRepSupDir == 0) %}En Attente{# Etat 0  En attente#}
                                    <span class="label label-warning"></span>
                                    {% elseif (entity.etatRepSupDir == 1) %}Validé
                                        <span class="label label-info"></span>
                                        {% elseif (entity.etatRepSupDir == 2) %}Refusé
                                            <span class="label label-danger"></span>
                                            <br>
                                            {{entity.motifRejet}}
                                            {% endif %}
                                </td>
                                <td>{% if entity.dateRepSupDir2 %}
                                  {{ entity.dateRepSupDir2|date('d-m-Y H:i:s') }}
                                {% endif %}  
                                </td>
                                <td align="center">
                                  {% if (entity.etatRepSupDir2 == 0) and (entity.etatRepSupDir == 1) %}{# Etat 0  En attente#}En Attente
                                    <span class="label label-warning"></span>
                                    {% elseif (entity.etatRepSupDir2 == 1) %}Validé
                                        <span class="label label-info"></span>
                                        {% elseif (entity.etatRepSupDir2 == 2) %}Refusé
                                            <span class="label label-danger"></span>
                                            <br>
                                            {{entity.motifRejet}}
                                            {% endif %}
                                </td>
                                            <td>
                                            {% if entity.dateRepGrh %}
                                              {{ entity.dateRepGrh|date('d-m-Y H:i:s') }}
                                            {% endif %}
                                            </td>
                                            <td align="center">
                                            {% if (entity.etatRepGrh == 2) %}Refusé
                                                  <span class="label label-danger"></span>
                                                  <br>
                                                  {{entity.motifRejet}}
                                            {% elseif (entity.etatRepGrh == 0) and (entity.etatRepSupDir2 == 1) %}{# Etat 0  En attente#}En Attente
                                                <span class="label label-warning"></span>
                                            {% elseif (entity.etatRepGrh == 1) %}Validé
                                                    <span class="label label-info"></span>
                                            {% endif %}
                                            </td>
                                              <td>{#<a class="btn btn-success" href="{{ path('demande_show', { 'id': entity.id }) }}">Consulter</a>#}
                                                            
                                                                {% if(entity.etatEmmission == 0) %}
                                                                    
                                                                        <a class="btn btn-success" href="{{ path('demande_edit', { 'id': entity.id }) }}">Modifier</a>
                                                                   
                                                                {% endif %}
                                                                {% if(entity.signeActe == 1) %}
                                                                    
                                                                    <button value="{{ vich_uploader_asset( entity.demandeActe, 'docFile')}}" class="btn btn-success btnShow">Télécharger l'acte</button>
                                                                   
                                                                {% endif %}
                                                                {#
                                                                <li>
                                                                    <a href="{{ path('demande_print', { 'id': entity.id }) }}">Télécharger</a>
                                                                </li>
                                                               #}
                                                           
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                    </tbody>
                                                </table>

</div>
<div role="tabpanel" class="tab-pane" id="serv1">
  <table class="records_list table table-striped responsive-utilities jambo_table" width=100%>
  <thead>
      <tr>
          <th rowspan="2">Date Demande</th>
          <th rowspan="2">Type Demande</th>
          <th rowspan="2">Objet</th>
          <th rowspan="2">Etat de la demande</th>
          <th colspan="2">Service Ressources Humaines</th>
          <th rowspan="2">Actions</th>
      </tr>
      <tr>
          <th>Date Réponse</th>
          <th>Etat Réponse</th>
      </tr>
  </thead>
  <tbody>
    {% for entity in entiti %}
        <tr>
            <td>{% if entity.datecreation %}{{ entity.datecreation|date('d-m-Y H:i:s') }}{% endif %}</td>
            <td>{{ entity.typeDemande }}</td>
            <td>{{ entity.objet }}</td>
            <td align="center">
                            {% if (entity.etatRepGrh == 0)  %}
                                <span class="label label-info arrowed-in arrowed-in-right">Transmis au RH</span>
                            {% elseif (entity.etatRepGrh == 1)  %}
                                <span class="label label-success">Accepté</span>

                            {% elseif (entity.etatEmmission ==2 or etatRepGrh == 2) %}
                                <span class="label label-danger">Refusé</span>
                            {% endif %}
                        </td>
                        <td>{% if entity.dateRepGrh %}{{ entity.dateRepGrh|date('d-m-Y H:i:s') }}{% endif %}</td>
                        <td align="center">{% if (entity.etatRepGrh == 0) %}{# Etat 0  En attente#}
                            <span class="label label-warning">En Attente</span>
                            {% elseif (entity.etatRepGrh == 1) %}
                                <span class="label label-info">Validé</span>
                                {% elseif (entity.etatRepGrh == 2) %}
                                    <span class="label label-danger">Refusé</span>
                                    <br>
                                    {{entity.motifRejet}}
                                    {% endif %}
                          </td>
                          <td>
                              
                                  {% if(entity.etatEmmission == 0) %}
                                     
                                          <a class="btn btn-warning" href="{{ path('demande_edit', { 'id': entity.id }) }}">Modifier</a>
                                  
                                  {% endif %}
                                  {% if(entity.signeActe == 1) %}
                                                                    
                                                                    <button value="{{ vich_uploader_asset( entity.demandeActe, 'docFile')}}" class="btn btn-success btnShow">Télécharger l'acte</button>
                                                                   
                                                                {% endif %}
                                  <!--
                                  <li>
                                      <a href="{{ path('demande_print', { 'id': entity.id }) }}">Télécharger</a>
                                  </li>
                                  -->
                             
                            </td>

          </tr>
          {% endfor %}
  </tbody>
</table>
</div>
</div>
                                                {% endblock %}
