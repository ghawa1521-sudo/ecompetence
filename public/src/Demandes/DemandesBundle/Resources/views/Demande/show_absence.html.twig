{% extends '::base.html.twig' %}

{% block body -%}
<div align="center">
  <h3>DEMANDE {{entity.typedemande}}</h3>
</div>
<br>
<div class="col-md-push-2 col-md-8">
    <table class="record_properties table table-striped" align="left">
        <tbody>
            <!--
            <tr>
                <td>Id</td>
                <td>{{ entity.id }}</td>
            </tr>
            -->
            <tr>
                <td align="left"><b>MATRICULE</b></td>
                <td left="left">{{ entity.emmeteur.matricule }}</td>
            </tr>
            <tr>
                <td><b>NOM et PRENOMS</b></td>
                <td left="left">{{ entity.emmeteur.nom }} {{ entity.emmeteur.prenoms }}</td>
            </tr>
            <tr>
                <td><b>OBJET</b></td>
                <td left="left">{{ entity.objet }}</td>
            </tr>
            <tr> <td> <br/></td> <td></td></tr>
            <tr>
                <td><b>REPONSE Chef de Section / Chef de Service </b></td>
                <td >{% if (entity.Etatrepsupdir == 0) %}{# Etat 0  En attente#}
                            <span class="label label-warning" heigtd="100%">En Attente de Validation</span>
                     {% elseif (entity.Etatrepsupdir == 1) %}
                            <span class="label label-success" heigtd="100%">Demande Validée</span>
                        {% elseif (entity.Etatrepsupdir >= 2) %}
                            <span class="label label-danger"> Demande Refusée</span><br>
                            MOTIF: {{entity.motifRejet}}
                    {% endif %}  </td>
            </tr>
            <tr>
                <td><b>DATE Chef de Section / Chef de Service Rattaché</b></td>
                <td left="left">{% if (entity.dateRepSupDir) %} {{ entity.dateRepSupDir|date('d-m-Y H:i:s') }} {% endif %} </td>
            </tr>
            {% if (entity.Etatrepsupdir == 1) %}
            <tr> <td> <br/></td> <td></td></tr>
            <tr>
                <td><b>REPONSE Directeur / Chef de Service </b></td>
                <td >{% if (entity.Etatrepsupdir2 == 0) %}{# Etat 0  En attente#}
                            <span class="label label-warning" heigtd="100%">En Attente de Validation</span>
                     {% elseif (entity.Etatrepsupdir == 1) %}
                            <span class="label label-success" heigtd="100%">Demande Validée</span>
                        {% elseif (entity.Etatrepsupdir >= 2) %}
                            <span class="label label-danger"> Demande Refusée</span><br>
                            MOTIF: {{entity.motifRejet}}
                    {% endif %}  </td>
            </tr>
            <tr>
                <td><b>DATE REPONSE Directeur / Chef de Service</b></td>
                <td left="left">{% if (entity.dateRepSupDir) %} {{ entity.dateRepSupDir|date('d-m-Y H:i:s') }} {% endif %} </td>
            </tr>
                {% endif %}
            {% if (entity.Etatrepsupdir2 == 1) %}
                <tr> <td> <br/></td> <td></td></tr>
            <tr>
                <td><b>REPONSE Service des Ressources Humaines</b></td>
                <td>{% if(entity.Etatrepgrh == 0) %}{# Etat 0  En attente#}
                            <span class="label label-warning">En Attente de Validation</span>
                     {% elseif (entity.Etatrepgrh == 1) %}
                            <span class="label label-success">Demande Validée</span>
                        {% elseif (entity.Etatrepgrh >= 2) %}
                            <span class="label label-danger">Demande Refusée</span>
                            MOTIF: {{entity.motifRejet}}
                    {% endif %}

                </td>
            </tr>
            <tr>
                <td><b>DATE Réponse Service des Ressources Humaines</b></td>
                <td>{% if(entity.dateRepGrh) %} {{ entity.dateRepGrh|date('d-m-Y H:i:s')  }} {% endif %}</td>
            </tr>
            {% endif %}


        </tbody>
    </table>
{#
    {% if (is_granted('ROLE_RESPO_SRHMG')) and (entity.etatRepGrh == 1) %}
        <a class="btn btn-info col-md-offset-5" target="_blank" href="{{ path('demande_print', { 'id': entity.id }) }}">
            <i class="fa fa-download"></i>
            Imprimer l'autorisation d'absence
        </a>
    {% endif %}
    {% if is_granted('ROLE_RESPO_SRHMG') and (entity.Etatrepsupdir == 1) and (entity.emmeteur.users.roles[0] == 'ROLE_RESPO') %}
        <a class="btn btn-info col-md-offset-5" href="{{ path('demande_print', { 'id': entity.id }) }}">
