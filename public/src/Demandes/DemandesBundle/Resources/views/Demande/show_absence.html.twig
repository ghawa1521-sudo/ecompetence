                <a href="#" class="btn btn-large btn-primary" data-confirm="Etes-vous <strong>certain</strong> de vouloir Valider cette demande ?">Valider</a>
                <div class="col-md-offset-4 col-sm-3 col-xs-3 col-lg-3 col-md-3">
                    <form action="{{ path('demande_valid', { 'id': entity.id }) }}" metdod ="POST">

                        <input id="mdp" name="mdp" type="password" class="form-control" placeholder="Votre Mot de Passe" required="required" />

                        <input type="submit" class="btn btn-success col-sm-12 form-control" value="valider">
                    </form>
                </div>
            </div>


        </div>
        -->
        <br/>
        <div class="col-md-12">
            <ul class="record_actions">
                <li>
                    <a href="{{ path('demande_receive') }}">
                        Retour Demandes Reçues
                    </a>
                </li>

            </ul>
        </div>

{% endif %}
</div>
{% endblock %}
{% block javascript %}
<script src="{{ asset('design/js/style.js') }}"></script>


</script>
{% endblock %}
