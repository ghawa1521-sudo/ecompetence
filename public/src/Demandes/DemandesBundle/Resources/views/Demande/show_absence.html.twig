            </div>
            <div class="col-md-6" >
                <a href="{{ path('demande_do_reject', { 'id': entity.id }) }}" class="btn btn-large btn-danger col-push-md-1 col-md-10">Rejeter la Demande</a>
            </div>
        </div>
