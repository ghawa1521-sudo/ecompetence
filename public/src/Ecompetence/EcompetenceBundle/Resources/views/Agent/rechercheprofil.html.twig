<script type="text/javascript">
function searchList1($sourceval, $route, $destval)
{   //alert($sourceval);
    //alert($destval);
    $source = $($sourceval).val();
    

    if ($source.length > 0 ){

        $source=$source;
        //showloader('#cacher');
    }else{
            $source=0;
        }
    
    $paramroute = {'id': $source};
   
    //alert(Routing.generate($route, $paramroute));
    //alert($div); exit;
    //console.log($div);

    $.ajax({
       type: 'GET',
       url: Routing.generate($route, $paramroute),
       dataType: 'json',
       success: function(data) {
        //console.log(data);
          // alert(jQuery.isEmptyObject(data));
           

           if (jQuery.isEmptyObject(data) == false){
           
               $($destval).children('option:not(:first)').remove();
               //$($destval).append('<option>---- Choisir un Service-----</option>');
               $.each(data, function(key, value) {
   
                 $($destval).append('<option value= "' + value[0] + '">' + value[1] + '</option>');

                // $($destval).html("ggggg");
               
               });
               
                 
               
            
           }
           else{
               //console.log($sourceval);
              //  alert("no");
               $($destval).children('option:not(:first)').remove();
              
           }
       }
       });
   
    }


function searchEmploi($sourceval, $route, $destval)
{
    var source = $($sourceval).val();

    // On vide toujours la liste destination
    $($destval).children('option:not(:first)').remove();

    // Aucun grade sélectionné
    if (!source || source === '0') {
        return;
    }

    $.ajax({
        type: 'GET',
        url: Routing.generate($route, {
            id: source
        }),
        dataType: 'json',

        success: function(data) {

            $($destval).children('option:not(:first)').remove();

            $.each(data, function(key, value) {

                $($destval).append(
                    $('<option>', {
                        value: value[0],
                        text: value[1]
                    })
                );

            });
        },

        error: function(xhr, status, error) {
            console.log('Erreur recherche emplois : ' + error);
            console.log(xhr.responseText);
        }
    });
}


function searchSecteur($sourceval, $route, $destval)
{
    var source = $($sourceval).val();

    // On vide toujours la liste destination
    $($destval).children('option:not(:first)').remove();

    // Aucun secteur sélectionné
    if (!source || source === '0') {
        return;
    }

    $.ajax({
        type: 'GET',
        url: Routing.generate($route, {
            id: source
        }),
        dataType: 'json',

        success: function(data) {

            $($destval).children('option:not(:first)').remove();

            $.each(data, function(key, value) {

                $($destval).append(
                    $('<option>', {
                        value: value[0],
                        text: value[1]
                    })
                );

            });
        },

        error: function(xhr, status, error) {
            console.log('Erreur recherche emplois : ' + error);
            console.log(xhr.responseText);
        }
    });
}



$(document).ready(function() {

    var $experienceTotale = $('#comptence_ecompetencebundle_rechercher_anneetotexp');
    var $experienceDge = $('#comptence_ecompetencebundle_rechercher_anneeexpdge');

    function verifierAnneesExperience() {
        var total = parseInt($experienceTotale.val(), 10);
        var dge = parseInt($experienceDge.val(), 10);

        // L'expérience à la DGE peut être égale au total, mais pas supérieure.
        if (!isNaN(dge) && !isNaN(total) && dge > total) {
            alert("L'année d'expérience DGE ne peut pas être supérieure à l'année d'expérience cumulée.");
            $experienceDge.val('');
        }
    }

    $experienceDge.on('change', verifierAnneesExperience);

    $('#grade').on('change', function() {

        searchEmploi(
            '#grade',
            'search_emploi',
            '#emploi'
        );

    });

     $('#secteur').on('change', function() {
       
        searchSecteur(
            '#secteur',
            'searchSecteur',
            '#structure'
        );

    });

});


   
    
    </script>      
    
