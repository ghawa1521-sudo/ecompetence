<script type="text/javascript">
        $(document).ready(function () {
        var modif=$('#modif').val();
        var secteur=$('#sec').val();

        if (modif==false) 
        {      
        $('#viewtxtpo').hide();
        $('#viewoptpo').show();
        $('#viewcvdg').show();
        $('#viewcvdc').show();

       // $('#diplome').children('option:not(:first)').remove();
        //$('#specialite').children('option:not(:first)').remove();
       // $('#option').children('option:not(:first)').remove();
      }
        else if (secteur==1)
       {
        $('#viewtxtpo').hide();
        $('#viewoptpo').show();
        $('#viewcvdg').show();
        $('#viewcvdc').show();

       }
       else
       {
          $('#viewtxtpo').show(); 
          $('#viewoptpo').hide();
          $('#viewcvdg').hide();
          $('#viewcvdc').hide();
       }
    
         
        });
        
       $('#sec').change(function(){
          var type=$(this).val();
          if (type==1)
          {  
            $('#viewtxtpo').hide();
            $('#viewoptpo').show();
            $('#viewcvdg').show();
            $('#viewcvdc').show();
          }
          else
          { 
             $('#viewtxtpo').show(); 
             $('#viewoptpo').hide();
             $('#viewcvdg').hide();
             $('#viewcvdc').hide();          
          }
              
           
        });
         
</script>




<script type="text/javascript">
   $('#btn_valid').on('click', function (e) {
 
        e.preventDefault();
 
        $.ajax({
            type: $('#form_body').attr('method'),
            url: $('#form_body').attr('action'),
            data: $('#form_body').serialize()
        })
        .done(function (data) {
           // alert(1);
            if (typeof data.message !== 'undefined') {                //alert(data.message);
                var monObjet = JSON.parse(data.value);
                console.log(monObjet);
                  // Selectionner une option d'un selection à l'aide de son value
                 $('#sec option[value='+monObjet.secteur.id+']')
                 .attr("selected", "seleted");
                 $('#str')
                 .append($("<option></option>")
                 .attr("value", monObjet.id)
                 .text(monObjet.libStructure)
                 .attr("selected", "seleted"));
                $('#str').trigger('change');

                // $('#id_deplacement_designation').val("");
                 $('.form_error').empty();
            }
        })
        .fail(function (jqXHR, textStatus, errorThrown) {
            if (typeof jqXHR.responseJSON !== 'undefined') {
                if (jqXHR.responseJSON.hasOwnProperty('form')) {
                    $('#form_body').html(jqXHR.responseJSON.form);
                }
 
                $('.form_error').html(jqXHR.responseJSON.message);
 
            } else {
              //alert(3);
                alert(errorThrown);
            }
 
        });
    });                   
</script>


<script type="text/javascript">
function searchList($sourceval, $route, $destval, $div)
{
    $source = $($sourceval).val();
 
    if($sourceval=='#sec')
    { 
        if($source==1)
      {   
        $('#viewtxtpo').hide();
        $('#viewoptpo').show();
        $('#viewcvdg').show();
        $('#viewcvdc').show();
      }
      else
      {
       $('#viewtxtpo').show(); 
       $('#viewoptpo').hide();
       $('#viewcvdg').hide();
       $('#viewcvdc').hide();
      }
    }
    if ($source.length > 0 ){

        $source=$source;
    }else{
            $source=0;
        }
    
    $paramroute = {'id': $source};
    $.ajax({
       type: 'GET',
       url: Routing.generate($route, $paramroute),
       dataType: 'json',
       success: function(data) {
       
          // alert(jQuery.isEmptyObject(data));
           

           if (jQuery.isEmptyObject(data) == false){
             
               $($destval).children('option:not(:first)').remove();
               //$($destval).append('<option>---- Choisir un Service-----</option>');
               $.each(data, function(key, value) {
                    //console.log(value);
                 $($destval).append('<option value= "' + value[0] + '">' + value[1] + '</option>');

                // $($destval).html("ggggg");
               
               });
               
                 
               
            
           }
           else{
               //console.log($sourceval);
              //  alert("no");
               $($destval).children('option:not(:first)').remove();
              
           }
       }
       });
   
}

             </script>


