function searchList($sourceval, $route, $destval, $div)
{  
    // --- Récupère la valeur sélectionnée avant de vider le select
    var selectedValue = $($destval).val();

    if($sourceval=="#diplome")
    { 
        var diplome = $($sourceval).val();
        if (diplome==1||diplome==3||diplome==5)
        {   
            $('#libelle').val('');
            if(diplome==5) {
                $('#option').children('option:not(:first)').remove();
                $('#viewoption').hide();
            } else {
                $('#specialite').children('option:not(:first)').remove();
                $('#option').children('option:not(:first)').remove();
                $('#viewoptspecialite').hide();
                $('#viewoption').hide();
                $('#specialite').attr({required:false});
            }
        } else { 
            $('#viewoptspecialite').show();
            $('#viewoption').show();
            $('#specialite').attr({required:true});
        }
    }     

    $source = $($sourceval).val();
    if ($source.length == 0) $source = 0;
    $paramroute = {'id': $source};

    $.ajax({
        type: 'GET',
        url: Routing.generate($route, $paramroute),
        dataType: 'json',
        success: function(data) {
            if (jQuery.isEmptyObject(data) == false){
                $($destval).children('option:not(:first)').remove();
                $.each(data, function(key, value) {
                    $($destval).append('<option value="' + value[0] + '">' + value[1] + '</option>');
                });

                // --- Réappliquer la valeur précédemment sélectionnée
                if (selectedValue) {
                    $($destval).val(selectedValue);
                }
            } else {
                $($destval).children('option:not(:first)').remove();
            }
        }
    });
}

</script>    
