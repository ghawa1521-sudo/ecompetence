<script type="text/javascript">
   $('#btn_valid1').on('click', function (e) {
      
        e.preventDefault();
 
        $.ajax({
            type: $('#form_body_diplo').attr('method'),
            url: $('#form_body_diplo').attr('action'),
            data: $('#form_body_diplo').serialize()
        })
        .done(function (data) {
          
            if (typeof data.message !== 'undefined') {                //alert(data.message);
                var monObjet = JSON.parse(data.value);
               // console.log(monObjet);

                  // Selectionner une option d'un selection à l'aide de son value
                 $('#niveau option[value='+monObjet.niveau.id+']')
                 .attr("selected", "seleted");
                 $('#diplome')
                 .append($("<option></option>")
                 .attr("value", monObjet.id)
                 .text(monObjet.libDiplome)
                 .attr("selected", "seleted"));
                 //alert(monObjet.libDiplome); 

                // $('#id_deplacement_designation').val("");
                 $('.form_error').empty();
            }
        })
        .fail(function (jqXHR, textStatus, errorThrown) {
            if (typeof jqXHR.responseJSON !== 'undefined') {
                if (jqXHR.responseJSON.hasOwnProperty('form')) {
                    $('#form_body_diplo').html(jqXHR.responseJSON.form);
                }
 
                $('.form_error').html(jqXHR.responseJSON.message);
 
            } else {
                alert(errorThrown);
            }
 
        });
    });                   
</script>

