{% import "::ediligence/macro/macro.html.twig" as macro %}
{% set profil = '' %}{% set compte = '' %} {% set titre = '' %}
{% for menu in menus %}

    {% if menu.typecompte in ['ROLE_Service_Courrier'] %}
        {% set profil = 'Courrier DGE' %}
        {% set compte = ['ROLE_Service_Courrier'] %}
        {% set titre = ['DILIGENCES'] %} 

    {% elseif menu.typecompte in ['ROLE_DGE,ROLE_Sous_Dir_Chef_Sec,ROLE_Directeur,ROLE_DGA']  %}
        {% if app.user.agent.fonction.id == 10 %}
            {% set profil = 'DGE' %}
            {% set compte = ['ROLE_dge'] %}
            {% set titre = ['DILIGENCES'] %} 
        {% elseif app.user.agent.fonction.id == 9 %}
            {% set profil = 'DGA' %}
            {% set compte = ['ROLE_dga', 'ROLE_Directeur'] %}
            {% set titre = ['DILIGENCES'] %} 
        {% elseif app.user.agent.fonction.id == 7 %}
            {% set profil = 'Directeur' %}
            {% set compte = ['ROLE_Directeur'] %}
            {% set titre = ['DILIGENCES'] %}  
        {% else %}
            {% set profil = 'Chef de Service' %}
            {% set compte = ['ROLE_Sous_Dir_Chef_Sec'] %}
            {% set titre = ['DILIGENCES'] %}
        {% endif %}

    {% elseif menu.typecompte in ['ROLE_Courrier_Interne']  %}
        {% set profil = 'Courrier Interne' %}
        {% set compte = ['ROLE_Courrier_Interne'] %}
        {% set titre = ['DILIGENCES'] %} 

    {% elseif menu.typecompte in ['ROLE_Charge_etudes']  %}
        {% set profil = 'Charge etude' %}
        {% set compte = ['ROLE_Charge_etudes'] %}
        {% set titre = ['DILIGENCES'] %} 

    {% elseif menu.typecompte in ['ROLE_Conseillers']  %}
        {% set profil = 'Conseillers' %}
        {% set compte = ['ROLE_Conseillers'] %}
        {% set titre = ['DILIGENCES'] %}   #}


    {% endif %}

{% endfor %}




