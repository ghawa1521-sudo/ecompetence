{% extends '::ediligence/base.html.twig' %}

{% block body %}{% set cpt = 0 %}{% set dossier = 0 %}
    <div class="content-header">
        <div class="header-section">
            <h1>
                <i class="gi gi-notes_2"></i>Diligences reçues<br><small>&nbsp;</small>
            </h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Traiter une diligence</li>
        <!--<li><a href="">Nouveau</a></li>-->
    </ul>
    <div class="row">

        <form method="post" class="form-vertical col-md-12" style="color:#006;" name="frm_imputer" enctype="multipart/form-data" id="form_Imputation" action="">
            <div class="col-md-offset-2 col-md-8">
                <div class="block">
                    <!-- Basic Form Elements Title -->
                    <div class="block-title">

                        <h2><strong>Nouvelle diligence reçue</strong></h2>
                    </div>

                    <div style="float:right;" class="bien2">
                        <b>COURRIER: N° &nbsp; {{entities[0].courrier.id}}</b>
                    </div>
                    <div class="bien">
                        <b>Par: <font color="#000000">&nbsp;{{entities[0].matriculeImput.nom}}&nbsp;{{entities[0].matriculeImput.prenoms}}</font></b><br>
                        <b>A: <font color="#000000">&nbsp;&nbsp;{{imputdir[0].matriculeimpute.nom}}&nbsp;{{imputdir[0].matriculeimpute.prenoms}}</font></b><br>
                        <b>OBJET:<font color="#000000">&nbsp;{{entities[0].courrier.objet|raw|striptags|slice(0, 150) }}</font></b>
                    </div>
                    <div class="form-group bien">
                        <font size="+1"><b>INSTRUCTIONS</b></font><br>
                        <font color="#000000">
                        {% set val=0 %}
                        {% for entitie in instruction%}
                            {% set val=val +1%}
                            <br>
                            {{val}} - {{entitie.instImput.libIbstruction|raw}}<br>    
                        {% endfor %}
                        {% if entities[0].instPart %}
                            <br>
                            {{val + 1}} - Cas particulier: {{entities[0].instPart|raw}}<br>
                        {% endif %}

                        </font>
                    </div>{% if entities[0].courrier.piecejointe %}
                    <label>Télécharger la Pièce Jointe:
                        {{ macro.apercu(entities[0].courrier.piecejointe) }}
                        {#
                        <a class="red" href="{{ vich_uploader_asset(entities[0].courrier.piecejointe, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                            <i class="ace-icon fa fa-download bigger-130"></i>
                        </a>
                            #}
                    </label>
                    {% endif %}
                        {% if ( (rejet[0].librejet  is defined) and (rejet[0].librejet !=null) ) %}
                            {#% if rejet.librejet !=null is defined  %#}
                            <div class="form-group bien">
                                <font size="+1"><b>OBSERVATIONS DU REJET:</b></font><br><br>
                                <table width="100%" class="table table-bordered table-striped table-hover table-condensed">
                                    <tr>
                                        <td>Date transmission</td><td>Motif</td><td>Télécharger</td>
                                    </tr>
                                    {% for rejets in rejet%}
                                        <tr>
                                            <td>{{rejets.daterejet|date('d-m-Y') }}</td>
                                            <td>{{rejets.librejet|striptags|slice(0, 150) }}</td>
                                            <td><a class="red" href="{{ vich_uploader_asset(rejets.pjtraitement, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                                                    <i class="ace-icon fa fa-download bigger-130"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </table>
                            </div>
                        {% endif%}

                        {%if(is_granted('ROLE_CHARGE_ETUDES')==false) %}
                            <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter Directement</span></button>
                            <button id="btnpt" type="submit" value="imputer" class="btn btn-primary pull-right form-control" name="imputer"><span class="glyphicon glyphicon-ok-sign"> Effectuer l'imputation</span></button>

                            {#% if(coord ==1) %}
                                 <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter Directement</span></button>
                                 <button id="btnpt" type="submit" value="imputer" class="btn btn-primary pull-right form-control" name="imputer"><span class="glyphicon glyphicon-ok-sign"> Effectuer l'imputation</span></button>                 
                             {% else%} 
                                 <p><a href="{{ path('courrier_recap_trait', { 'id': entities[0].id }) }}" class="btn btn-primary pull-right form-control"><span class="glyphicon glyphicon-inbox"></span> Consulter</a></p> 
     
                             {% endif% #}    

                        {% else%}
                            <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter</span></button>   
                        {% endif%}
                        <a class="btn btn-primary pull-right form-control" href="{{ path('courrier_csrecu') }}">Retour</a>       
                        <input type="hidden" name="coord" value="{{coord}}">
                        <input type="hidden" name="NbrePers" value="{{NbrePers}}">
                        <input type="hidden" name="idimputdir" value="{{idimputdir}}">
                        {#% if coord==1  %}
                          {% if NbrePers > 1 and coord ==1  %}
                            {#% if direction.tr.pjtraitement.imageName is defined %}
                            <div class="form-group bien">
                                <font size="+1"><b>DIFFERENTES REPONSES RECUES</b></font><br><br>
                                <font color="#000000">
                                <table width="100%" class="table table-bordered table-striped table-hover table-condensed">
                                  <tr>
                                      <td>Service</td><td>Etat</td><td>Télécharger</td><td>Date transmission</td>
                                  </tr>
                              {% for direction in dir%} 
                                  {% set cpt = cpt + 1 %}
                                  {% if direction.tr.pjtraitement.imageName is not defined %}
                                    {% set etat = 'En cours' %}
                                    {% set telecharger = 'Néant' %}
                                  {% else %}
                                    {% set etat = 'Transmis' %}
                                    {% set telecharger ='<a class="red" href="'~vich_uploader_asset(direction.tr.pjtraitement, 'imageFile')~'" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                                <i class="ace-icon fa fa-download bigger-130"></i></a>'%}
            
                                    {% set dossier = dossier + 1 %}
                                  {% endif %}
                                  <tr>
                                      <td>{{direction.service}} ({{direction.nom}}&nbsp;{{direction.prenoms}})</td>  
                                      <td>{{etat}}</td>
                                      <td>{{telecharger|raw}}</td>
                                      <td>{% if direction.tr%}
                                            {{direction.tr.datetraitement|date('d-m-Y')}}
                                          {% else %}Néant
                                          {% endif %} 
                                        <input type="hidden" name="imputdir[]" value="{{direction.id}}">
                                      </td>
                                  </tr>
                              {% endfor %}
                                </table>
                                </font>
                              </div>
                              {#% endif %#}  

                        {#% set dossier = 4 %#}
                        {#% if (cpt == dossier) %}
                         <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter </span></button>
                         <a class="btn btn-primary pull-right form-control" href="{{ path('courrier_csrecu') }}">Retour</a>   
                        {#% endif %}
                        
                    {% else %}
                       <label>Télécharger la Pièce Jointe:
                          <a class="red" href="{{ vich_uploader_asset(entities[0].courrier.piecejointe, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                          <i class="ace-icon fa fa-download bigger-130"></i>
                          </a>
                       </label>
                       <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter Directement</span></button>
                       <button id="btnpt" type="submit" value="imputer" class="btn btn-primary pull-right form-control" name="imputer"><span class="glyphicon glyphicon-ok-sign"> Effectuer l'imputation</span></button>
                       <a class="btn btn-primary pull-right form-control" href="{{ path('courrier_csrecu') }}">Retour</a>   
                    {% endif %}
                        
                 {% else %}
                       <label>Télécharger la Pièce Jointe:
                          <a class="red" href="{{ vich_uploader_asset(entities[0].courrier.piecejointe, 'imageFile') }}" title="Télécharger"  class="tooltip-info" data-rel="tooltip" data-original-title="Télécharger">
                          <i class="ace-icon fa fa-download bigger-130"></i>
                          </a>
                        </label>
                       <button id="btnp" type="submit" value="traiter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Traiter Directement</span></button>
                       <button id="btnpt" type="submit" value="imputer" class="btn btn-primary pull-right form-control" name="imputer"><span class="glyphicon glyphicon-ok-sign"> Effectuer l'imputation</span></button>
                       <a class="btn btn-primary pull-right form-control" href="{{ path('courrier_csrecu') }}">Retour</a>     
                 {% endif %#} 

                    </div>
            </form>
        </div>
    </div>
    <ul>
        <li>
            <a href="{{ path('reception') }}">&nbsp;</a>
        </li>
    </ul>
           {{macro.div_apercu() }}
    {% endblock %}
