{% extends '::ediligence/base.html.twig' %}

{% block body %}
    
     <div class="content-header">
        <div class="header-section">
            <h1><i class="gi gi-envelope"></i> Dossier<br><small>Mes diligences</small></h1>
        </div>
    </div>
    <ul class="breadcrumb breadcrumb-top">
        <li>Actions</li>
        <li><a href="">Mes Dossiers</a></li>
    </ul>
    <div class="block full">
        <div class="block-title">
            <h2><strong>Liste</strong> dossiers</h2>
        </div>{#
        <p><a href="https://dge.ci" target="_blank">DataTables</a> is a plug-in for the Jquery Javascript library. It is a highly flexible tool, based upon the foundations of progressive enhancement, which will add advanced interaction controls to any HTML table. It is integrated with template's design and it offers many features such as on-the-fly filtering and variable length pagination.</p>
#}

        <div class="table-responsive">
            <table id="example-datatable" class="table table-vcenter table-condensed table-bordered">
                <thead>
                    <tr>
                        <th>Num</th>
                        <th>Date départ</th>
                        <th>Objet</th>
                        <th>Observation</th>
                        <th>Télécharger</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% set i = 0 %}
                    {% for entity in entities %}
                         {% set i = i + 1 %}
                        <tr>
                            <td><a href="{{ path('courrier_show', { 'id': entity.id }) }}">{{ i }}</a></td>
                            <td>{% if entity.dateCreat %}{{ entity.dateCreat|date('d-m-Y') }}{% endif %}</td>
                            <td>{{ entity.objet|raw|striptags|slice(0, 150) }}</td>
                            <td>{{ entity.observationscecour|raw|striptags|slice(0, 50) }}</td>
                            <td>
                                {% if entity.piecejointe !=null and entity.piecejointe is defined %}
                                 {{ macro.apercu(entity.piecejointe) }}
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-xs">
                                    <a href="{{ path('courrier_imput', { 'id': entity.id }) }}" data-toggle="tooltip" title="Imputer" class="btn btn-outline-success"><i class="fa fa-pencil" style="font-size:18px;color:green;">Imputer</i></a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <ul>
            <li>
                <a href="{{ path('courrier_new') }}">Transmettre diligence</a>
            </li>
        </ul>
    </div>
	{{macro.div_apercu() }}
    {% endblock %}
