{% extends '::ediligence/base.html.twig' %}

{% block body %}
<div class="content-header">
    <div class="header-section">
        <h1>
            <i class="gi gi-notes_2"></i>Diligences reçues<br><small>&nbsp;</small>
        </h1>
    </div>
</div>
<ul class="breadcrumb breadcrumb-top">
    <li>Traitement d'une diligence</li>
    <!--<li><a href="">Nouveau</a></li>-->
</ul>
<div class="row">
 {{ form_start(form) }}
    <div class="col-md-offset-2 col-md-8">
        <div class="block"> 
            <!-- Basic Form Elements Title -->
           <div class="block-title">
                <h2><strong>Traitement N° {{entities[0].numtraitement}}</strong></h2>
            </div>
            <div style="float:right;" class="bien2">
                <b>COURRIER: N° &nbsp; {{entities[0].codecourrier}}</b>
            </div>
            <div class="bien">
                <b>EMETTEUR: <font color="#000000">&nbsp;{{entities[0].nom_dest}}&nbsp;{{entities[0].pren_dest}}&nbsp;{{entities[0].jfil_dest}}</font></b><br><br>
                <b>DESTINATAIRE: <font color="#000000">&nbsp;{{entities[0].nom}}&nbsp;{{entities[0].prenoms}}&nbsp;{{entities[0].nomJeuneFille}}</font></b><br><br>
                <b>OBJET:<font color="#000000">&nbsp;{{entities[0].objet|raw|striptags|slice(0, 150) }}</font></b><br><br>
            </div>
            <div class="form-group bien">
                 {{ form_row(form.librejet, {'label':'MOTIF DE REJET'}) }}
            </div>
            <label>
              {{form_widget(form.pjrejet.imageFile,{'attr':{'required':true}})}}
            <i style="margin-bottom: 5px;">Format du Fichier (jpg, png, pdf, doc ou docx | max. 50 Mo)</i>
            </label>
            <button id="btnp" type="submit" value="rejeter" class="btn btn-primary pull-right form-control" name="traiter"><span class="glyphicon glyphicon-ok-sign"> Rejeter le traitement</span></button>
            <a class="btn btn-primary pull-right form-control" href="{{ path('etude_trt', { 'id': id }) }}">Retour</a>
            <input type="hidden" name="id_traitement" value="{{id}}">
            <input type="hidden" name="etat" value="rejeter">
        </div>
{{ form_end(form) }}
    </div>
</div>
<ul>
    <li>
        <a href="{{ path('reception') }}">&nbsp;</a>
    </li>
</ul>
{% endblock %}
