    <div class="table-responsive">
        <table id="dtable" class="table table-vcenter table-condensed table-bordered">
            <thead>
                <tr>
                    <th>Num</th>
                    <th>libellé</th>
                    <th>Année</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for entity in entities %}
                    <tr>
                        <td><a href="#">{{ entity.id }}</a></td>
                        <td>PAS {{ entity.direction.sigle }}</td>
                        <td>{{entity.exercice.annee}}{#{% if entity.dateorigine %}{{ entity.dateorigine|date('d-m-Y') }}{% endif %}#}</td>

                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-xs">
                                <a href="{{ path('courrier_edit', { 'id': entity.id }) }}" data-toggle="tooltip" title="Ajouter" class="btn btn-success"><i class="fa fa-edit" style="font-size:16px;color:red"></i>Modifier</a>  &nbsp; &nbsp;
                                <a href="{{ path('pas_evaluer', { 'id': entity.id }) }}" data-toggle="tooltip" title="Planifier" class="btn btn-success"><i class="fa fa-edit" style="font-size:16px;color:red"></i>Planifier</a>  &nbsp; &nbsp;
                                <a href="{{ path('pas_bareme', { 'id': entity.id }) }}" data-toggle="tooltip" title="Barème" class="btn btn-success"><i class="fa fa-edit" style="font-size:16px;color:red"></i>Barème</a>  &nbsp; &nbsp;
                                <a href="{{ path('pas_preuve', { 'id': entity.id }) }}" data-toggle="tooltip" title="Preuve source" class="btn btn-success"><i class="fa fa-edit" style="font-size:16px;color:red"></i>Preuve</a>  &nbsp; &nbsp;
                                <a href="{{ path('pas_fiche', { 'id': entity.id }) }}" data-toggle="tooltip" title="Evaluer" class="btn btn-success"><i class="fa fa-edit" style="font-size:16px;color:red"></i>Evaluer</a>  &nbsp; &nbsp;
                            </div>
                        </td>
                    </tr>
                {% endfor %}
