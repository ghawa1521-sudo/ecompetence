{% extends "FOSUserBundle::layout.html.twig" %}

{% trans_default_domain 'FOSUserBundle' %}

{% block fos_user_content %}

    <div class="x_panel">
        <img src="{{ asset('images/logoDGE.png')}}" width="220 px"/>
        <form action="{{ path("fos_user_security_check") }}" method="post"> 
            <h1> Espace Agent </h1>

            <br/>
            <span style="color:red; font-weight:bold;">Pour la première connexion, <br>le mot de passe par défaut est : <br>12345678</span>
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <br/>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />


            <input type="text" id="username" class="form-control" name="_username" value="{{ last_username }}" onblur="RetireEspace('username')" required="required" placeholder="Entrez votre matricule" />


            <input type="password" id="password" class="form-control" name="_password" required="required" placeholder="Entrez votre mot de passe"/>


            <a class="reset_pass" href="{{path('fos_user_resetting_request')}}">Mot de Passe Oublié ?</a>


            <br/>
            <br/>
            <br/>
            <input type="submit" id="_submit" name="_submit" class="btn btn-success submit col-md-12 col-xs-12 col-lg-12" value="{{ 'security.login.submit'|trans }}" />


        </form>
    </div>
{% endblock fos_user_content %}

